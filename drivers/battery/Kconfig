config BATTERY_HIGH_LOAD
    bool
    help
      The battery driver implements battery_high_load_request() and
      battery_high_load_release().

config BATTERY_SIMPLE
    bool
    default DT_HAS_SIMPLE_BATTERY_ENABLED
    help
      The battery cell described in the devicetree, for chargers and fuel
      gauges to read.

menuconfig BATTERY
    bool "Battery"
    help
      Battery Drivers

if BATTERY

config BATTERY_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated battery, set through its simulator API
      (pbl/drivers/battery/sim.h).

endif # BATTERY
