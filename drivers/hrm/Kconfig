menuconfig HRM
    bool "Heart rate monitor"
    help
      Heart rate monitor class (pbl/drivers/hrm.h) and its drivers.

if HRM

config HRM_GH3X2X
    bool "Goodix GH3X2X"
    select KERNEL_SYS_WORKQ
    help
      Support for the Goodix GH3X2X heart rate sensor.

config HRM_HRV
    bool "HRV (RR interval) support"
    depends on HRM_GH3X2X
    help
      Expose heart-rate-variability (RR/inter-beat interval) data from the
      HRM sensor. Enables the Goodix HRV algorithm and links the nonfree
      HRV library. Off by default; HRV is only sampled while an app holds
      an HRV subscription.

config HRM_GH3X2X_FACTORY_TEST
    bool "GH3X2X factory tests"
    depends on GH3X2X_ALGO
    help
      The GH3X2X CTR, light leakage and noise factory tests, sampling heart
      rate and SpO2 together.

config HRM_QEMU
    bool "QEMU"
    default y
    depends on SOC_QEMU_PEBBLE
    help
      QEMU heart rate monitor. QEMU emulates none, so it can be enabled
      but never delivers samples.

module = DRIVER_HRM
module-str = Heart rate monitor
source "subsys/logging/Kconfig.template.log_level"

endif # HRM
