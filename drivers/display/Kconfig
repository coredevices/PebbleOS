menuconfig DISPLAY
    bool "Display"
    help
      Display class (pbl/drivers/display.h) and its drivers: the
      controllers that take the framebuffer to the panel.

if DISPLAY

config DISPLAY_UPDATE_TIMEOUT_MS
    int "Update timeout, in milliseconds"
    default 200
    help
      Time an update has to complete, for the displays whose driver can
      abort one: past it, the update is stopped and ends with -ETIMEDOUT.

config DISPLAY_MAX_UPDATE_ROWS
    int "Most rows per update of a staging display"
    range 0 65535
    default 0
    help
      Most rows taken per update by the displays that stage updates in a
      transfer buffer, such as the Sharp memory LCDs, which sizes that
      buffer. Callers send more rows in bands of this many. 0 takes the
      whole panel at once.

rsource "Kconfig.sf32lb_lcdc"
rsource "Kconfig.sf32lb57_lcdc"
rsource "Kconfig.stm32_ltdc"
rsource "Kconfig.sharp_memory"
rsource "Kconfig.qemu"
rsource "Kconfig.sdl"

config DISPLAY_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The display shell command, to show the display and turn its panel on
      or off.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
