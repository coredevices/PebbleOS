menuconfig DISPLAY
    bool "Display"
    help
      Display Drivers

if DISPLAY

config DISPLAY_SF32LB_LCDC
    bool "SiFli SF32LB LCD controller"
    default y if SOC_SF32LB52
    depends on PINCTRL
    select PANEL
    select HAL_SIFLI
    select HAL_SIFLI_LCD
    help
      Support for the SiFli SF32LB LCD controller, driving a JDI
      memory-in-pixel panel.

config DISPLAY_SHARP_LS013B7DH01
    bool "Sharp LS013B7DH01"
    default y if SOC_NRF52
    depends on PWM && SPI
    help
      Support for the Sharp LS013B7DH01 memory LCD.

config DISPLAY_QEMU
    bool "QEMU Framebuffer Display"
    default y if SOC_QEMU
    help
      Support for the QEMU framebuffer display peripheral.

config DISPLAY_SDL
    bool "SDL window"
    default y if SOC_POSIX
    select SDL
    help
      Display shown in an SDL window on the host of a native build.

config DISPLAY_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The display shell command, to show the display and turn its panel on
      or off.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
