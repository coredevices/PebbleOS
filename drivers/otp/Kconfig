menuconfig OTP
    bool "OTP storage"
    help
      One-time programmable storage class (pbl/drivers/otp.h), for serial
      numbers, the hardware revision and other factory data.

if OTP

config OTP_FLASH
    bool "Flash security registers"
    default y
    depends on FLASH_OTP
    help
      OTP slots in the cells the board lays out in the flash OTP area
      (security registers on SPI NOR parts). Driver: otp_flash.c.

config OTP_QEMU
    bool "QEMU"
    default y
    depends on SOC_QEMU_PEBBLE
    help
      QEMU OTP. QEMU emulates none, so all slots read as locked and empty.

config OTP_POSIX
    bool "POSIX"
    default y
    depends on SOC_POSIX
    help
      No OTP on the host: all slots read as locked and empty.

endif # OTP
