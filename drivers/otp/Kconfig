menuconfig OTP
    bool "OTP Storage"
    help
      One-Time Programmable storage for serial numbers, HW revision, etc.

if OTP

config OTP_FLASH
    bool "Flash security registers"
    depends on FLASH_OTP
    help
      OTP slots in the cells the board lays out in the flash OTP area
      (security registers on SPI NOR parts). Driver: otp_flash.c.

config OTP_QEMU
    bool "QEMU"
    default y if SOC_QEMU
    help
      QEMU OTP. QEMU emulates none, so all slots read as locked and empty.

config OTP_POSIX
    bool "POSIX"
    default y if SOC_POSIX
    help
      No OTP on the host: all slots read as locked and empty.

endif # OTP
