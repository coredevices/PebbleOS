menuconfig UDC
    bool "USB device controllers"
    help
      USB device controller class (pbl/drivers/udc.h), selected by the USB
      device stack.

if UDC

rsource "Kconfig.nrf5"

config UDC_VBUS_CHARGER
    bool
    default y
    depends on CHARGER
    help
      Sense USB power through the charger a controller's vbus-charger
      property points to.

rsource "Kconfig.musb"
rsource "Kconfig.dwc2"

module = DRIVER_UDC
module-str = USB device controller
source "subsys/logging/Kconfig.template.log_level"

endif # UDC
