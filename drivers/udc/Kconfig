menuconfig UDC
    bool "USB device controllers"
    help
      USB device controller class (pbl/drivers/udc.h), selected by the USB
      device stack.

if UDC

config UDC_DWC2
    bool "Synopsys DesignWare USB 2.0 OTG (DWC2)"
    default y
    depends on DT_HAS_ST_STM32F7_HSOTG_ENABLED
    select CLK
    select PINCTRL
    select REGULATOR
    help
      Device mode of the DesignWare USB 2.0 OTG controller, as the USB OTG
      HS of the STM32F7 and STM32H7, through its FIFOs, with an external
      ULPI PHY at high speed or its internal PHY at full speed.

config UDC_DWC2_IRQ_PRIO
    int "Interrupt priority"
    default 12
    depends on UDC_DWC2

config UDC_MUSB
    bool "Mentor Graphics MUSB"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_USB_ENABLED
    select CLK
    select PINCTRL
    help
      Device mode of the Mentor Graphics MUSB controller, as the USB
      controller of the SiFli SF32LB57, at full speed, through its FIFOs.

config UDC_MUSB_IRQ_PRIO
    int "Interrupt priority"
    default 6
    depends on UDC_MUSB

module = DRIVER_UDC
module-str = USB device controller
source "subsys/logging/Kconfig.template.log_level"

endif # UDC
