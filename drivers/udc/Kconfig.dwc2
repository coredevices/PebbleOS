config UDC_DWC2
    bool "Synopsys DesignWare USB 2.0 OTG (DWC2)"
    default y
    depends on DT_HAS_ST_STM32F7_HSOTG_ENABLED || DT_HAS_NORDIC_NRF54LM20A_USBHS_ENABLED
    select CLK
    select PHY
    select PINCTRL
    select REGULATOR
    help
      Device mode of the DesignWare USB 2.0 OTG controller, by DMA, or
      through its FIFOs on cores without it: the USB OTG HS of the STM32F7
      and STM32H7, with an external ULPI PHY at high speed or its internal
      PHY at full speed, and the USBHS of the nRF54LM20A, with its UTMI+ PHY
      at high speed. With a PHY that senses VBUS, the core is powered only
      while VBUS is present.

config UDC_DWC2_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on UDC_DWC2
    help
      Priority of the controller interrupt.
