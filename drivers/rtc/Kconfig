menuconfig RTC
    bool "RTC"
    help
      Real-time clock drivers: hardware that keeps the wall clock across
      resets.

if RTC

config RTC_SHELL
    bool "RTC shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The rtc shell command, to read and set the RTC directly.

config RTC_RETAINED
    bool "Retained RAM"
    default y if SOC_NRF52
    help
      The time last set, kept in retained RAM, for SoCs without a calendar
      RTC. It survives resets but not power loss, and does not count while
      the system is off.

config RTC_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    help
      SiFli SF32LB calendar RTC, clocked by the calibrated RC10K.

config RTC_QEMU
    bool "QEMU RTC"
    default y if SOC_QEMU
    help
      QEMU RTC, following the host clock.

config RTC_POSIX
    bool "POSIX RTC"
    default y if SOC_POSIX
    help
      RTC following the host clock.

endif # RTC
