menuconfig RTC
    bool "RTC"
    help
      Real-time clock drivers: hardware that keeps the wall clock across
      resets.

if RTC

config RTC_SHELL
    bool "RTC shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The rtc shell command, to read and set the RTC directly.

rsource "Kconfig.retained"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32"
rsource "Kconfig.qemu"
rsource "Kconfig.posix"

endif # RTC
