menuconfig UART
    bool "UART"
    help
      UART class (pbl/drivers/uart.h) and its drivers.

if UART

rsource "Kconfig.nrf5"
rsource "Kconfig.nrf54l"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32"
rsource "Kconfig.qemu"
rsource "Kconfig.posix"

config UART_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The uart shell command, to list the ports, change their line
      settings and send text.

module = DRIVER_UART
module-str = UART
source "subsys/logging/Kconfig.template.log_level"

endif # UART
