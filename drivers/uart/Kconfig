menuconfig UART
    bool "UART"
    help
      UART Drivers

if UART

config UART_NRF5
    bool "Nordic nRF5 UART Controller"
    default y
    depends on DT_HAS_NORDIC_NRF52832_UARTE_ENABLED
    select GPIO
    help
      Support for the Nordic nRF5 UART controller.

config UART_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 7
    depends on UART_NRF5
    help
      Priority of the port interrupts.

config UART_SF32LB
    bool "SiFli SF32LB UART Controller"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_USART_ENABLED
    select CLK
    select DMA
    select PINCTRL
    help
      Support for the SiFli SF32LB UART controller.

config UART_SF32LB_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on UART_SF32LB
    help
      Priority of the port interrupts.

config UART_QEMU
    bool "QEMU Simple UART"
    default y
    depends on DT_HAS_QEMU_PEBBLE_SIMPLE_UART_ENABLED
    help
      Support for the QEMU simple UART peripheral.

config UART_QEMU_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on UART_QEMU
    help
      Priority of the port interrupts.

config UART_POSIX
    bool "POSIX UART"
    default y if SOC_POSIX
    help
      UART backed by a host file descriptor.

config UART_POSIX_BT_HCI
    bool "Bluetooth HCI port"
    default y
    depends on UART_POSIX
    help
      Port for a host Bluetooth controller, attached with the -b option.

config UART_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The uart shell command, to list the ports, change their line
      settings and send text.

module = DRIVER_UART
module-str = UART
source "subsys/logging/Kconfig.template.log_level"

endif # UART
