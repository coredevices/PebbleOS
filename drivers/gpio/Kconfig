menuconfig GPIO
    bool "GPIO"
    help
      GPIO controller class (pbl/drivers/gpio.h), selected by the
      drivers that drive or read pins.

if GPIO

rsource "Kconfig.nrf5"
rsource "Kconfig.nrf54l"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32"
rsource "Kconfig.qemu"
rsource "Kconfig.npm1300"
rsource "Kconfig.tca6408"

config GPIO_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The gpio shell command, to list the ports and to read, drive,
      configure and watch pins.

endif # GPIO
