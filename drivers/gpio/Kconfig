menuconfig GPIO
    bool "GPIO"
    help
      GPIO Drivers

if GPIO

config GPIO_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    select INTC
    help
      Support for the Nordic nRF5 GPIO controller.

config GPIO_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    depends on CLK_SF32LB && PINCTRL_SF32LB52
    select INTC
    help
      Support for the SiFli SF32LB GPIO controller.

config GPIO_QEMU
    bool "QEMU GPIO"
    default y if SOC_QEMU
    select INTC
    help
      Support for the QEMU GPIO peripheral.

config GPIO_NPM1300
    bool "Nordic nPM1300 GPIO"
    default y
    depends on MFD_NPM1300
    help
      Support for the GPIOs of the Nordic nPM1300 PMIC.

config GPIO_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The gpio shell command, to list the ports and to read, drive,
      configure and watch pins.

endif # GPIO
