config POWER_DOMAIN
    bool
    help
      Power domain class (pbl/drivers/power_domain.h), selected by the
      drivers that provide power domains.

config POWER_DOMAIN_SF32LB_PMUC
    bool "SiFli SF32LB PMUC power domains"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_PMUC_ENABLED || DT_HAS_SIFLI_SF32LB57_PMUC_ENABLED
    select POWER_DOMAIN
    help
      The HPSYS power domain of the SiFli SF32LB52 and SF32LB57 PMUC,
      whose performance states are the voltage modes of the HPSYS, D0 to
      S1.
