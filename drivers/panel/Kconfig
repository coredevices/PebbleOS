config PANEL
    bool
    help
      Panel class, selected by the display controllers driving a panel.

config PANEL_JDI_MIP
    bool "Memory-in-pixel panels"
    default y
    depends on DT_HAS_JDI_LPM015M135A_ENABLED || DT_HAS_SHARP_LS013B7DD02_ENABLED
    depends on PANEL
    select PWM
    select REGULATOR
    help
      Support for the JDI LPM015M135A and Sharp LS013B7DD02 memory-in-pixel
      panels on the JDI parallel interface.

config PANEL_CO5300
    bool "ChipOne CO5300 AMOLED panels"
    default y
    depends on DT_HAS_CHIPONE_CO5300_ENABLED
    depends on PANEL
    select BACKLIGHT
    select GPIO
    select MIPI_DBI
    help
      Support for AMOLED panels on the ChipOne CO5300 driver IC, over quad
      SPI, with their brightness as a backlight.

if PANEL

module = DRIVER_PANEL
module-str = Panel
source "subsys/logging/Kconfig.template.log_level"

endif # PANEL
