config PANEL_CO5300
    bool "ChipOne CO5300 AMOLED panels"
    default y
    depends on DT_HAS_CHIPONE_CO5300_ENABLED
    depends on PANEL
    select BACKLIGHT
    select GPIO
    select MIPI_DBI
    select PANEL_QSPI
    help
      Support for AMOLED panels on the ChipOne CO5300 driver IC, over quad
      SPI, with their brightness as a backlight.
