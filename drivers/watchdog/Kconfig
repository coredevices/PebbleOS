menuconfig WATCHDOG
    bool "Watchdog"
    help
      Watchdog Drivers

if WATCHDOG

config WATCHDOG_TIMEOUT_MS
    int "Timeout in milliseconds"
    default 8000 if WATCHDOG_NRF5
    default 30000
    help
      Time without a feed after which the hardware watchdog resets the
      system. The task watchdog feeds it on every check.

      The nRF5 watchdog cannot be reconfigured once running, and the
      bootloader starts it: there this must match the bootloader timeout.

config WATCHDOG_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 watchdog.

config WATCHDOG_RUNS_WHILE_HALTED
    bool
    help
      The watchdog keeps counting while a debugger has the CPU stopped,
      so the task watchdog stops it while one is attached.

config WATCHDOG_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    select WATCHDOG_RUNS_WHILE_HALTED
    help
      Support for the SiFli SF32LB watchdog.

config WATCHDOG_QEMU
    bool "QEMU Watchdog"
    default y if SOC_QEMU
    help
      Support for the CMSDK APB watchdog of the QEMU Pebble machines.

endif # WATCHDOG
