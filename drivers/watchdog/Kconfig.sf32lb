config WATCHDOG_SF32LB
    bool "SiFli SF32LB"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_WDT_ENABLED || DT_HAS_SIFLI_SF32LB57_IWDT_ENABLED
    depends on CLK_SF32LB52_PMUC || CLK_SF32LB57_PMUC
    select WATCHDOG_RUNS_WHILE_HALTED
    help
      Support for the SiFli SF32LB watchdog.
