menuconfig ADC
    bool "ADCs"
    help
      Analog-to-digital converter class (pbl/drivers/adc.h), selected by the
      drivers that read analog inputs.

if ADC

config ADC_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The adc shell command, to list the ADCs and convert a channel.

config ADC_NRF5_SAADC
    bool "Nordic nRF5 SAADC"
    default y
    depends on DT_HAS_NORDIC_NRF52832_SAADC_ENABLED
    help
      Successive approximation ADC of the Nordic nRF52 series, one input
      converted at a time, in 12 bits over 3.6 V.

config ADC_SF32LB57_GPADC
    bool "SiFli SF32LB57 GPADC"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_GPADC_ENABLED
    select CLK
    select NVMEM
    help
      General purpose ADC of the SiFli SF32LB57, read one channel at a
      time, with the factory calibration in its eFuse.

config ADC_STM32H7
    bool "STM32H7 ADC"
    default y
    depends on DT_HAS_ST_STM32H7_ADC_ENABLED
    select CLK
    help
      ADCs of the STM32H7, converting one channel at a time at 16 bits,
      clocked from the bus in synchronous mode.

module = DRIVER_ADC
module-str = ADC
source "subsys/logging/Kconfig.template.log_level"

endif # ADC
