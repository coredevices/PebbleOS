menuconfig PMIC
    bool "PMIC"
    help
      PMIC Drivers

if PMIC

config PMIC_NPM1300
    bool "Nordic nPM1300 charger"
    default y
    depends on MFD_NPM1300
    select BATTERY_HIGH_LOAD
    help
      Support for the charger of the Nordic nPM1300 PMIC.

module = DRIVER_PMIC
module-str = PMIC
source "subsys/logging/Kconfig.template.log_level"

endif # PMIC
