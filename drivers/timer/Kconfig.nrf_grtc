config TIMER_NRF_GRTC
    bool
    select CLK
    help
      Clock source and clock event device on the GRTC, counting
      microseconds. It keeps the time from the 32.768 kHz low-frequency
      clock in every sleep mode. Selected by the SoC.

config TIMER_NRF_GRTC_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on TIMER_NRF_GRTC
    help
      Priority of the GRTC interrupt.
