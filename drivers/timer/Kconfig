menu "System timer"

config TIMER_ARM_SYSTICK
    bool "Arm SysTick"
    depends on CPU_CORTEX_M
    help
      Clock event device on the Arm SysTick timer, counting CPU cycles. It
      stops in deep sleep.

config TIMER_ARM_SYSTICK_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on TIMER_ARM_SYSTICK
    help
      Priority of the SysTick exception.

config TIMER_QEMU
    bool
    help
      Clock source on the 1 kHz counter of the QEMU RTC. Selected by the
      SoC.

config TIMER_NRF5_RTC
    bool
    select CLK
    help
      Clock source and clock event device on RTC1, counting the 32.768 kHz
      low-frequency clock. It keeps running in every sleep mode. Selected
      by the SoC.

config TIMER_NRF5_RTC_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on TIMER_NRF5_RTC
    help
      Priority of the RTC1 interrupt.

config TIMER_NRF_GRTC
    bool
    select CLK
    help
      Clock source and clock event device on the GRTC, counting
      microseconds. It keeps the time from the 32.768 kHz low-frequency
      clock in every sleep mode. Selected by the SoC.

config TIMER_NRF_GRTC_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on TIMER_NRF_GRTC
    help
      Priority of the GRTC interrupt.

config TIMER_SF32LB_LPTIM
    bool
    select CLK
    help
      Clock source and clock event device on LPTIM1, counting clk_rtc, the
      calibrated LRC10 or the 32 kHz crystal. It keeps running and wakes the
      CPU up in deep sleep. Selected by the SoC.

config TIMER_SF32LB_LPTIM_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on TIMER_SF32LB_LPTIM
    help
      Priority of the LPTIM1 interrupt.

config TIMER_STM32_LPTIM
    bool
    select CLK
    select RESET
    help
      Clock source and clock event device on the LPTIM of the STM32H7 the
      board enables its timer function on, counting its kernel clock,
      the 32.768 kHz crystal on boards that have one. It keeps running and
      wakes the CPU up in Stop mode. Selected by the SoC.

config TIMER_STM32_LPTIM_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on TIMER_STM32_LPTIM
    help
      Priority of the LPTIM interrupt.

config TIMER_POSIX
    bool
    help
      Clock source and clock event device on the host monotonic clock.
      Selected by the SoC.

endmenu
