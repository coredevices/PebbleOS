config RAM_HYPERRAM
    bool "HyperRAM"
    default y
    depends on DT_HAS_CYPRESS_HYPERRAM_ENABLED
    select REGULATOR
    select HYPERBUS
    help
      Support for HyperRAM, PSRAM with a HyperBus interface, on a
      HyperBus controller.
