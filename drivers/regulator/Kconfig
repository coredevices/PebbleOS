config REGULATOR
    bool
    help
      Power rail class (pbl/drivers/regulator.h), selected by the drivers
      that use regulators.

# Not only for its consumers: it also applies the mode of VREGMAIN
config REGULATOR_NRF54L
    bool "Nordic nRF54L VREGMAIN"
    default y
    depends on DT_HAS_NORDIC_NRF54L15_OSCILLATORS_ENABLED
    select REGULATOR
    help
      Support for VREGMAIN, the main supply of the nRF54L, which runs from
      its LDO or, with an inductor fitted, from its DC/DC converter, as
      regulator-initial-mode says.

# Not only for its consumers: it also switches off a regulator nothing uses
config REGULATOR_SF32LB52_PMUC
    bool "SiFli SF32LB52 PMUC regulators"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_PMUC_ENABLED
    select REGULATOR
    help
      Support for LDO18, the supply of the package memory in the
      SF32LB52 PMUC.

config REGULATOR_SF32LB57_PMUC
    bool "SiFli SF32LB57 PMUC regulators"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_PMUC_ENABLED
    select REGULATOR
    help
      Support for LDO18, the supply of the package memory in the
      SF32LB57 PMUC.

if REGULATOR

config REGULATOR_NPM1300
    bool "Nordic nPM1300 regulators"
    default y
    depends on DT_HAS_NORDIC_NPM1300_ENABLED
    select MFD
    select MFD_NPM1300
    help
      Support for the BUCK and LDSW rails of the Nordic nPM1300 PMIC.

config REGULATOR_STM32H7_PWR
    bool "STM32H7 PWR regulators"
    default y
    depends on DT_HAS_ST_STM32H747_PWR_ENABLED
    help
      Support for USB33, the supply of the USB transceivers, which the
      voltage detector of the STM32H7 PWR lets through.

config REGULATOR_FIXED
    bool "Fixed regulators"
    default y
    depends on DT_HAS_REGULATOR_FIXED_ENABLED
    select GPIO
    help
      Support for rails switched by a GPIO.

module = DRIVER_REGULATOR
module-str = Regulator
source "subsys/logging/Kconfig.template.log_level"

endif # REGULATOR
