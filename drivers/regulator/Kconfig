config REGULATOR
    bool
    help
      Power rail class (pbl/drivers/regulator.h), selected by the drivers
      that use regulators.

if REGULATOR

config REGULATOR_NPM1300
    bool "Nordic nPM1300 regulators"
    default DT_HAS_NORDIC_NPM1300_ENABLED
    select MFD
    select MFD_NPM1300
    help
      Support for the BUCK and LDSW rails of the Nordic nPM1300 PMIC.

config REGULATOR_FIXED
    bool "Fixed regulators"
    default DT_HAS_REGULATOR_FIXED_ENABLED
    select GPIO
    help
      Support for rails switched by a GPIO.

module = DRIVER_REGULATOR
module-str = Regulator
source "subsys/logging/Kconfig.template.log_level"

endif # REGULATOR
