menuconfig SDHC
    bool "SD host controllers"
    help
      SD host controller class (pbl/drivers/sdhc.h), selected by the SD
      card stack.

if SDHC

config SDHC_STM32_SDMMC
    bool "STM32 SDMMC"
    default y
    depends on DT_HAS_ARM_PL18X_ENABLED
    select CLK
    select PINCTRL
    select GPIO
    help
      The SDMMC of the STM32H7, an ARM PL18x variant, moving the data with
      its internal DMA, or through its FIFO by the CPU for the buffers the
      DMA does not take.

config SDHC_STM32_SDMMC_IRQ_PRIO
    int "Interrupt priority"
    default 12
    depends on SDHC_STM32_SDMMC

config SDHC_SF32LB_SDMMC
    bool "SiFli SF32LB57 SDMMC"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_SDMMC_ENABLED
    select CLK
    select DMA
    select PINCTRL
    select GPIO
    help
      The SDMMC of the SF32LB57, its data moved through its FIFO of one
      block by a DMA channel when the devicetree gives one, many blocks in
      a command, or by the CPU, a block at a time, for the buffers the DMA
      does not take.

config SDHC_SF32LB_SDMMC_IRQ_PRIO
    int "Interrupt priority"
    default 6
    depends on SDHC_SF32LB_SDMMC

endif # SDHC
