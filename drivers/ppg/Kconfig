menuconfig PPG
    bool "PPG front end"
    help
      Optical front end drivers (pbl/drivers/ppg.h): LEDs and
      photodiode receivers sampled in time slots. The board instantiates
      the front end it has and exports it as PPG.

if PPG

config PPG_SHELL
    bool "Shell commands"
    default y
    depends on SHELL && !RECOVERY_FW
    help
      The ppg shell command, to inspect the front end and read raw
      samples.

config PPG_GH3026
    bool "Goodix GH3026"
    depends on I2C && INTC
    help
      Support for the Goodix GH3026 optical front end.

config PPG_QEMU
    bool "QEMU"
    default y if SOC_QEMU
    help
      Synthetic front end for QEMU, which emulates no optical sensor: it
      models a wrist with a pulse set by the host.

module = DRIVER_PPG
module-str = PPG front end
source "subsys/logging/Kconfig.template.log_level"

endif # PPG
