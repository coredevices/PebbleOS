config HYPERBUS
    bool
    help
      HyperBus controller class (pbl/drivers/hyperbus.h), selected by
      the drivers of HyperBus memories.

if HYPERBUS

config HYPERBUS_SF32LB_MPI
    bool "SiFli SF32LB MPI"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_MPI_ENABLED || DT_HAS_SIFLI_SF32LB57_MPI_ENABLED
    select MEMC_SF32LB_MPI
    help
      Support for a HyperBus memory on the SiFli SF32LB52 and SF32LB57
      MPI controllers.

endif # HYPERBUS
