menuconfig SPI
    bool "SPI"
    help
      SPI bus class (pbl/drivers/spi.h), selected by the drivers of the
      devices on a SPI bus.

if SPI

config SPI_NRF5
    bool "Nordic nRF5 SPI controller"
    default y
    depends on DT_HAS_NORDIC_NRF52832_SPIM_ENABLED
    help
      Support for the Nordic nRF5 SPIM controller.

config SPI_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on SPI_NRF5
    help
      Priority of the controller interrupts.

config SPI_SF32LB57
    bool "SiFli SF32LB57 SPI Controller"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_SPI_ENABLED
    select CLK
    select DMA
    select GPIO
    select PINCTRL
    help
      Support for the SiFli SF32LB57 SPI controller.

config SPI_SF32LB57_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on SPI_SF32LB57
    help
      Priority of the controller interrupts.

config SPI_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The spi shell command, to list the buses and run transfers.

module = DRIVER_SPI
module-str = SPI
source "subsys/logging/Kconfig.template.log_level"

endif # SPI
