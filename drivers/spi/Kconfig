menuconfig SPI
    bool "SPI"
    help
      SPI Drivers

if SPI

config SPI_NRF5
    bool "Nordic nRF5 SPI Controller"
    default DT_HAS_NORDIC_NRF52832_SPIM_ENABLED
    depends on SOC_NRF52
    help
      Support for the Nordic nRF5 SPIM controller.

config SPI_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 7
    depends on SPI_NRF5
    help
      Priority of the controller interrupts.

config SPI_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The spi shell command, to list the buses and run transfers.

module = DRIVER_SPI
module-str = SPI
source "subsys/logging/Kconfig.template.log_level"

endif # SPI
