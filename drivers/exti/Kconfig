menuconfig EXTI
    bool "External Interrupt"
    help
      External Interrupt Drivers

if EXTI

config EXTI_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 external interrupt controller.

config EXTI_SF32LB
    bool "SiFli SF32LB"
    default y if SOC_SF32LB52
    depends on GPIO_SF32LB
    help
      Support for the SiFli SF32LB external interrupt controller, on top
      of the interrupt controller of the GPIO port.

module = DRIVER_EXTI
module-str = External Interrupt
source "subsys/logging/Kconfig.template.log_level"

endif # EXTI
