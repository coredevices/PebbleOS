menuconfig CRC_HW
    bool "Hardware CRC units"
    depends on CRC
    help
      Drivers of hardware CRC units (pbl/drivers/crc.h), which the CRC
      subsystem uses instead of computing in software.

if CRC_HW

config CRC_SF32LB
    bool "SiFli SF32LB CRC unit"
    default DT_HAS_SIFLI_SF32LB52_CRC_ENABLED
    depends on SOC_SF32LB52
    select CLK
    select CRC_HW_ACCEL
    help
      Computes CRC-32 and the legacy checksum on the SF32LB CRC unit.

config CRC_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && CRC_HW_ACCEL
    help
      The crc shell command, to check the CRC unit against the software
      implementation and time both.

if CRC_SF32LB

module = DRIVER_CRC
module-str = CRC
source "subsys/logging/Kconfig.template.log_level"

endif

endif # CRC_HW
