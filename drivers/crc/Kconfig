config CRC_SF32LB
    bool "SiFli SF32LB CRC unit"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select CRC_HW_ACCEL
    help
      Computes CRC-32 and the legacy checksum on the SF32LB CRC unit.

if CRC_SF32LB

module = DRIVER_CRC
module-str = CRC
source "subsys/logging/Kconfig.template.log_level"

endif
