menuconfig ALS
    bool "Ambient light sensor"
    help
      Ambient light sensor drivers (pbl/drivers/als.h). The board
      instantiates the sensor it has and exports it as ALS.

if ALS

rsource "Kconfig.opt3001"
rsource "Kconfig.w1160"
rsource "Kconfig.sim"

config ALS_BITS
    int
    default 12 if ALS_OPT3001
    default 16 if ALS_W1160
    default 12 if ALS_SIM
    help
      Number of bits in the ambient light sensor reading, given by the
      driver. Used to derive PBL_ALS_LEVEL_MAX, which bounds the
      dark/backlight thresholds exposed to the shell and settings UI.

module = DRIVER_ALS
module-str = Ambient light sensor
source "subsys/logging/Kconfig.template.log_level"

endif # ALS
