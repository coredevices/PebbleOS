menuconfig NVMEM
    bool "Non-volatile memories"
    help
      Non-volatile memory class (pbl/drivers/nvmem.h), selected by the
      code that reads cells.

if NVMEM

config NVMEM_SF32LB52
    bool "SiFli SF32LB52 eFuse"
    default DT_HAS_SIFLI_SF32LB52_EFUSE_ENABLED
    depends on SOC_SF32LB52
    select CLK
    help
      Read access to the SF32LB52 eFuse, which holds the unique ID and the
      factory calibration.

config NVMEM_SF32LB57
    bool "SiFli SF32LB57 eFuse"
    default DT_HAS_SIFLI_SF32LB57_EFUSE_ENABLED
    depends on SOC_SF32LB57
    select CLK
    help
      Read access to the SF32LB57 eFuse, which holds the unique ID and the
      factory calibration.

config NVMEM_SHELL
    bool "Non-volatile memory shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The nvmem shell command, to list the memories and read from them.

endif # NVMEM
