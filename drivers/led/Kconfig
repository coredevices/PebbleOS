menuconfig LED
    bool "LED"
    help
      LED Drivers

if LED

config LED_HAS_COLOR
    bool
    help
      Selected by the drivers of multicolor LEDs.

config LED_AW2016
    bool "Awinic AW2016"
    default DT_HAS_AWINIC_AW2016_ENABLED
    select I2C
    select LED_HAS_COLOR
    help
      Support for the Awinic AW2016 RGB LED controller.

module = DRIVER_LED
module-str = LED
source "subsys/logging/Kconfig.template.log_level"

endif # LED
