menuconfig LED
    bool "LED"
    help
      LED class (pbl/drivers/led.h), selected by the drivers that light
      LEDs, such as the LED backlight.

if LED

config LED_HAS_COLOR
    bool
    help
      Selected by the drivers of multicolor LEDs.

rsource "Kconfig.aw2016"
rsource "Kconfig.ws2812b"
rsource "Kconfig.gpio"

module = DRIVER_LED
module-str = LED
source "subsys/logging/Kconfig.template.log_level"

endif # LED
