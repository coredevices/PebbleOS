menuconfig BACKLIGHT
    bool "Backlight"
    help
      Backlight Drivers

if BACKLIGHT

config BACKLIGHT_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The backlight shell command, to set the brightness and color.

config BACKLIGHT_HAS_COLOR
    bool
    help
      Backlight drivers that support color should select this Kconfig symbol.

config BACKLIGHT_AW9364E
    bool "AW9364E"
    default DT_HAS_AWINIC_AW9364E_ENABLED
    select GPIO
    help
      Support for the AW9364E LED controller.

config BACKLIGHT_LED
    bool "LED"
    default DT_HAS_LED_BACKLIGHT_ENABLED
    select LED
    select BACKLIGHT_HAS_COLOR if LED_HAS_COLOR
    help
      Backlight on an LED, its color mixed by multicolor LEDs.

config BACKLIGHT_PWM
    bool "PWM"
    default DT_HAS_PWM_BACKLIGHT_ENABLED
    select PWM
    help
      Support for a backlight driven by a PWM peripheral.

config BACKLIGHT_QEMU
    bool "QEMU"
    default DT_HAS_QEMU_PEBBLE_DISPLAY_ENABLED
    depends on SOC_QEMU_PEBBLE
    help
      Emulated backlight controller that writes to the QEMU
      pebble-display MMIO registers.

config BACKLIGHT_POSIX
    bool "POSIX"
    default y if SOC_POSIX
    help
      Backlight of a native build, which does nothing.

config BACKLIGHT_QEMU_COLOR
    bool "QEMU Color"
    depends on BACKLIGHT_QEMU
    select BACKLIGHT_HAS_COLOR
    help
      Enable support for RGB backlight colors in the QEMU backlight driver.
  
module = DRIVER_BACKLIGHT
module-str = Backlight
source "subsys/logging/Kconfig.template.log_level"

endif # BACKLIGHT
