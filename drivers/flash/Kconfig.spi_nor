config FLASH_SPI_NOR
    bool "SPI NOR"
    default y
    depends on DT_HAS_JEDEC_SPI_NOR_ENABLED
    select SPI_MEM
    select FLASH_OTP
    select REGULATOR
    help
      Support for a JEDEC NOR flash on a SPI memory controller, described
      by its SFDP tables and the description of the part it is identified
      as by its JEDEC ID, among the parts enabled below. Boards enable the
      parts they can be fitted with.

if FLASH_SPI_NOR

config FLASH_SPI_NOR_GD25LQ255E
    bool "GigaDevice GD25LQ255E"

config FLASH_SPI_NOR_GD25Q256E
    bool "GigaDevice GD25Q256E"

config FLASH_SPI_NOR_MT25QL512A
    bool "Micron MT25QL512A"

config FLASH_SPI_NOR_MX25R6435F
    bool "Macronix MX25R6435F"

config FLASH_SPI_NOR_PY25Q128HA
    bool "Puya PY25Q128HA"

endif
