menuconfig FLASH
    bool "Flash"
    select KERNEL_SYS_WORKQ_HIGH
    help
      Flash class (pbl/drivers/flash.h) and its drivers: the flash that
      holds the file system, resources and firmware images.

if FLASH

config FLASH_IDLE_PM
    bool
    depends on CPU_IDLE
    help
      Selected by SoCs that do not execute from the flash, to power it
      down from an idle hook, see pbl_flash_pm_suspend().

config FLASH_CRC
    bool "CRC of a range"
    select CRC
    help
      pbl_flash_crc32() and pbl_flash_crc32_legacy().

rsource "Kconfig.otp"
rsource "Kconfig.spi_nor"
rsource "Kconfig.qemu"
rsource "Kconfig.nrf_rramc"
rsource "Kconfig.posix"

config FLASH_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The flash shell command, to inspect, erase and test the flash.

config FLASH_SHELL_TEST
    bool "Test commands"
    depends on FLASH_SHELL
    help
      The flash read, fill and erased_sectors commands, to dump and verify
      the flash from a host.

module = DRIVER_FLASH
module-str = Flash
source "subsys/logging/Kconfig.template.log_level"

endif # FLASH
