menuconfig AUDIO
    bool "Audio"
    help
      Audio stream class (pbl/drivers/audio.h) and its drivers.

if AUDIO

config AUDIO_AMP_GPIO
    bool "GPIO amplifier"
    depends on GPIO
    help
      Amplifier switched by an enable GPIO, with an optional supply and
      enable mode pulses.

config AUDIO_SF32LB52_AUDCODEC
    bool "SiFli SF32LB52 audio codec"
    depends on SOC_SF32LB52 && DMA_SF32LB52 && CLK_SF32LB
    help
      Playback through the DAC of the SF32LB52 audio codec.

config AUDIO_SF32LB52_PDM
    bool "SiFli SF32LB52 PDM"
    depends on SOC_SF32LB52 && DMA_SF32LB52 && CLK_SF32LB && RESET_SF32LB && PINCTRL && REGULATOR
    help
      Capture from digital microphones on the SF32LB52 PDM interface.

config AUDIO_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The audio shell command, to list the devices, record and play tones.

module = DRIVER_AUDIO
module-str = Audio
source "subsys/logging/Kconfig.template.log_level"

endif # AUDIO
