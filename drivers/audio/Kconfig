config MIC
    bool "Microphone"
    select AUDIO
    help
      The board has a microphone, the MIC capture device.

config SPEAKER
    bool "Speaker"
    select AUDIO
    help
      The board has a speaker, the SPEAKER playback device.

menuconfig AUDIO
    bool "Audio"
    help
      Audio stream class (pbl/drivers/audio.h) and its drivers.

if AUDIO

rsource "Kconfig.amp_gpio"
rsource "Kconfig.sf32lb_audcodec"
rsource "Kconfig.sf32lb52_pdm"
rsource "Kconfig.stm32_sai"
rsource "Kconfig.qemu"
rsource "Kconfig.sim_mic"
rsource "Kconfig.nrf5_pdm"
rsource "Kconfig.nrf5_i2s"
rsource "Kconfig.dmic"
rsource "Kconfig.da7212"
rsource "Kconfig.wm8994"

config AUDIO_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The audio shell command, to list the devices, record and play tones.

module = DRIVER_AUDIO
module-str = Audio
source "subsys/logging/Kconfig.template.log_level"

endif # AUDIO
