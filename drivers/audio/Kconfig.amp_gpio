config AUDIO_AMP_GPIO
    bool "GPIO amplifier"
    default y
    depends on DT_HAS_AWINIC_AW8155_ENABLED || DT_HAS_SIMPLE_AUDIO_AMPLIFIER_ENABLED
    select GPIO
    select REGULATOR
    help
      Amplifier switched by an enable GPIO, with an optional supply and
      enable mode pulses.
