config AUDIO_NRF5_I2S
    bool "Nordic nRF5 I2S"
    default y
    depends on DT_HAS_NORDIC_NRF52832_I2S_ENABLED
    select CLK
    help
      Playback and capture through the nRF5 I2S interface.

config AUDIO_NRF5_I2S_IRQ_PRIO
    int "I2S interrupt priority"
    default 1
    depends on AUDIO_NRF5_I2S
    help
      Priority of the I2S interrupt.

config AUDIO_NRF5_I2S_BLOCK_FRAMES
    int "Most frames in a DMA block"
    range 16 512
    default 512
    depends on AUDIO_NRF5_I2S
    help
      The DMA blocks are the first stream's periods, cut down to this. Each
      direction streaming takes two from the kernel heap while running, of
      4 bytes a frame: smaller blocks take less of it, at an interrupt per
      block.
