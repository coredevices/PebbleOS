menuconfig MBOX
    bool "Mailbox controllers"
    help
      Mailbox controller class (pbl/drivers/mbox.h), selected by the
      drivers that ring mailbox channels.

if MBOX

config MBOX_SF32LB52
    bool "SiFli SF32LB52 mailbox"
    default DT_HAS_SIFLI_SF32LB52_MAILBOX_ENABLED
    select CLK
    help
      SF32LB52 mailbox blocks (MAILBOX1, MAILBOX2), channel 1 doorbells.

config MBOX_SF32LB52_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on MBOX_SF32LB52
    help
      Priority of the interrupt of the blocks rung by the remote.

config MBOX_SHELL
    bool "Mailbox shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The mbox shell command, to list the controllers with their channel
      counters and ring a channel.

endif # MBOX
