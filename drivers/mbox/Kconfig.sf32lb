config MBOX_SF32LB
    bool "SiFli SF32LB mailbox"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_MAILBOX_ENABLED
    select CLK
    help
      SF32LB52 and SF32LB57 mailbox blocks (MAILBOX1, MAILBOX2), channel 1
      doorbells.

config MBOX_SF32LB_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on MBOX_SF32LB
    help
      Priority of the interrupt of the blocks rung by the remote.
