menuconfig TOUCH
    bool "Touchscreen"
    select INPUT
    help
      Touchscreen class (pbl/drivers/touch.h) and its drivers, which
      report touches as input events.

if TOUCH

config TOUCH_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The touch shell command, to inspect the touchscreen and hold it
      powered up.

rsource "Kconfig.cst816"
rsource "Kconfig.ft6236"
rsource "Kconfig.qemu"
rsource "Kconfig.sdl"

module = DRIVER_TOUCH
module-str = Touchscreen
source "subsys/logging/Kconfig.template.log_level"

endif # TOUCH
