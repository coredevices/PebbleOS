menuconfig REMOTEPROC
    bool "Remote processors"
    help
      Remote processor class (pbl/drivers/remoteproc.h), selected by the
      code that boots firmware on other cores.

if REMOTEPROC

config REMOTEPROC_SF32LB
    bool "SiFli SF32LB LCPU"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_LCPU_ENABLED || DT_HAS_SIFLI_SF32LB57_LCPU_ENABLED
    select MBOX
    select NVMEM
    help
      The SF32LB52 and SF32LB57 low-power CPU, running the Bluetooth
      controller from ROM: configuration, ROM patches and radio
      calibration on boot.

config REMOTEPROC_STM32H7_CM4
    bool "STM32H7 Cortex-M4"
    default y
    depends on DT_HAS_ST_STM32H747_M4_ENABLED && SOC_STM32H7_CM7
    select MBOX
    help
      The Cortex-M4 of a dual-core STM32H7, as the Cortex-M7 sees it:
      booted from the address of its option bytes, and told before the
      system powers off.

config REMOTEPROC_SHELL
    bool "Remote processor shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The rproc shell command, to list the remote processors and boot or
      shut them down.

endif # REMOTEPROC
