menuconfig SPI_MEM
    bool "SPI memory controllers"
    help
      Controllers running command, address, dummy and data operations
      against SPI memories.

if SPI_MEM

config SPI_MEM_NRF5_QSPI
    bool "Nordic nRF5 QSPI"
    default y
    depends on DT_HAS_NORDIC_NRF52840_QSPI_ENABLED
    help
      Support for the Nordic nRF5 QSPI peripheral.

config SPI_MEM_NRF5_QSPI_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on SPI_MEM_NRF5_QSPI
    help
      Priority of the controller interrupt.

config SPI_MEM_SF32LB_MPI
    bool "SiFli SF32LB MPI"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_MPI_ENABLED || DT_HAS_SIFLI_SF32LB57_MPI_ENABLED
    select MEMC_SF32LB_MPI
    help
      Support for a SPI NOR flash on the SiFli SF32LB52 and SF32LB57 MPI
      controllers.

module = DRIVER_SPI_MEM
module-str = SPI memory
source "subsys/logging/Kconfig.template.log_level"

endif # SPI_MEM
