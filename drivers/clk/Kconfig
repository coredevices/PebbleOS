config CLK
    bool
    help
      Clock controller class (pbl/drivers/clk.h), selected by the drivers
      that provide clocks.

config CLK_SHELL
    bool "Clock shell commands"
    default DRIVER_SHELL
    depends on SHELL && CLK
    help
      The clk shell command: list clocks and rates, and sample, hold and
      inspect calibrated clocks.

config CLK_FIXED
    bool "Fixed-rate clocks"
    default DT_HAS_FIXED_CLOCK_ENABLED
    select CLK
    help
      Clocks that always run at the same rate, as crystals.

config CLK_SF32LB
    bool "SiFli SF32LB RCC"
    default DT_HAS_SIFLI_SF32LB52_HPSYS_RCC_ENABLED
    select CLK
    help
      Clock controller of the SiFli SF32LB52 HPSYS RCC.

config CLK_CAL
    bool
    select CLK
    help
      Calibrated clocks (pbl/drivers/clk/cal.h), selected by the drivers
      of oscillators whose rate is measured against a reference.

if CLK_CAL

module = CLK_CAL
module-str = Calibrated clocks
source "subsys/logging/Kconfig.template.log_level"

endif # CLK_CAL

config CLK_SF32LB52_PMUC
    bool "SiFli SF32LB52 PMUC"
    default DT_HAS_SIFLI_SF32LB52_PMUC_ENABLED
    select CLK_CAL
    help
      Oscillators of the SiFli SF32LB52 PMUC: the LRC10 low-power RC
      oscillator, whose rate is calibrated against the 48 MHz crystal, the
      LRC32 and HRC48 RC oscillators, the crystal oscillators and clk_wdt.

if CLK_SF32LB52_PMUC

config CLK_SF32LB52_PMUC_LRC10_CAL_GATE_CYCLES
    int "LRC10 calibration gate (LRC10 cycles)"
    range 200 65535
    default 2000
    help
      Length of each LRC10 measurement against the 48 MHz crystal. The
      LRC10 frequency noise averages down as the square root of the gate
      time; the crystal and the low-power domain stay on for the gate.

config CLK_SF32LB52_PMUC_LRC10_CAL_PERIOD_S
    int "LRC10 calibration period (seconds)"
    range 10 3600
    default 60

module = CLK_SF32LB52_PMUC
module-str = SF32LB52 PMUC clocks
source "subsys/logging/Kconfig.template.log_level"

endif # CLK_SF32LB52_PMUC
