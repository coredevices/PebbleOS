config MIPI_DSI
    bool
    help
      MIPI DSI host class (pbl/drivers/mipi_dsi.h), selected by the
      controllers that drive panels over MIPI DSI and by the panel
      drivers using them.

if MIPI_DSI

config MIPI_DSI_STM32
    bool "ST STM32 DSI host"
    default y
    depends on DT_HAS_ST_STM32_DSI_ENABLED
    select CLK
    help
      Support for the DSI host of the STM32H7 and its D-PHY, in video
      mode or in adapted command mode with the tearing effect.

config MIPI_DSI_STM32_IRQ_PRIO
    int "Interrupt priority"
    default 12
    depends on MIPI_DSI_STM32
    help
      Priority of the wrapper interrupt.

endif # MIPI_DSI
