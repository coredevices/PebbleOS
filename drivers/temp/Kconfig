menuconfig TEMP
    bool "Temperature sensor"
    help
      Temperature sensor class (pbl/drivers/temp.h) and its drivers.

if TEMP

config TEMP_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The temp shell command, to read the die temperature.

rsource "Kconfig.nrf5"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32h7_adc"
rsource "Kconfig.sim"

endif # TEMP
