menuconfig TEMP
    bool "Temperature Sensor"
    help
      Temperature Sensor Drivers

if TEMP

config TEMP_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The temp shell command, to read the die temperature.

config TEMP_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 die temperature sensor.

config TEMP_SF32LB
    bool "SiFli SF32LB"
    default DT_HAS_SIFLI_SF32LB52_TSEN_ENABLED
    depends on SOC_SF32LB52
    select CLK
    help
      Support for the SiFli SF32LB temperature sensor.

config TEMP_QEMU
    bool "QEMU"
    default y if SOC_QEMU_PEBBLE
    help
      QEMU temperature sensor. QEMU emulates none, so it reports a fixed
      25 degrees Celsius.

config TEMP_POSIX
    bool "POSIX"
    default y if SOC_POSIX
    help
      Temperature driver for a native build (fixed value).

endif # TEMP
