menuconfig TEMP
    bool "Temperature Sensor"
    help
      Temperature Sensor Drivers

if TEMP

config TEMP_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The temp shell command, to read the die temperature.

config TEMP_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 die temperature sensor.

config TEMP_SF32LB
    bool "SiFli SF32LB"
    default DT_HAS_SIFLI_SF32LB52_TSEN_ENABLED
    depends on SOC_SF32LB52
    select CLK
    help
      Support for the SiFli SF32LB temperature sensor.

config TEMP_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated temperature sensor, reading a value set through its
      simulator API (pbl/drivers/temp/sim.h).

endif # TEMP
