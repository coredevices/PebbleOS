config RESET
    bool
    help
      Reset controller class (pbl/drivers/reset.h), selected by the drivers
      that provide reset lines.

config RESET_SF32LB
    bool "SiFli SF32LB RCC"
    default DT_HAS_SIFLI_SF32LB52_HPSYS_RCC_ENABLED
    select RESET
    help
      Reset controller of the SiFli SF32LB52 HPSYS RCC.
