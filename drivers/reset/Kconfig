menuconfig RESET
    bool "Reset controllers"
    help
      Reset controller class (pbl/drivers/reset.h), selected by the drivers
      that take reset lines.

if RESET

config RESET_SF32LB
    bool "SiFli SF32LB RCC"
    default DT_HAS_SIFLI_SF32LB52_HPSYS_RCC_ENABLED || DT_HAS_SIFLI_SF32LB57_HPSYS_RCC_ENABLED
    help
      Reset controller of the SiFli SF32LB52 and SF32LB57 HPSYS RCC.

endif # RESET
