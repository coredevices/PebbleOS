config RNG_NRF5
    bool "Nordic nRF5"
    default y
    depends on SOC_NRF52
    help
      Support for the Nordic nRF5 RNG.

config RNG_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on RNG_NRF5
    help
      Priority of the RNG interrupt.
