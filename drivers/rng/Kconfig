menuconfig RNG
    bool "Random number generator"
    help
      Random number generator class (pbl/drivers/rng.h) and its drivers.

if RNG

config RNG_NRF5
    bool "Nordic nRF5"
    default y
    depends on SOC_NRF52
    help
      Support for the Nordic nRF5 RNG.

config RNG_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 1
    depends on RNG_NRF5
    help
      Priority of the RNG interrupt.

config RNG_NRF_CRACEN
    bool "Nordic nRF54L CRACEN"
    default y
    depends on DT_HAS_NORDIC_NRF54L15_CRACEN_ENABLED
    select MFD
    select MFD_NRF_CRACEN
    help
      Support for the true random number generator of the Nordic nRF54L
      CRACEN.

config RNG_SF32LB
    bool "SiFli SF32LB"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_TRNG_ENABLED
    select CLK
    help
      Support for the SiFli SF32LB RNG.

config RNG_STM32
    bool "ST STM32"
    default y
    depends on DT_HAS_ST_STM32_RNG_ENABLED
    select CLK
    help
      Support for the ST STM32 RNG.

config RNG_QEMU
    bool "QEMU"
    default y
    depends on SOC_QEMU_PEBBLE
    help
      QEMU RNG. QEMU emulates no RNG, so it returns a fixed value.

config RNG_POSIX
    bool "POSIX"
    default y
    depends on SOC_POSIX
    help
      Host random number generator.

config RNG_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The rng shell command, to print random words and check their bit
      statistics.

module = DRIVER_RNG
module-str = Random number generator
source "subsys/logging/Kconfig.template.log_level"

endif # RNG
