menuconfig RNG
    bool "Random number generator"
    help
      Random number generator class (pbl/drivers/rng.h) and its drivers.

if RNG

rsource "Kconfig.nrf5"
rsource "Kconfig.nrf_cracen"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32"
rsource "Kconfig.qemu"
rsource "Kconfig.posix"

config RNG_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The rng shell command, to print random words and check their bit
      statistics.

module = DRIVER_RNG
module-str = Random number generator
source "subsys/logging/Kconfig.template.log_level"

endif # RNG
