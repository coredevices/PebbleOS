menuconfig MCU
    bool "MCU information"
    help
      MCU information (pbl/drivers/mcu.h), such as the unique ID.

if MCU

config MCU_NRF5
    bool "Nordic nRF5"
    default y
    depends on SOC_NRF52
    help
      Support for Nordic nRF5 MCU information.

config MCU_SF32LB
    bool "SiFli SF32LB"
    default y
    depends on SOC_SF32LB52 || SOC_SF32LB57
    select NVMEM
    help
      Support for SiFli SF32LB MCU information.

config MCU_STM32
    bool "ST STM32"
    default y
    depends on SOC_STM32H7
    select NVMEM
    help
      Support for ST STM32 MCU information.

config MCU_QEMU
    bool "QEMU"
    default y
    depends on SOC_QEMU_PEBBLE
    help
      QEMU MCU information. QEMU emulates no unique ID, so it reports a
      fixed serial.

config MCU_POSIX
    bool "POSIX"
    default y
    depends on SOC_POSIX
    help
      MCU information for a native build.

endif # MCU
