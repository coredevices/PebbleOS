config PINCTRL_STM32
    bool "ST STM32 pin controller"
    default y
    depends on DT_HAS_ST_STM32H743_PINCTRL_ENABLED
    select CLK
    select HWSPINLOCK
    help
      Pin multiplexer and pad configuration of the ST STM32 GPIO ports.
