menu "Sensors"

config SENSOR
    bool "Sensor class"
    help
      Sensor class (pbl/drivers/sensor.h): accelerometers, gyroscopes,
      magnetometers, temperature and pressure sensors. Selected by the
      sensor type menus below.

if SENSOR

config SENSOR_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The sensor shell command, to list the sensors, read them and set
      their attributes.

module = DRIVER_SENSOR
module-str = Sensor
source "subsys/logging/Kconfig.template.log_level"

endif # SENSOR

menuconfig ACCEL
    bool "Accelerometers"
    select SENSOR
    help
      Accelerometer drivers. The board's accelerometer is the accel role,
      ACCEL.

if ACCEL

config ACCEL_LIS2DW12
    bool "ST LIS2DW12"
    default y
    depends on DT_HAS_ST_LIS2DW12_ENABLED
    select I2C
    help
      Support for the ST LIS2DW12 accelerometer.

config ACCEL_LSM6DSO
    bool "ST LSM6DSO"
    default y
    depends on DT_HAS_ST_LSM6DSO_ENABLED
    select I2C
    help
      Support for the ST LSM6DSO accelerometer and gyroscope.

config ACCEL_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated accelerometer, replaying samples and events fed through
      its simulator API (pbl/drivers/sensor/sim.h).

endif # ACCEL

if ACCEL_LIS2DW12

config ACCEL_LIS2DW12_WK_DUR_DEFAULT
    int "Default wake duration"
    range 0 3
    default 0
    help
      Default wake duration applied at init.

config ACCEL_LIS2DW12_WK_THS_MIN
    int "Minimum wake threshold"
    range 0 63
    default 0
    help
      Minimum (highest sensitivity) wake-up threshold.

config ACCEL_LIS2DW12_WK_THS_MAX
    int "Maximum wake threshold"
    range 0 63
    default 63
    help
      Maximum (lowest sensitivity) wake-up threshold.

config ACCEL_LIS2DW12_WK_THS_DEFAULT
    int "Default wake threshold"
    range 0 63
    default 0
    help
      Default wake-up threshold applied at init.

config ACCEL_LIS2DW12_SCALE_MG
    int "Full-scale range (mg)"
    default 2000
    help
      Acceleration full-scale range in mg (2000, 4000, 8000 or 16000).

endif # ACCEL_LIS2DW12

if ACCEL_LSM6DSO

config ACCEL_LSM6DSO_WK_DUR_DEFAULT
    int "Default wake duration"
    range 0 3
    default 0
    help
      Default wake duration applied at init.

config ACCEL_LSM6DSO_WK_THS_MIN
    int "Minimum wake threshold"
    range 0 63
    default 0
    help
      Minimum (highest sensitivity) wake-up threshold.

config ACCEL_LSM6DSO_WK_THS_MAX
    int "Maximum wake threshold"
    range 0 63
    default 63
    help
      Maximum (lowest sensitivity) wake-up threshold.

config ACCEL_LSM6DSO_WK_THS_DEFAULT
    int "Default wake threshold"
    range 0 63
    default 0
    help
      Default wake-up threshold applied at init.

config ACCEL_LSM6DSO_SCALE_MG
    int "Full-scale range (mg)"
    default 2000
    help
      Acceleration full-scale range in mg (2000, 4000, 8000 or 16000).

config ACCEL_LSM6DSO_GYRO_SCALE_DPS
    int "Gyroscope full-scale range (dps)"
    default 2000
    help
      Angular rate full-scale range in degrees per second (125, 250, 500,
      1000 or 2000).

endif # ACCEL_LSM6DSO

menuconfig TEMP
    bool "Temperature sensors"
    select SENSOR
    help
      Temperature sensor drivers. The board's die temperature sensor is
      the die_temp role, DIE_TEMP.

if TEMP

config TEMP_NRF5
    bool "Nordic nRF5"
    default y
    depends on DT_HAS_NORDIC_NRF52832_TEMP_ENABLED
    help
      Support for the Nordic nRF5 die temperature sensor.

config TEMP_SF32LB
    bool "SiFli SF32LB"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_TSEN_ENABLED
    select CLK
    help
      Support for the SiFli SF32LB temperature sensor.

config TEMP_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated temperature sensor, reading a value set through its
      simulator API (pbl/drivers/sensor/sim.h).

endif # TEMP

menuconfig MAG
    bool "Magnetometers"
    select SENSOR
    help
      Magnetometer drivers. The board's magnetometer is the mag role,
      MAG.

if MAG

config MAG_MMC5603NJ
    bool "MEMSIC MMC5603NJ"
    default y
    depends on DT_HAS_MEMSIC_MMC5603_ENABLED
    select I2C
    help
      Support for the MEMSIC MMC5603NJ magnetometer.

config MAG_SIM
    bool "Simulator"
    help
      Simulated magnetometer, measuring a field set through its
      simulator API (pbl/drivers/sensor/sim.h).

endif # MAG

menuconfig PRESSURE
    bool "Pressure sensors"
    select SENSOR
    help
      Barometric pressure sensor drivers. The board's pressure sensor is
      the pressure role, PRESSURE.

if PRESSURE

config PRESSURE_BMP390
    bool "Bosch BMP380 and BMP390"
    default y
    depends on DT_HAS_BOSCH_BMP380_ENABLED
    select I2C
    help
      Support for the Bosch BMP380 and BMP390 barometric pressure sensors
      (devicetree compatible bosch,bmp380).

endif # PRESSURE

endmenu
