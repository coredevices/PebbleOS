config TEMP_SIM
    bool "Simulator"
    default y
    depends on SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated temperature sensor, reading a value set through its
      simulator API (pbl/drivers/sensor/sim.h).
