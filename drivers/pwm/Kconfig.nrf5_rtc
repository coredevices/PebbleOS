config PWM_NRF5_RTC
    bool "Nordic nRF5 RTC PWM"
    default y
    depends on DT_HAS_NORDIC_NRF52832_RTC_PWM_ENABLED
    select CLK
    help
      Support for PWM outputs generated by an nRF5 RTC, through PPI and
      GPIOTE.
