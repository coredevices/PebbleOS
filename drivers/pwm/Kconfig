menuconfig PWM
    bool "PWM"
    help
      PWM Drivers

if PWM

config PWM_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 PWM controller.

config PWM_SF32LB_LPTIM
    bool "SiFli SF32LB LPTIM"
    default y if SOC_SF32LB52
    depends on PINCTRL
    help
      Support for PWM outputs of the SiFli SF32LB low-power timers.

config PWM_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The pwm shell command, to list the controllers and run or disable
      their channels.

endif # PWM
