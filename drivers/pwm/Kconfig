menuconfig PWM
    bool "PWM"
    help
      PWM controller class (pbl/drivers/pwm.h), selected by the drivers
      of PWM-driven devices.

if PWM

rsource "Kconfig.nrf5"
rsource "Kconfig.nrf5_rtc"
rsource "Kconfig.sf32lb_lptim"
rsource "Kconfig.sf32lb_gptim"

config PWM_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The pwm shell command, to list the controllers and run or disable
      their channels.

endif # PWM
