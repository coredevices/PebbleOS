menuconfig PWM
    bool "PWM"
    help
      PWM Drivers

if PWM

config PWM_NRF5
    bool "Nordic nRF5"
    default y if SOC_NRF52
    help
      Support for the Nordic nRF5 PWM controller.

config PWM_NRF5_RTC
    bool "Nordic nRF5 RTC PWM"
    default DT_HAS_NORDIC_NRF52832_RTC_PWM_ENABLED
    help
      Support for PWM outputs generated by an nRF5 RTC, through PPI and
      GPIOTE.

config PWM_SF32LB_LPTIM
    bool "SiFli SF32LB LPTIM"
    default DT_HAS_SIFLI_SF32LB52_LPTIM_PWM_ENABLED
    depends on PINCTRL
    help
      Support for PWM outputs of the SiFli SF32LB low-power timers.

config PWM_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The pwm shell command, to list the controllers and run or disable
      their channels.

endif # PWM
