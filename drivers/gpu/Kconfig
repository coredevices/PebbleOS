menuconfig GPU
    bool "GPU"
    help
      2D graphics accelerators: fills and blits into pixel buffers, with
      blending, rotation and scaling where the hardware can.

if GPU

rsource "Kconfig.sf32lb57_epic"

config GPU_STM32_DMA2D
    bool "ST STM32 DMA2D"
    default y
    depends on DT_HAS_ST_STM32_DMA2D_ENABLED
    select CLK
    help
      Support for the DMA2D (Chrom-ART) graphics accelerator of the STM32:
      fills and blits with format conversion and blending.

config GPU_STM32_DMA2D_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on GPU_STM32_DMA2D
    help
      Priority of the accelerator interrupt.

endif # GPU
