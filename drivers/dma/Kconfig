config DMA
    bool
    help
      DMA controller class (pbl/drivers/dma.h), selected by the controller
      drivers.

config DMA_SF32LB52
    bool "SiFli SF32LB52 DMA controller"
    default DT_HAS_SIFLI_SF32LB52_DMAC_ENABLED
    depends on CLK_SF32LB
    select DMA
    help
      The SF32LB52 HPSYS DMA controller (DMAC1).

config DMA_SF32LB52_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on DMA_SF32LB52
    help
      Priority of the channel interrupts.
