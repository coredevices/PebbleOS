menuconfig DMA
    bool "DMA controllers"
    help
      DMA controller class (pbl/drivers/dma.h), selected by the drivers
      that move data through DMA channels.

if DMA

config DMA_SF32LB52
    bool "SiFli SF32LB52 DMA controller"
    default DT_HAS_SIFLI_SF32LB52_DMAC_ENABLED || DT_HAS_SIFLI_SF32LB57_GPDMA_ENABLED
    select CLK
    help
      The SF32LB52 HPSYS DMA controller (DMAC1), and the SF32LB57 HPSYS
      GPDMA1 used as one.

config DMA_SF32LB52_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on DMA_SF32LB52
    help
      Priority of the channel interrupts.

endif # DMA
