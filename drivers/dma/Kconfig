menuconfig DMA
    bool "DMA controllers"
    help
      DMA controller class (pbl/drivers/dma.h), selected by the drivers
      that move data through DMA channels.

if DMA

config DMA_SF32LB
    bool "SiFli SF32LB DMA controller"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_DMAC_ENABLED || DT_HAS_SIFLI_SF32LB57_GPDMA_ENABLED
    select CLK
    help
      The SF32LB52 HPSYS DMA controller (DMAC1), and the SF32LB57 HPSYS
      GPDMA1 used as one.

config DMA_SF32LB_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on DMA_SF32LB
    help
      Priority of the channel interrupts.

config DMA_STM32H7
    bool "ST STM32H7 DMA1, DMA2 and DMAMUX1"
    default y
    depends on DT_HAS_ST_STM32H7_DMAMUX_ENABLED && DT_HAS_ST_STM32_DMA_ENABLED
    select CLK
    help
      The STM32H7 DMA1 and DMA2 controllers, behind the DMAMUX1 request
      router.

config DMA_STM32H7_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on DMA_STM32H7
    help
      Priority of the stream interrupts.

config DMA_STM32H7_BDMA
    bool "ST STM32H7 BDMA and DMAMUX2"
    default y
    depends on DT_HAS_ST_STM32H7_DMAMUX_ENABLED && DT_HAS_ST_STM32H7_BDMA_ENABLED
    select CLK
    help
      The STM32H7 BDMA controller of the D3 domain, behind the DMAMUX2
      request router.

config DMA_STM32H7_BDMA_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on DMA_STM32H7_BDMA
    help
      Priority of the channel interrupts.

endif # DMA
