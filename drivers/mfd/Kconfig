menuconfig MFD
    bool "Multi-function devices"
    help
      Drivers for the core of chips that bundle several functions, each
      handled by a child device in its own subsystem.

if MFD

config MFD_NPM1300
    bool "Nordic nPM1300"
    default y
    depends on DT_HAS_NORDIC_NPM1300_ENABLED
    select I2C
    help
      Support for the core of the Nordic nPM1300 PMIC: register access
      and its charger, GPIO and regulator cells.

config MFD_NRF_CRACEN
    bool
    help
      Core of the Nordic nRF54L CRACEN crypto accelerator, which turns
      its random number generator and its engines on and off for their
      drivers.

endif # MFD
