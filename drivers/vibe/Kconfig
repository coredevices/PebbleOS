menuconfig VIBE
    bool "Vibration Motor"
    help
      Vibration Motor Drivers

if VIBE

config VIBE_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The vibe shell command, to drive and calibrate the motor.

config VIBE_AW86225
    bool "Awinic AW86225"
    default DT_HAS_AWINIC_AW86225_ENABLED
    select I2C
    select REGULATOR
    help
      Support for the Awinic AW86225 haptic driver.

config VIBE_AW8623X
    bool "Awinic AW86233"
    default DT_HAS_AWINIC_AW86233_ENABLED
    select I2C
    select REGULATOR
    help
      Support for the Awinic AW86233 haptic driver.

config VIBE_DRV2604
    bool "TI DRV2604"
    default DT_HAS_TI_DRV2604_ENABLED
    select I2C
    help
      Support for the TI DRV2604 haptic driver.

config VIBE_SIM
    bool "Simulator"
    default y if SOC_QEMU_PEBBLE || SOC_POSIX
    help
      Simulated vibration motor, reporting its state through its
      simulator API (pbl/drivers/vibe/sim.h).

module = DRIVER_VIBE
module-str = Vibration Motor
source "subsys/logging/Kconfig.template.log_level"

endif # VIBE
