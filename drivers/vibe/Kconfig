menuconfig VIBE
    bool "Vibration Motor"
    help
      Vibration Motor Drivers

if VIBE

config VIBE_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The vibe shell command, to drive and calibrate the motor.

config VIBE_AW86225
    bool "Awinic AW86225"
    default DT_HAS_AWINIC_AW86225_ENABLED
    depends on I2C
    help
      Support for the Awinic AW86225 haptic driver.

config VIBE_AW8623X
    bool "Awinic AW86233"
    default DT_HAS_AWINIC_AW86233_ENABLED
    depends on I2C
    help
      Support for the Awinic AW86233 haptic driver.

config VIBE_DRV2604
    bool "TI DRV2604"
    default DT_HAS_TI_DRV2604_ENABLED
    depends on I2C
    help
      Support for the TI DRV2604 haptic driver.

config VIBE_QEMU
    bool "QEMU"
    default y if SOC_QEMU
    help
      QEMU vibration motor, reporting its state to the QEMU host.

config VIBE_POSIX
    bool "POSIX"
    default y if SOC_POSIX
    help
      Vibration motor of a native build, which does nothing.

module = DRIVER_VIBE
module-str = Vibration Motor
source "subsys/logging/Kconfig.template.log_level"

endif # VIBE
