menu "IMU"

config IMU_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The imu shell command, to read the accelerometer driver directly.

menuconfig ACCEL
    bool "Accelerometer"
    help
      Accelerometer drivers (pbl/drivers/accel.h). The board instantiates
      the accelerometer it has and exports it as ACCEL.

if ACCEL

rsource "Kconfig.lis2dw12"
rsource "Kconfig.lsm6dso"
rsource "Kconfig.accel_sim"

endif # ACCEL

module = DRIVER_IMU
module-str = IMU
source "subsys/logging/Kconfig.template.log_level"

endmenu
