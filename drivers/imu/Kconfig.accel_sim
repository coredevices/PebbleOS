config ACCEL_SIM
    bool "Simulator"
    default y
    depends on SOC_QEMU_PEBBLE || SOC_POSIX
    select KERNEL_SYS_WORKQ_HIGH
    help
      Simulated accelerometer, replaying samples and events fed through
      its simulator API (pbl/drivers/imu/sim.h).
