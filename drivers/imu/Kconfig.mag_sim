config MAG_SIM
    bool "Simulator"
    depends on SOC_QEMU_PEBBLE || SOC_POSIX
    select KERNEL_SYS_WORKQ_HIGH
    help
      Simulated magnetometer, measuring a field set through its
      simulator API (pbl/drivers/imu/sim.h).
