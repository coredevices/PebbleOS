menuconfig I2C
    bool "I2C"
    help
      I2C Drivers

if I2C

config I2C_NRF5
    bool "Nordic nRF5 I2C Controller"
    default y if SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 I2C controller.

config I2C_SF32LB
    bool "SiFli SF32LB I2C Controller"
    default y if SOC_SF32LB52
    depends on CLK_SF32LB && PINCTRL
    select DMA
    help
      Support for the SiFli SF32LB I2C controller.

config I2C_SHELL
    bool "Shell commands"
    default y
    depends on SHELL
    help
      The i2c shell command, to list the buses, scan them and read or
      write device registers.

module = DRIVER_I2C
module-str = I2C
source "subsys/logging/Kconfig.template.log_level"

endif # I2C
