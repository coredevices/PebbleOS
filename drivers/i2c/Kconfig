menuconfig I2C
    bool "I2C"
    help
      I2C bus class (pbl/drivers/i2c.h), selected by the drivers of the
      devices on an I2C bus.

if I2C

rsource "Kconfig.nrf5"
rsource "Kconfig.sf32lb"
rsource "Kconfig.stm32"

config I2C_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The i2c shell command, to list the buses, scan them and read or
      write device registers.

module = DRIVER_I2C
module-str = I2C
source "subsys/logging/Kconfig.template.log_level"

endif # I2C
