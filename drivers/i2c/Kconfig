menuconfig I2C
    bool "I2C"
    help
      I2C Drivers

if I2C

config I2C_NRF5
    bool "Nordic nRF5 I2C Controller"
    default DT_HAS_NORDIC_NRF52832_TWIM_ENABLED
    depends on SOC_NRF52
    select HAL_NORDIC
    help
      Support for the Nordic nRF5 I2C controller.

config I2C_NRF5_IRQ_PRIO
    int "Interrupt priority"
    default 7
    depends on I2C_NRF5
    help
      Priority of the controller interrupts.

config I2C_SF32LB
    bool "SiFli SF32LB I2C Controller"
    default DT_HAS_SIFLI_SF32LB52_I2C_ENABLED
    depends on SOC_SF32LB52
    select CLK
    select DMA
    select PINCTRL
    help
      Support for the SiFli SF32LB I2C controller.

config I2C_SF32LB_IRQ_PRIO
    int "Interrupt priority"
    default 5
    depends on I2C_SF32LB
    help
      Priority of the controller interrupts.

config I2C_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The i2c shell command, to list the buses, scan them and read or
      write device registers.

module = DRIVER_I2C
module-str = I2C
source "subsys/logging/Kconfig.template.log_level"

endif # I2C
