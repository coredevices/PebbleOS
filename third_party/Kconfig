menu "Third-party"

rsource "cmsis_core/Kconfig"
rsource "hal_nordic/Kconfig"
rsource "hal_sifli/Kconfig"
if BT
rsource "nimble/Kconfig"
endif

config MBEDTLS
    bool "mbedTLS"
    help
      Build the mbedTLS cryptography library.

config NANOPB
    bool "Nanopb"
    help
      Build the Nanopb Protocol Buffers library.

config QR_CODE_GENERATOR
    bool "QR Code generator"
    help
      Build the QR Code generator library.

config UPNG
    bool "uPNG"
    help
      Build the uPNG PNG decoder.

config SPEEX
    bool "Speex"
    help
      Build the Speex audio codec.

config TINYMT
    bool "TinyMT"
    help
      Build the TinyMT pseudo-random number generator.

config UZLIB
    bool "uzlib"
    help
      Build the uzlib deflate decompressor.

config CST816_FW
    bool
    help
      Hynitron CST816 touch controller firmware image for the board.

config HRM_BACKEND_GOODIX
    bool "Goodix heart rate algorithms"
    depends on PPG_GH3X2X && BOARD_OBELIX
    default y
    select HRM_BACKEND
    select HRM_BACKEND_HRV
    help
      Heart rate, SpO2, HRV and wear detection from the Goodix algorithm
      libraries, fed with samples of the GH3X2X front end.

endmenu
