menu "Third-party"

rsource "hal_nordic/Kconfig"
rsource "hal_sifli/Kconfig"
rsource "nimble/Kconfig"

config MBEDTLS
    bool "mbedTLS"
    help
      Build the mbedTLS cryptography library.

config NANOPB
    bool "Nanopb"
    help
      Build the Nanopb Protocol Buffers library.

config QR_CODE_GENERATOR
    bool "QR Code generator"
    help
      Build the QR Code generator library.

config UPNG
    bool "uPNG"
    help
      Build the uPNG PNG decoder.

config SPEEX
    bool "Speex"
    help
      Build the Speex audio codec.

config CST816_FW
    bool
    help
      Hynitron CST816 touch controller firmware image for the board.

config GH3X2X_ALGO
    bool "Goodix GH3X2X algorithm library"
    depends on HRM_GH3X2X && BOARD_OBELIX
    default y if !RECOVERY_FW || MFG
    help
      Link the Goodix heart rate algorithm library and its driver
      glue. The plain recovery firmware only needs the sensor driver.

endmenu
