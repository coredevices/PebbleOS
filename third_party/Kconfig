menu "Third-party"

rsource "hal_nordic/Kconfig"
rsource "hal_sifli/Kconfig"
rsource "nimble/Kconfig"

config MBEDTLS
    bool "mbedTLS"
    help
      Build the mbedTLS cryptography library.

config SPEEX
    bool "Speex"
    help
      Build the Speex audio codec.

config CST816_FW
    bool
    help
      Hynitron CST816 touch controller firmware image for the board.

config HRM_BACKEND_GOODIX
    bool "Goodix heart rate algorithms"
    depends on PPG_GH3026 && BOARD_OBELIX
    default y if !RECOVERY_FW || MFG
    select HRM_BACKEND
    select HRM_BACKEND_HRV
    help
      Heart rate, SpO2, HRV and wear detection from the Goodix algorithm
      libraries, fed with samples of the GH3026 front end.

endmenu
