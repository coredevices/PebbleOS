menu "Core"

config NIMBLE_BLE_ROLE_CENTRAL
    bool "Central bluetooth role"
    default y

config NIMBLE_BLE_ROLE_PERIPHERAL
    bool "Peripheral bluetooth role"
    default y

config NIMBLE_BLE_ROLE_BROADCASTER
    bool "Broadcaster bluetooth role"
    default y

config NIMBLE_BLE_ROLE_OBSERVER
    bool "Observer bluetooth role"
    default y

config NIMBLE_BLE_MAX_CONNECTIONS
    int "Maximum number of concurrent connections"
    default 1

config NIMBLE_BLE_MAX_PERIODIC_SYNCS
    int "Maximum number of concurrent periodic syncs that can be created"
    default 1

config NIMBLE_BLE_WHITELIST
    bool "BLE whitelist"
    default y
    help
      Enables the BLE whitelist for controlling who to connect to or
      accept a connection from. (0/1)

config NIMBLE_BLE_MULTI_ADV_INSTANCES
    int "Number of multi-advertising instances"
    default 0
    help
      This is the number of multi-advertising instances. This is NOT the
      total number of advertising instances. The total number of
      advertising instances is this number plus 1 (assuming the device
      supports advertising).

config NIMBLE_BLE_EXT_ADV
    bool "Extended advertising"

config NIMBLE_BLE_PERIODIC_ADV
    bool "Periodic advertising"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_EXT_ADV if 1

config NIMBLE_BLE_PERIODIC_ADV_SYNC_TRANSFER
    bool "Periodic Advertising Sync Transfer"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_PERIODIC_ADV if 1
        - (BLE_ROLE_CENTRAL || BLE_ROLE_PERIPHERAL) if 1

config NIMBLE_BLE_PERIODIC_ADV_SYNC_BIGINFO_REPORTS
    bool "BIGInfo reports"
    help
      Experimental upstream.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_PERIODIC_ADV if 1
        - (BLE_VERSION >= 52) if 1

config NIMBLE_BLE_EXT_ADV_MAX_SIZE
    int "Maximum size of advertising data"
    default 31
    help
      This allows to configure maximum size of advertising data and scan
      response data used in LE Advertising Extensions. Valid range
      31-1650.

config NIMBLE_BLE_VERSION
    int "Configure supported Bluetooth Core version"
    default 50
    help
      This allows to configure supported Bluetooth Core version. Some
      features may not be available if version is too low. Version is
      integer for easy comparison.

      Valid values: 50, 51, 52, 53, 54, 60, 61, 62, 63.

config NIMBLE_BLE_ISO
    bool "LE Isochronous Channels as per Bluetooth v5.2"
    default y if (NIMBLE_BLE_ISO_BROADCAST_SOURCE || NIMBLE_BLE_ISO_BROADCAST_SINK)
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 52) if 1
        - (BLE_ISO_BROADCAST_SOURCE || BLE_ISO_BROADCAST_SINK) if 1

config NIMBLE_BLE_ISO_BROADCAST_SOURCE
    bool "LE Audio Broadcast Source"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 52) if 1

config NIMBLE_BLE_ISO_BROADCAST_SINK
    bool "LE Audio Broadcast Sink"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 52) if 1

config NIMBLE_BLE_ISO_TEST
    int "BLE ISO Testing commands"
    default 0
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_ISO if 1

config NIMBLE_BLE_CHANNEL_SOUNDING
    bool "Channel Sounding"

config NIMBLE_BLE_HCI_VS
    bool "NimBLE specific vendor HCI commands"
    default y if NIMBLE_BLE_CONTROLLER

config NIMBLE_BLE_HCI_VS_OCF_OFFSET
    int "Starting offset for NimBLE specific vendor HCI commands"
    default 0
    help
      This defines starting offset for NimBLE specific vendor HCI
      commands. Purpose of this is to improve compatibility with other
      custom implementations.

config NIMBLE_BLE_POWER_CONTROL
    bool "LE Power Control"

config NIMBLE_BLE_CONN_SUBRATING
    bool "LE Connection Subrating"

config NIMBLE_BLE_PHY_2M
    bool "Addtitional 2M PHY"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_PHY if 1

config NIMBLE_BLE_PHY_CODED
    int "Addtitional CODED PHY"
    default 0
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_PHY if 1

config NIMBLE_BLE_PHY
    int "BLE PHY"
    depends on (NIMBLE_BLE_PHY_2M || NIMBLE_BLE_PHY_CODED != 0)
    default 1

