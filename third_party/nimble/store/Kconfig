choice NIMBLE_STORE_BACKEND
    prompt "Store backend"
    depends on NIMBLE_STORE_CONFIG
    default NIMBLE_STORE_BACKEND_SETTINGS if SETTINGS
    default NIMBLE_STORE_BACKEND_RAM
    help
      Where the store keeps the keys of bonded peers and their CCCDs.

config NIMBLE_STORE_BACKEND_RAM
    bool "RAM"
    help
      Keep them in RAM only: they are lost on reset.

config NIMBLE_STORE_BACKEND_SETTINGS
    bool "Settings file"
    depends on SETTINGS
    help
      Keep them in a settings file, along with a local IRK generated once.

config NIMBLE_STORE_BACKEND_PRF
    bool "PRF store"
    select BT_PRF_STORE
    help
      Keep one bonding, the last one written, in the PRF store, the
      flash partition the recovery firmware and the normal firmware
      share. The others, and the CCCDs, stay in RAM. The local IRK is
      left to whoever uses the store.

endchoice

config NIMBLE_STORE_SETTINGS_PRF_MIRROR
    bool "Mirror the last bonding to the PRF store"
    depends on NIMBLE_STORE_BACKEND_SETTINGS
    select BT_PRF_STORE
    help
      Keep the bonding written last in the PRF store too, and take the
      one found there when the store loads: firmware that uses the PRF
      store backend then shares the bonding of this one.

config NIMBLE_STORE_SETTINGS_FILE_SIZE
    int "Store file size in bytes"
    depends on NIMBLE_STORE_BACKEND_SETTINGS
    default 4096
    help
      Space the settings file of the store may use. The store keeps the
      keys of up to BLE_STORE_MAX_BONDS peers and BLE_STORE_MAX_CCCDS
      subscriptions; the file needs room to rewrite them as they change.
