config NIMBLE_BLE_SVC_DIS
    bool "Device Information Service"

menu "Device Information Service"
visible if NIMBLE_BLE_SVC_DIS

config NIMBLE_BLE_SVC_DIS_DEFAULT_READ_PERM
    int "Default permissions for reading characteristics"
    default -1 if NIMBLE_BLE_SVC_DIS
    default 0
    help
      Defines default permissions for reading characteristics. Can be
      zero to allow read without extra permissions or combination of:
      BLE_GATT_CHR_F_READ_ENC BLE_GATT_CHR_F_READ_AUTHEN
      BLE_GATT_CHR_F_READ_AUTHOR Set to '-1' to remove this
      characteristic.

config NIMBLE_BLE_SVC_DIS_MODEL_NUMBER_READ_PERM
    int "Permissions for reading 'Model Number' characteristics"
    default 0
    help
      Defines permissions for reading "Model Number" characteristics.
      Can be set to BLE_SVC_DIS_DEFAULT_READ_PERM or use any of the
      possible values defined for that setting.

config NIMBLE_BLE_SVC_DIS_MODEL_NUMBER_DEFAULT
    string "BLE SVC DIS model number default"
    default "Apache Mynewt NimBLE" if NIMBLE_BLE_SVC_DIS
    help
      Defines a default value for "Model number" if not set with
      'ble_svc_dis_model_number_set'.

config NIMBLE_BLE_SVC_DIS_SERIAL_NUMBER_READ_PERM
    int "Permissions for reading 'Serial Number' characteristics"
    default NIMBLE_BLE_SVC_DIS_DEFAULT_READ_PERM if NIMBLE_BLE_SVC_DIS
    default 0
    help
      Defines permissions for reading "Serial Number" characteristics.
      Can be set to BLE_SVC_DIS_DEFAULT_READ_PERM or use any of the
