menu "Store"

config NIMBLE_BLE_STORE_MAX_BONDS
    int "Maximum number of bonds that can be persisted"
    default 3
    help
      Maximum number of bonds that can be persisted. Note: increasing
      this value may also require increasing the capacity of the
      underlying storage mechanism.

config NIMBLE_BLE_STORE_MAX_CCCDS
    int "Maximum number of client characteristic configuration descriptors"
    default 8
    help
      Maximum number of client characteristic configuration descriptors
      that can be persisted. Note: increasing this value may also
      require increasing the capacity of the underlying storage
      mechanism.

config NIMBLE_BLE_MESH
    int "Bluetooth Mesh support"
    default 0
    help
      This option enables Bluetooth Mesh support. The specific features
      that are available may depend on other features that have been
      enabled in the stack, such as GATT support.

config NIMBLE_BLE_AUDIO
    bool "Bluetooth LE Audio support"
    help
      Experimental upstream.

endmenu

menu "Flow control"

config NIMBLE_BLE_HS_FLOW_CTRL
    bool "Whether to enable host-side flow control"
    help
      Whether to enable host-side flow control. This should only be
      enabled in host-only setups (i.e., not combined-host-controller).

config NIMBLE_BLE_HS_FLOW_CTRL_ITVL
    int "BLE HS flow control interval"
    default 1000
    help
      The interval, in milliseconds, that the host should provide
      number-of-completed-packets updates to the controller.

config NIMBLE_BLE_HS_FLOW_CTRL_THRESH
    int "BLE HS flow control thresh"
    default 2
    help
      If the number of data buffers available to the controller falls to
      this number, immediately send a number-of-completed-packets event.
      The free buffer count is calculated as follows: (total-acl-bufs -
      bufs-freed-since-last-num-completed-event).

config NIMBLE_BLE_HS_FLOW_CTRL_TX_ON_DISCONNECT
    bool "BLE HS flow control TX on disconnect"
    help
      If enabled, the host will immediately transmit a host-number-of-
      completed-packets command whenever a connection terminates. This
      behavior is not required by the standard, but is a necessary
      workaround when interfacing with some controllers.

config NIMBLE_BLE_HS_STOP_ON_SHUTDOWN
    int "Stops the Bluetooth host when the system shuts down"
    default 1
    help
      Stops the Bluetooth host when the system shuts down. Stopping
      entails aborting all GAP procedures and terminating open
      connections.

config NIMBLE_BLE_HS_STOP_ON_SHUTDOWN_TIMEOUT
    int "Timeout used in NimBLE's host stop procedure in ms"
    default 2000

config NIMBLE_BLE_HS_SYSINIT_STAGE
    int "Sysinit stage for the NimBLE host"
    default 200

config NIMBLE_BLE_HS_GAP_UNHANDLED_HCI_EVENT
    bool "GAP event for received HCI events that are not handled by host"
    help
      Enables GAP event for received HCI events that are not handled by
      host. This can be used to implement/test features that are not yet
      supported by host.

endmenu

