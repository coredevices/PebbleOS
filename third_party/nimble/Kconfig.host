menu "Host"

config NIMBLE_BLE_HOST
    bool "That a BLE host is present"
    default y

config NIMBLE_BLE_HS_AUTO_START
    bool "BLE host to automatically start during system initialization"
    default y

config NIMBLE_BLE_HS_EXT_ADV_LEGACY_INSTANCE
    int "BLE HS ext ADV legacy instance"
    range 0 NIMBLE_BLE_MULTI_ADV_INSTANCES
    default 0
    help
      Advertising instance that is used when extended advertising
      support is enabled but legacy GAP API is used.

menu "Debug"

config NIMBLE_BLE_HS_DEBUG
    bool "Extra runtime assertions"

config NIMBLE_BLE_HS_PHONY_HCI_ACKS
    bool "Rather than wait for HCI acknowledgements from a controller"
    help
      Rather than wait for HCI acknowledgements from a controller, the
      host simulates incoming acks. Only recommended for test code
      running in the simulator.

config NIMBLE_BLE_HS_REQUIRE_OS
    bool "Whether the host can depend on the kernel being present"
    default y
    help
      Specifies whether the host can depend on the kernel being present.
      This should only be disabled for unit tests running in the
      simulator.

endmenu

menu "L2CAP"

# BLE_L2CAP_MAX_CHANS is fixed by syscfg.h (3*MYNEWT_VAL_BLE_MAX_CONNECTIONS).

config NIMBLE_BLE_L2CAP_SIG_MAX_PROCS
    int "Maximum number of concurrent L2CAP signal procedures"
    default 1

config NIMBLE_BLE_L2CAP_JOIN_RX_FRAGS
    bool "BLE L2CAP join RX frags"
    default y
    help
      Whether to collapse incoming L2CAP fragments into a minimal set of
      mbufs. 1: Slower, more memory efficient. 0: Faster, less memory
      efficient.

config NIMBLE_BLE_L2CAP_RX_FRAG_TIMEOUT
    int "Expiry time for incoming data packets (ms)"
    default 30000
    help
      Expiry time for incoming data packets (ms). If this much time
      passes since the previous fragment was received, the connection is
      terminated. A value of 0 means no timeout.

config NIMBLE_BLE_L2CAP_COC_MAX_NUM
    int "Maximum number of LE Connection Oriented Channels channels"
    default 0
    help
      Defines maximum number of LE Connection Oriented Channels
      channels. When set to (0), LE COC is not compiled in.

# BLE_L2CAP_COC_MPS is fixed by syscfg.h (MYNEWT_VAL_MSYS_1_BLOCK_SIZE-8).

config NIMBLE_BLE_L2CAP_COC_SDU_BUFF_COUNT
    int "Maximum number of SDU buffers in L2CAP COC endpoints"
    default 1
    help
      Defines maximum number of SDU buffers in L2CAP COC endpoints.
      Provides more currently available credits to receive more data
      packets.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_L2CAP_COC_SDU_BUFF_COUNT > 0

config NIMBLE_BLE_L2CAP_ENHANCED_COC
    bool "LE Enhanced CoC mode"
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_L2CAP_COC_MAX_NUM > 0) && (BLE_VERSION >= 52) if 1

endmenu

menu "Security manager"

config NIMBLE_BLE_SM_LEGACY
    bool "Security manager legacy pairing"
    default y

config NIMBLE_BLE_SM_SC
    bool "Security manager secure connections (4.2)"
    default y if NIMBLE_BLE_MESH != 0

config NIMBLE_BLE_SM_SC_ONLY
    bool "Force global Secure Connections Pairing Only mode"
    help
      Force global Secure Connections Pairing Only mode. This means that
      only SC pairing mode 1 level 4 shall be used, and all
      characteristics will require it to access, except these requiring
      mode 1 level 1.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_SM_LVL == 4 if 1
        - BLE_SM_MITM
        - BLE_SM_SC if 1
        - !BLE_SM_LEGACY if 1

config NIMBLE_BLE_SM_LVL
    int "Force global Secure Connections mode 1 level"
    range 0 4
    default 0
    help
      Force global Secure Connections mode 1 level. This level describes
      requirements for pairing response/request received to accept
      pairing: - 1 - do not pair; only access to characteristics with no
      authentication requirements is granted - 2 - allow to pair despite
      MITM being on or off - 3 - allow to pair only when MITM protection
      is on - 4 - allow to pair only with Secure Connections and when
      128 bit key is used and MITM is on When set to 0 level is no
      forced and pairing is allowed for all requests/responses with
      valid values (for example pairing will be rejected with key longer
      than 128 bits). Successful pairing with insufficient security will
      still cause denying access to protected GATT characteristics.

config NIMBLE_BLE_SM_MAX_PROCS
    int "Maximum number of concurrent security manager procedures"
    default 1

choice NIMBLE_BLE_SM_IO_CAP_CHOICE
    prompt "IO capabilities to report during pairing"
    default NIMBLE_BLE_SM_IO_CAP_NO_INPUT_OUTPUT
    help
      The IO capabilities to report during pairing. Valid values are:
      BLE_HS_IO_DISPLAY_ONLY BLE_HS_IO_DISPLAY_YESNO
      BLE_HS_IO_KEYBOARD_ONLY BLE_HS_IO_NO_INPUT_OUTPUT
      BLE_HS_IO_KEYBOARD_DISPLAY

config NIMBLE_BLE_SM_IO_CAP_DISPLAY_ONLY
    bool "DISPLAY_ONLY"

config NIMBLE_BLE_SM_IO_CAP_DISPLAY_YESNO
    bool "DISPLAY_YESNO"

config NIMBLE_BLE_SM_IO_CAP_KEYBOARD_ONLY
    bool "KEYBOARD_ONLY"

config NIMBLE_BLE_SM_IO_CAP_NO_INPUT_OUTPUT
    bool "NO_INPUT_OUTPUT"

config NIMBLE_BLE_SM_IO_CAP_KEYBOARD_DISPLAY
    bool "KEYBOARD_DISPLAY"

endchoice

config NIMBLE_BLE_SM_OOB_DATA_FLAG
    bool "Whether the out-of-band pairing algorithm is advertised"

config NIMBLE_BLE_SM_BONDING
    bool "Bonding (persistence and restoration of secure links)"

config NIMBLE_BLE_SM_MITM
    bool "Whether man-in-the-middle protection is advertised during pairing"

config NIMBLE_BLE_SM_KEYPRESS
    bool "Whether keypress support is advertised during pairing"

config NIMBLE_BLE_SM_OUR_KEY_DIST
    int "Bitmap indicating which keys to distribute during pairing"
    default 0
    help
      A bitmap indicating which keys to distribute during pairing. The
      bits are defined as follows: 0x01: BLE_SM_PAIR_KEY_DIST_ENC 0x02:
      BLE_SM_PAIR_KEY_DIST_ID 0x04: BLE_SM_PAIR_KEY_DIST_SIGN 0x08:
      BLE_SM_PAIR_KEY_DIST_LINK

config NIMBLE_BLE_SM_THEIR_KEY_DIST
    int "Bitmap indicating which keys to accept during pairing"
    default 0
    help
      A bitmap indicating which keys to accept during pairing. The bits
      are defined as follows: 0x01: BLE_SM_PAIR_KEY_DIST_ENC 0x02:
      BLE_SM_PAIR_KEY_DIST_ID 0x04: BLE_SM_PAIR_KEY_DIST_SIGN 0x08:
      BLE_SM_PAIR_KEY_DIST_LINK

config NIMBLE_BLE_SM_SC_DEBUG_KEYS
    bool "SM debug mode"
    help
      Enable SM debug mode. In this mode SM uses predefined DH key pair
      as described in Core Specification 5.0, Vol. 3, Part H, 2.3.5.6.1.
      This allows to decrypt air traffic easily and thus should be only
      used for debugging.

config NIMBLE_BLE_SM_CSIS_SIRK
    bool "LE Audio CSIS SIRK Encryption and Decryption API"
    help
      Experimental upstream.

endmenu

