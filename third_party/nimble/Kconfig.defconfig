#
# Porting defaults for the NimBLE options generated in this directory. Sourced
# before them so these defaults win.

if NIMBLE

# NimBLE's transport choice says where the link layer lives. PebbleOS supplies
# its own transport for every controller other than the in-image NimBLE one.
choice NIMBLE_BLE_TRANSPORT_LL_CHOICE
    default NIMBLE_BLE_TRANSPORT_LL_NATIVE if NIMBLE_HCI_NRF52
    default NIMBLE_BLE_TRANSPORT_LL_CUSTOM
endchoice

# Sized over the peak measured under load (22 blocks). Exhaustion blocks the
# HCI RX task, it does not drop data.
config NIMBLE_BLE_TRANSPORT_ACL_COUNT
    default 36 if NIMBLE_HCI_SF32LB

# BR/EDR events take up to the largest size HCI allows.
config NIMBLE_BLE_TRANSPORT_EVT_SIZE
    default 257 if NIMBLE_BLE_BREDR

endif # NIMBLE
