config NIMBLE_BLE_LL_TX_PWR_DBM
    int "Default Transmit power level (in dBm)"
    default 0
    help
      Default Transmit power level (in dBm). Actual transmit power may
      be rounded up or down depending on used radio.

config NIMBLE_BLE_LL_TX_PWR_MAX_DBM
    int "Maximum allowed transmit power level (in dBm)"
    default 20 if BT_HCI_NRF52
    default 0
    help
      Maximum allowed transmit power level (in dBm). This limits maximum
      power to specified value (including FEM and/or host compensation).
      Useful for ensuring selected power class of device. Defaults to
      maximum allowed by specification (Power Class 1).

config NIMBLE_BLE_LL_NUM_COMP_PKT_ITVL_MS
    int "BLE LL number comp pkt interval MS"
    default 2000 if BT_HCI_NRF52
    default 0
    help
      Determines the interval at which the controller will send the
      number of completed packets event to the host. Rate is in
      milliseconds.

config NIMBLE_BLE_LL_MANUFACTURER_ID
    int "Manufacturer ID, as assigned by Bluetooth SIG"
    default 2917 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_NUM_SCAN_DUP_ADVS
    int "Number of duplicate advertisers stored"
    default 8 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_NUM_SCAN_RSP_ADVS
    int "Number of advertisers from which we have heard a scan response"
    default 8 if BT_HCI_NRF52
    default 0
    help
      The number of advertisers from which we have heard a scan
      response. Prevents sending duplicate events to host.

config NIMBLE_BLE_LL_WHITELIST_SIZE
    int "Size of the LL whitelist"
    default 8 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_RESOLV_LIST_SIZE
    int "Size of the resolving list"
    default 4 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_CONN_PHY_DEFAULT_PREF_MASK
    int "BLE LL connection PHY default pref mask"
    default 7 if BT_HCI_NRF52
    default 0
    help
      Default PHY preference mask used if no HCI LE Set Preferred PHY
      was received.

config NIMBLE_BLE_LL_CONN_PHY_PREFER_2M
    bool "BLE LL connection PHY prefer 2M"
    default n if BT_HCI_NRF52
    help
      If enabled, LL will always attempt to switch to 2M PHY if present
      in preferred mask even if active PHY is also allowed by that mask.
      Otherwise LL will not attempt to switch PHY as long as active PHY
      is present in preferred mask.

config NIMBLE_BLE_LL_CONN_PHY_INIT_UPDATE
    bool "BLE LL connection PHY init update"
    default n if BT_HCI_NRF52
    help
      If enabled, LL will attempt to switch PHY (depending on
      preferences mask set) after connection was established.

config NIMBLE_BLE_LL_MAX_PKT_SIZE
    int "Maximum PDU size that can be sent/received"
    default 251 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_SUPP_MAX_RX_BYTES
    int "Maximum supported received PDU size"
    default NIMBLE_BLE_LL_MAX_PKT_SIZE if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_SUPP_MAX_TX_BYTES
    int "Maximum supported transmit PDU size"
    default NIMBLE_BLE_LL_MAX_PKT_SIZE if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_CONN_INIT_MAX_TX_BYTES
    int "Used to set the initial maximum transmit PDU size in a connection"
    default 27 if BT_HCI_NRF52
    default 0
    help
      Used to set the initial maximum transmit PDU size in a connection.
      The host can always tell the controller to update this value.

config NIMBLE_BLE_LL_CONN_INIT_AUTO_DLE
    bool "BLE LL connection init auto dle"
    default y if BT_HCI_NRF52
    help
      If BLE_LL_CONN_INIT_MAX_TX_BYTES is set to value greater than 27
      controller will automatically attempt to do the data length update
      procedure.

config NIMBLE_BLE_LL_CONN_INIT_SLOTS
    int "Number of 'slots' allocated to a connection"
    default 4 if BT_HCI_NRF52
    default 0
    help
      This is the number of "slots" allocated to a connection when
      scheduling connections. Each slot is 1.25 msecs long. Note that a
      connection event may last longer than the number of slots
      allocated here and may also end earlier (depending on when the
      next scheduled event occurs and how much data needs to be
      transferred in the connection). However, you will be guaranteed
      that a connection event will be given this much time, if needed.
      Consecutively scheduled items will be at least this far apart

config NIMBLE_BLE_LL_CONN_INIT_MIN_WIN_OFFSET
    int "BLE LL connection init minimum win offset"
    default 0
    help
      This is the minimum number of "slots" for WindowOffset value used
      for CONNECT_IND when creating new connection as a master. Each
      slot is 1.25 msecs long. Increasing this value will delay first
      connection event after connection is created. However, older TI
      CC254x controllers cannot change connection parameters later if
      WindowOffset was set to 0 in CONNECT_IND. To ensure
      interoperability with such devices set this value to 2 (or more).

config NIMBLE_BLE_LL_CONN_STRICT_SCHED
    bool "Connection strict scheduling (css)"
    default n if BT_HCI_NRF52
    help
      Enable connection strict scheduling (css). In css mode,
      connections in central role are scheduled in fixed time intervals
      called periods. Each period is divided into an arbitrary number of
      slots and each connection anchor point is always scheduled at slot
      boundary. This means (assuming only central connections are
      active) it's possible to reliably schedule up to number-of-slots
      connections each at period-duration interval, each connection will
      be allocated at least one slot in each connection event.

config NIMBLE_BLE_LL_CONN_STRICT_SCHED_FIXED
    bool "Fixed mode for connection strict scheduling"
    default n if BT_HCI_NRF52
    help
      Enable fixed mode for connection strict scheduling, i.e. slot
      duration and slots per period values are fixed to syscfg values
      and cannot be changed in runtime. This allows for some compile-
      time optimizations.

config NIMBLE_BLE_LL_CONN_STRICT_SCHED_SLOT_US
    int "Slot duration in microseconds"
    default 3750 if BT_HCI_NRF52
    default 0
    help
      Slot duration in microseconds. Shall be multiply of 1250us.

config NIMBLE_BLE_LL_CONN_STRICT_SCHED_PERIOD_SLOTS
    int "Number of slots per period"
    default 8 if BT_HCI_NRF52
    default 0
    help
      Number of slots per period. Duration of slot determines connection
      interval used for each connection in central role.

config NIMBLE_BLE_LL_RNG_BUFSIZE
    int "Number of random bytes"
    default 32 if BT_HCI_NRF52
    default 0
    help
      The number of random bytes that the link layer will try to always
      have available for the host to use. Decreasing this value may
      cause host delays if the host needs lots of random material often.

config NIMBLE_BLE_LL_RFMGMT_ENABLE_TIME
    int "BLE LL rfmgmt enable time"
    default 0
    help
      Time required for radio and/or related components to be fully
      enabled before any request from LL is sent. This value is used by
      rfmgmt to enable PHY in advance, before request from LL is made.
      It depends on radio driver selected and may also depend on
      hardware used: - nrf51 - time required for XTAL to settle - nrf52
      - time required for XTAL to settle Value is specified in
      microseconds. If set to 0, rfmgmt keeps PHY enabled all the time.

config NIMBLE_BLE_LL_HCI_LLCP_TRACE
    bool "LLCP tracing using HCI vendor-specific events"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_LL_CFG_FEAT_LE_ENCRYPTION
    bool "Encryption support in the controller"
    default y if BT_HCI_NRF52 && NIMBLE_BLE_LL_ISO_BROADCASTER
    default y if BT_HCI_NRF52 && ((NIMBLE_BLE_LL_ROLE_CENTRAL || NIMBLE_BLE_LL_ROLE_PERIPHERAL) || NIMBLE_BLE_LL_ISO)
    default n if BT_HCI_NRF52
    help
      This option enables/disables encryption support in the controller.
      This option saves both both code and RAM.

config NIMBLE_BLE_LL_CFG_FEAT_CONN_PARAM_REQ
    bool "Connection parameter request procedure"
    default y if BT_HCI_NRF52 && (NIMBLE_BLE_LL_ROLE_CENTRAL || NIMBLE_BLE_LL_ROLE_PERIPHERAL)
    default n if BT_HCI_NRF52
    help
      This option enables/disables the connection parameter request
      procedure. This is implemented in the controller but is disabled
      by default.

config NIMBLE_BLE_LL_CFG_FEAT_PERIPH_INIT_FEAT_XCHG
    bool "BLE LL configuration feature periph init feature xchg"
    default y if BT_HCI_NRF52 && (NIMBLE_BLE_LL_ROLE_CENTRAL || NIMBLE_BLE_LL_ROLE_PERIPHERAL)
    default n if BT_HCI_NRF52
    help
      This option allows a slave to initiate the feature exchange
      procedure. This feature is implemented but currently has no impact
      on code or ram size

config NIMBLE_BLE_LL_CFG_FEAT_LE_PING
    bool "This option allows a controller to send/receive LE pings"
    default NIMBLE_BLE_LL_CFG_FEAT_LE_ENCRYPTION if BT_HCI_NRF52
    help
      This option allows a controller to send/receive LE pings.
      Currently, this feature is not implemented by the controller so
      turning it on or off has no effect.

config NIMBLE_BLE_LL_CFG_FEAT_DATA_LEN_EXT
    bool "Data length update procedure in the controller"
    default y if BT_HCI_NRF52 && (NIMBLE_BLE_LL_ROLE_CENTRAL || NIMBLE_BLE_LL_ROLE_PERIPHERAL)
    default n if BT_HCI_NRF52
    help
      This option enables/disables the data length update procedure in
      the controller. If enabled, the controller is allowed to change
      the size of tx/rx pdu's used in a connection. This option has only
      minor impact on code size and non on RAM.

