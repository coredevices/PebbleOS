    default 0

config NIMBLE_BLE_LL_CFG_FEAT_LL_PERIODIC_ADV_SYNC_TRANSFER
    bool "Periodic Advertising Sync Transfer"
    default NIMBLE_BLE_PERIODIC_ADV_SYNC_TRANSFER if BT_HCI_NRF52

config NIMBLE_BLE_LL_CFG_FEAT_LL_PERIODIC_ADV_ADI_SUPPORT
    bool "Periodic Advertising ADI"
    default n if BT_HCI_NRF52
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 53) if 1
        - (BLE_LL_CFG_FEAT_LL_PERIODIC_ADV == 1)

config NIMBLE_BLE_LL_CFG_FEAT_CTRL_TO_HOST_FLOW_CONTROL
    bool "Controller-to-host flow control support"
    default n if BT_HCI_NRF52
    help
      Enable controller-to-host flow control support. This allows host
      to limit number of ACL packets sent at once from controller to
      avoid congestion on HCI transport if feature is also supported by
      host.

      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_ROLE_CENTRAL || BLE_ROLE_PERIPHERAL) if 1

config NIMBLE_BLE_LL_CFG_FEAT_LL_SCA_UPDATE
    bool "SCA update procedure"
    default n if BT_HCI_NRF52
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 52) if 1

config NIMBLE_BLE_LL_CFG_FEAT_LL_ENHANCED_CONN_UPDATE
    bool "Support LE Enhanced Connection Update"
    default NIMBLE_BLE_CONN_SUBRATING if BT_HCI_NRF52
    help
      Enables support LE Enhanced Connection Update. This allows to use
      Conenction Subrate Update and Connection Subrate Request
      procedures to modify subrate paramters for a connection.

      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 53) if 1

config NIMBLE_BLE_LL_ADV_CODING_SELECTION
    int "Support Advertising Coding Selection"
    default 0
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 54) if 1

config NIMBLE_BLE_LL_PERIODIC_ADV_SYNC_BIGINFO_REPORTS
    bool "Handling BIGInfo data"
    default NIMBLE_BLE_PERIODIC_ADV_SYNC_BIGINFO_REPORTS if BT_HCI_NRF52
    help
      Experimental upstream.

config NIMBLE_BLE_LL_SCAN_AUX_SEGMENT_CNT
    int "Number of auxiliary advertising segments"
    default 8 if BT_HCI_NRF52 && NIMBLE_BLE_LL_CFG_FEAT_LL_EXT_ADV
    default 0
    help
      Number of auxiliary advertising segments that can be scanned
      concurrently (Core 5.2, Vol 6, Part B, 4.4.2.2.2).

config NIMBLE_BLE_LL_SCAN_ACTIVE_SCAN_NRPA
    bool "BLE LL scan active scan NRPA"
    default NIMBLE_BLE_LL_CFG_FEAT_LL_PRIVACY if BT_HCI_NRF52
    help
      The controller will automatically generate NRPA for scan requests
      if host requested to use privacy (i.e. 0x02 or 0x03 own address
      type) but the peer is not on the resolving list. If disabled,
      public or random address will be used.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_CFG_FEAT_LL_PRIVACY if 1

config NIMBLE_BLE_LL_PUBLIC_DEV_ADDR
    int "Public device address"
    default 0
    help
      Set public device address. Address is specified as 48-bit number.
      If non-zero, this setting has priority over BLE_PUBLIC_DEV_ADDR.
      Note: this setting should only be used for testing purposes, it is
      not intended for production builds.

config NIMBLE_BLE_LL_DTM
    bool "HCI Test commands needed for Bluetooth SIG certification"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_LL_DTM_EXTENSIONS
    bool "Non-standard extensions to HCI test commands"
    default n if BT_HCI_NRF52
    help
      Enables non-standard extensions to HCI test commands. Once
      enabled, HCI_LE_Transmitter_Test accepts extra parameters in
      addition to those defined in Core specification interval (2
      octets) interval between packets (usecs), overrides standard
      interval pkt_count (2 octets) number of packets to transmit,
      controller will automatically stop sending packets after given
      number of packets was sent Setting either of these parameters to 0
      will configure for default behavior, as per Core specification. If
      specified interval is shorter then allowed by specification it
      will be ignored. Extended parameters shall immediately follow
      standard parameters. Controller can accept both standard and
      extended version of command depending on specified HCI command
      length.

config NIMBLE_BLE_LL_HCI_VS
    bool "Vendor-specific HCI commands"
    default NIMBLE_BLE_HCI_VS if BT_HCI_NRF52

config NIMBLE_BLE_LL_HCI_VS_CONN_STRICT_SCHED
    bool "HCI commands to control connection strict scheduling"
    default n if BT_HCI_NRF52
    help
      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_HCI_VS if 1

config NIMBLE_BLE_LL_HCI_VS_LOCAL_IRK
    bool "BLE LL HCI VS local IRK"
    default n if BT_HCI_NRF52
    help
      Enables HCI command to set local IRK. The local IRK is used by
      controller to generate RPA address in case own address type 0x02
      or 0x03 was requested by host but there is no corresponding entry
      on resolving list. This allows to handle privacy scenarios almost
      entirely in controller. If no local IRK is set, the controller
      behaves as if feature is not enabled.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_HCI_VS if 1

config NIMBLE_BLE_LL_HCI_VS_SET_SCAN_CFG
    bool "HCI command to set global PDU filter for scanner"
    default n if BT_HCI_NRF52
    help
      Enables HCI command to set global PDU filter for scanner. It
      allows: - ignoring extended or legacy PDUs while scanning, -
      setting minimal RSSI filter on primary channel

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_HCI_VS if 1
        - BLE_LL_CFG_FEAT_LL_EXT_ADV if 1
        - BLE_LL_ROLE_OBSERVER if 1

config NIMBLE_BLE_LL_HCI_VS_EVENT_ON_ASSERT
    bool "BLE LL HCI VS event on assert"
    default n if BT_HCI_NRF52
    help
      This options enables controller to send a vendor-specific event on
      an assertion in controller code. The event contains file name and
      line number where assertion occured.

config NIMBLE_BLE_FEM_PA
    bool "FEM PA support"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_FEM_PA_GAIN
    int "PA fixed TX gain (in dBm)"
    default 0

config NIMBLE_BLE_FEM_PA_GAIN_TUNABLE
    bool "PA TX gain is tunable and not constant"
    default n if BT_HCI_NRF52
    help
      PA TX gain is tunable and not constant. If enabled
      ble_fem_pa_tx_power_set() and ble_fem_pa_tx_power_round() shall be
      implemented (see ble_fem.h for details).

config NIMBLE_BLE_FEM_PA_GPIO
    int "GPIO pin number to control PA. Pin is set to high state"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to control PA. Pin is set to high state when PA
      should be enabled.

config NIMBLE_BLE_FEM_PA_TURN_ON_US
    int "Time required for PA to turn on, in microseconds"
    default 1 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_FEM_LNA
    bool "LNA support"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_FEM_LNA_GAIN
    int "LNA fixed RX gain (in dBm)"
    default 0

config NIMBLE_BLE_FEM_LNA_GAIN_TUNABLE
    bool "LNA RX gain is tunable and not constant"
    default n if BT_HCI_NRF52
    help
      LNA RX gain is tunable and not constant. If enabled
      ble_fem_lna_rx_gain() shall be implemented (see ble_fem.h for
      details).

config NIMBLE_BLE_FEM_LNA_GPIO
    int "GPIO pin number to control LNA. Pin is set to high state"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to control LNA. Pin is set to high state when LNA
      should be enabled.

config NIMBLE_BLE_FEM_LNA_TURN_ON_US
    int "Time required for LNA to turn on, in microseconds"
    default 1 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_FEM_ANTENNA
    bool "Runtime antenna selection in FEM"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_LL_ISO
    bool "Isochronous data"
    default NIMBLE_BLE_ISO if BT_HCI_NRF52
    help
      Enable support for isochronous data. This enables common code
      (e.g. ISOAL) for all types of isochronous data, particular ISO
      features have to be enabled separately.

      Experimental upstream.

      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 52) if 1

config NIMBLE_BLE_LL_ISO_BROADCASTER
    bool "Isochronous Broadcasting state"
    default y if BT_HCI_NRF52 && (NIMBLE_BLE_ISO_BROADCAST_SOURCE || NIMBLE_BLE_ISO_BROADCAST_SINK)
    default n if BT_HCI_NRF52
    help
      Experimental upstream.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_ISO if 1

config NIMBLE_BLE_LL_ISO_HCI_FEEDBACK_INTERVAL_MS
    int "ISO synchronization feedback using vendor-specific HCI event"
    default 0
    help
      Enables ISO synchronization feedback using vendor-specific HCI
      event. The event is sent at configured interval after completed
      ISO event and contains BIG handle, number of expected SDUs per ISO
      interval and difference between expected vs actual number of SDUs
      queued in controller. The expected number of SDUs queued after
      each event is number of SDUs required for each ISO event (i.e.
      including pre-transmissions) minus number of SDUs expected per
      each ISO interval. The host can use feedback to e.g. adjust for
      jitter between audio clock and LL clock. Set to 0 to disable.

      Experimental upstream.

      NimBLE restrictions, which Kconfig does not enforce:
        - BLE_LL_HCI_VS || BLE_LL_ISO_HCI_FEEDBACK_INTERVAL_MS == 0

config NIMBLE_BLE_LL_ISO_HCI_DISCARD_THRESHOLD
    int "BLE LL ISO HCI discard threshold"
    default 0
    help
      Enables automatic discarding of excessive ISO SDUs to avoid
      exhaustion of HCI ISO buffers in case host sends too many SDUs.
      Threshold is defined as number of ISO events. If number of queued
      SDUs exceeds number of SDUs required for single event (i.e.
      including pre-transmissions) and number of subsequent ISO events
      defined by threshold value, the controller will drop any excessive
      SDUs and notify to host as if they were already sent. Set to 0 to
      disable.

      Experimental upstream.

config NIMBLE_BLE_LL_ISOAL_MUX_PREFILL
    bool "BLE LL isoal mux prefill"
    default n if BT_HCI_NRF52
    help
      Waits until number of SDUs enqueued in mux is enough to fill
      complete ISO event before providing data to ISO. This is useful
      for pre-transmissions as it ensures that all subevents in 1st ISO
      event are non-empty.

      Experimental upstream.

config NIMBLE_BLE_LL_CHANNEL_SOUNDING
    bool "Channel Sounding"
    default NIMBLE_BLE_CHANNEL_SOUNDING if BT_HCI_NRF52
    help
      Experimental upstream.

      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_VERSION >= 54) if 1

config NIMBLE_BLE_LL_SYSINIT_STAGE
    int "Sysinit stage for the NimBLE controller"
    default 250 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_DEBUG_GPIO_HCI_CMD
    int "GPIO pin number to debug HCI commands flow"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to debug HCI commands flow. Pin is set to high
      state when HCI command is being processed.

config NIMBLE_BLE_LL_DEBUG_GPIO_HCI_EV
    int "GPIO pin number to debug HCI events flow"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to debug HCI events flow. Pin is set to high state
      when HCI event is being sent.

config NIMBLE_BLE_LL_DEBUG_GPIO_SCHED_RUN
    int "GPIO pin number to debug scheduler running (on timer)"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to debug scheduler running (on timer). Pin is set
      to high state while scheduler is running.

config NIMBLE_BLE_LL_DEBUG_GPIO_SCHED_ITEM
    int "GPIO pin number to debug scheduler item execution times"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to debug scheduler item execution times. Pin is
      set to high state while item is active.

config NIMBLE_BLE_LL_DEBUG_GPIO_RFMGMT
    int "GPIO pin number to debug rfmgmt activity"
    default -1 if BT_HCI_NRF52
    default 0
    help
      GPIO pin number to debug rfmgmt activity. Pin is set to high state
      while rfmgmt is active.

config NIMBLE_BLE_LL_EXT
    bool "API to support external (i.e"
    default n if BT_HCI_NRF52
    help
      Enables API to support external (i.e. non-native to LL) state for
      NimBLE LL and scheduler. See ble_ll_ext.h.

      Experimental upstream.

config NIMBLE_BLE_LL_SCHED_AUX_MAFS_DELAY
    int "Additional delay [us] between last ADV_EXT_IND"
    default 0
    help
      Additional delay [us] between last ADV_EXT_IND and AUX_ADV_IND
      PDUs when scheduling extended advertising event. This extends
      T_MAFS.

config NIMBLE_BLE_LL_SCHED_AUX_CHAIN_MAFS_DELAY
    int "Additional delay [us] between consecutive AUX_CHAIN_IND PDUs"
    default 0
    help
      Additional delay [us] between consecutive AUX_CHAIN_IND PDUs when
      scheduling extended or periodic advertising event. This extends
      T_MAFS.

config NIMBLE_BLE_LL_SCHED_SCAN_AUX_PDU_LEN
    int "Expected PDU len for AUX_ADV_IND"
    range 1 257 if BT_HCI_NRF52
    default 41 if BT_HCI_NRF52
    default 0
    help
      This is expected PDU len for AUX_ADV_IND and subsequent
      AUX_CHAIN_IND. When scheduling scan scheduler will reserve time
      for receiving this amount of time. Setting this to high value
      improves reception of large PDUs but results in wasting scheduler
      space when receiving small PDUs only. On the other hand too low
      value can result in not being able to scan whole PDU due to being
      preempted by next scheduled item. By default size matching legacy
      ADV_IND PDU payload is used: ExtHeader (Flags, AdvA, ADI) + 31
      bytes of data.

config NIMBLE_BLE_LL_SCHED_SCAN_SYNC_PDU_LEN
    int "Expected PDU len for AUX_SYNC_IND"
    range 1 257 if BT_HCI_NRF52
    default 32 if BT_HCI_NRF52
    default 0
    help
      This is expected PDU len for AUX_SYNC_IND and subsequent
      AUX_CHAIN_IND. When scheduling scan scheduler will reserve time
      for receiving this amount of time. Setting this to high value
      improves reception of large PDUs but results in wasting scheduler
      space when receiving small PDUs only. On the other hand too low
      value can result in not being able to scan whole PDU due to being
      preempted by next scheduled item. By default size matching PDU
      with legacy data size is used: ExtHeader + 31 bytes of data.

config NIMBLE_BLE_LL_CONN_EVENT_END_MARGIN
    int "Extra time needed for scheduling next connection event"
    default 0
    help
      Extra time needed for scheduling next connection event. Setting
      this value results in ending connection event sooner (in
      microseconds) which gives more time to schedule next event. This
      value should be tuned only after measuring performance as depends
      on various factors like build optimisation, cache, clock speed
      etc.

config NIMBLE_BLE_LL_EXT_ADV_ADVA_IN_AUX
    bool "Put AdvA in AUX_ADV_IND instead of ADV_EXT_IND"
    default y if BT_HCI_NRF52

config NIMBLE_BLE_LL_STACK_SIZE
    int "Stack size for LL task"
    default 200 if BT_HCI_NRF52 && NIMBLE_BLE_LL_ISO_BROADCASTER
    default 120 if BT_HCI_NRF52
    default 0

config NIMBLE_BLE_LL_PHY
    bool "BLE LL PHY"
    depends on (NIMBLE_BLE_LL_CFG_FEAT_LE_2M_PHY || NIMBLE_BLE_LL_CFG_FEAT_LE_CODED_PHY != 0)
    default y if BT_HCI_NRF52

config NIMBLE_BLE_LL_HBD_FAKE_DUAL_MODE
    bool "Hacks to allow initialize controler as dual-mode device"
    default n if BT_HCI_NRF52
    help
      This enables hacks to allow initialize controler as dual-mode
      device. It can be initialized and used by Windows 10 to some
      extent.

      NimBLE restrictions, which Kconfig does not enforce:
        - (BLE_TRANSPORT_EVT_SIZE == 257) if 1

endmenu
