config NIMBLE_BLE_LL_CFG_FEAT_LE_CSA2
    bool "LE Channel Selection Algorithm #2"
    default y if BT_HCI_NRF52 && NIMBLE_BLE_LL_CFG_FEAT_LL_EXT_ADV
    default n if BT_HCI_NRF52

