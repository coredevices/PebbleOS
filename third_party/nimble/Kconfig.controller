    bool "Periodic Advertising"
    default NIMBLE_BLE_PERIODIC_ADV if BT_HCI_NRF52

config NIMBLE_BLE_LL_CFG_FEAT_LL_PERIODIC_ADV_SYNC_CNT
    int "Number of supported periodic syncs"
