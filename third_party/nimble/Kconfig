menuconfig NIMBLE
    bool "NimBLE"
    select MBEDTLS
    help
      The NimBLE Bluetooth Low Energy stack: its host, its porting layer
      on the PebbleOS kernel, and the HCI transport to the controller.

if NIMBLE

rsource "port/Kconfig"
rsource "transport/Kconfig"
rsource "store/Kconfig"

choice "NIMBLE_LOG_LEVEL_CHOICE"
    default NIMBLE_LOG_LEVEL_OFF
endchoice

module = NIMBLE
module-str = NimBLE host
source "subsys/logging/Kconfig.template.log_level"

# NimBLE's own options, generated from its syscfg.yml files by
# scripts/gen_syscfg.py. Their defaults go in Kconfig.defconfig files sourced
# before them: the porting ones here, the Bluetooth subsystem's in
# subsys/bluetooth, per-SoC ones in soc/*.
rsource "Kconfig.ble"
rsource "Kconfig.host"
rsource "Kconfig.svcs"
rsource "Kconfig.store"
rsource "Kconfig.transport"
rsource "Kconfig.controller"
rsource "Kconfig.drivers"
rsource "Kconfig.port"

endif # NIMBLE
