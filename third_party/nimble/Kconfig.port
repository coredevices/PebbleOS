    default 1000000

config NIMBLE_OS_CPUTIME_TIMER_NUM
    int "Hardware timer the cputime counter runs on"
    default 0

config NIMBLE_TIMER_0
    bool "Hardware timer 0"

config NIMBLE_TIMER_1
    bool "Hardware timer 1"

config NIMBLE_TIMER_2
    bool "Hardware timer 2"

