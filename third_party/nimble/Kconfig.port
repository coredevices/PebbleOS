menu "Porting layer"

menu "Memory pool"

config NIMBLE_MSYS_1_BLOCK_COUNT
    int "Number of blocks in the first mbuf pool"
    default 12

config NIMBLE_MSYS_1_BLOCK_SIZE
    int "Size of each block in the first mbuf pool"
    default 292

config NIMBLE_MSYS_1_SANITY_MIN_COUNT
    int "MSYS 1 sanity minimum count"
    default 0
    help
      Minimum number of free blocks the first mbuf pool must keep for
      the sanity check to pass. Zero disables the check.

config NIMBLE_MSYS_2_BLOCK_COUNT
    int "Number of blocks in the second mbuf pool"
    default 0

config NIMBLE_MSYS_2_BLOCK_SIZE
    int "Size of each block in the second mbuf pool"
    default 0

config NIMBLE_MSYS_2_SANITY_MIN_COUNT
    int "MSYS 2 sanity minimum count"
    default 0
    help
      Minimum number of free blocks the second mbuf pool must keep for
      the sanity check to pass. Zero disables the check.

config NIMBLE_MSYS_SANITY_TIMEOUT
    int "Interval between mbuf pool sanity checks, in ms"
    default 60000

config NIMBLE_OS_MEMPOOL_CHECK
    bool "Validate every block freed back into a memory pool"

config NIMBLE_OS_MEMPOOL_GUARD
    bool "Place a guard word at the end of each memory pool block"

config NIMBLE_OS_MEMPOOL_POISON
    bool "Poison memory pool blocks as they are freed"

endmenu

menu "CPU time"

config NIMBLE_OS_CPUTIME_FREQ
