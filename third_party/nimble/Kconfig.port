    bool "Hardware timer 3"

config NIMBLE_TIMER_4
    bool "Hardware timer 4"

config NIMBLE_TIMER_5
    bool "Hardware timer 5"

endmenu

menu "Tracing"

config NIMBLE_OS_SYSVIEW
    bool "SEGGER SystemView tracing"

config NIMBLE_OS_SYSVIEW_TRACE_MBUF
    bool "Trace mbuf operations through SystemView"

config NIMBLE_OS_SYSVIEW_TRACE_MEMPOOL
    bool "Trace memory pool operations through SystemView"

endmenu

menu "Miscellaneous"

config NIMBLE_TRNG
    bool "True random number generator is available"
    help
      A true random number generator is available, and NimBLE should
      take its random numbers from it.

config NIMBLE_SELFTEST
    bool "Build for NimBLE's own unit tests"
    help
      Build for NimBLE's own unit tests, which run parts of the stack
      without a kernel underneath.

