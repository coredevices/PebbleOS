# Generated by scripts/gen_syscfg.py -- do not edit.

menu "HCI transport"

config NIMBLE_BLE_TRANSPORT
    int "BLE transport"
    default 1

choice NIMBLE_BLE_TRANSPORT_HS_CHOICE
    prompt "HCI transport used towards host"
    default NIMBLE_BLE_TRANSPORT_HS_NATIVE
    help
      Select HCI transport used towards host. "native" means NimBLE host
      is running on the same core and no transport is required.

config NIMBLE_BLE_TRANSPORT_HS_NATIVE
    bool "native"

config NIMBLE_BLE_TRANSPORT_HS_DIALOG_CMAC
    bool "dialog_cmac"

config NIMBLE_BLE_TRANSPORT_HS_NRF5340
    bool "nrf5340"

config NIMBLE_BLE_TRANSPORT_HS_UART
    bool "uart"

config NIMBLE_BLE_TRANSPORT_HS_USB
    bool "usb"

config NIMBLE_BLE_TRANSPORT_HS_CDC
    bool "cdc"

config NIMBLE_BLE_TRANSPORT_HS_CUSTOM
    bool "custom"

endchoice

choice NIMBLE_BLE_TRANSPORT_LL_CHOICE
    prompt "HCI transport used towards controller"
    default NIMBLE_BLE_TRANSPORT_LL_NATIVE
    help
      Select HCI transport used towards controller. "native" means
      NimBLE controller is running on the same core and no transport is
      required.

config NIMBLE_BLE_TRANSPORT_LL_NATIVE
    bool "native"

config NIMBLE_BLE_TRANSPORT_LL_EMSPI
    bool "emspi"

config NIMBLE_BLE_TRANSPORT_LL_DIALOG_CMAC
    bool "dialog_cmac"

config NIMBLE_BLE_TRANSPORT_LL_NRF5340
    bool "nrf5340"

config NIMBLE_BLE_TRANSPORT_LL_SOCKET
    bool "socket"

config NIMBLE_BLE_TRANSPORT_LL_APOLLO3
    bool "apollo3"

config NIMBLE_BLE_TRANSPORT_LL_UART_LL
    bool "uart_ll"

config NIMBLE_BLE_TRANSPORT_LL_CUSTOM
    bool "custom"

endchoice

config NIMBLE_BLE_TRANSPORT_ACL_COUNT
    int "Number of ACL buffers available in transport"
    default 10
    help
      Number of ACL buffers available in transport. This determines
      number of buffers used by host/controller for flow control.
      Buffers pool is allocated for each non-native transport side
      selected, unless overriden by
      BLE_TRANSPORT_ACL_FROM_[HS|LL]_COUNT.

config NIMBLE_BLE_TRANSPORT_ACL_SIZE
    int "Size of each buffer in ACL pool"
    default 251

config NIMBLE_BLE_TRANSPORT_ISO_COUNT
    int "Number of ISO buffers available in transport"
    default 10
    help
      Number of ISO buffers available in transport. This determines
      number of buffers used by host/controller for flow control.
      Buffers pool is allocated for each non-native transport side
      selected, unless overriden by
      BLE_TRANSPORT_ISO_FROM_[HS|LL]_COUNT.

config NIMBLE_BLE_TRANSPORT_ISO_SIZE
    int "Size of each buffer in ISO pool"
    default 300

config NIMBLE_BLE_TRANSPORT_EVT_COUNT
    int "Number of event buffers available in transport"
    default 4

config NIMBLE_BLE_TRANSPORT_EVT_DISCARDABLE_COUNT
    int "Number of discardable event buffers available in transport"
    default 16
    help
      Number of discardable event buffers available in transport.
      Discardable event buffers are used for events that can be safely
      dropped by controller if there's no free buffer available, e.g.
      advertising reports.

config NIMBLE_BLE_TRANSPORT_EVT_SIZE
    int "Size of each buffer in events pool"
    default 257 if (NIMBLE_BLE_EXT_ADV || NIMBLE_BLE_LL_CFG_FEAT_LL_EXT_ADV)
    default 78 if (NIMBLE_BLE_CHANNEL_SOUNDING && !(NIMBLE_BLE_EXT_ADV || NIMBLE_BLE_LL_CFG_FEAT_LL_EXT_ADV))
    default 70
    help
      Size of each buffer in events pool. This applies to both regular
      and discardable buffers. Value is automatically adjusted if
      extended advertising is enabled so in most cases it's better to
      leave it at default settings.

config NIMBLE_BLE_TRANSPORT_ACL_FROM_HS_COUNT
    int "Overrides BLE_TRANSPORT_ACL_COUNT on host side"
    default NIMBLE_BLE_TRANSPORT_ACL_COUNT
    help
      Overrides BLE_TRANSPORT_ACL_COUNT on host side, i.e. number of ACL
      buffers available for host.

config NIMBLE_BLE_TRANSPORT_ACL_FROM_LL_COUNT
    int "Overrides BLE_TRANSPORT_ACL_COUNT on controller side"
    default NIMBLE_BLE_TRANSPORT_ACL_COUNT
    help
      Overrides BLE_TRANSPORT_ACL_COUNT on controller side, i.e. number
      of ACL buffers available for controller.

config NIMBLE_BLE_TRANSPORT_ISO_FROM_HS_COUNT
    int "Overrides BLE_TRANSPORT_ISO_COUNT on host side"
    default NIMBLE_BLE_TRANSPORT_ISO_COUNT
    help
      Overrides BLE_TRANSPORT_ISO_COUNT on host side, i.e. number of ISO
      buffers available for host.

config NIMBLE_BLE_TRANSPORT_ISO_FROM_LL_COUNT
    int "Overrides BLE_TRANSPORT_ISO_COUNT on controller side"
    default NIMBLE_BLE_TRANSPORT_ISO_COUNT
    help
      Overrides BLE_TRANSPORT_ISO_COUNT on controller side, i.e. number
      of ISO buffers available for controller.

# BLE_TRANSPORT_RX_TASK_STACK_SIZE is left undefined by syscfg.h.

# BLE_TRANSPORT_RX_TASK is left undefined by syscfg.h.

# BLE_TRANSPORT_RX_TASK_PRIO is left undefined by syscfg.h.

config NIMBLE_BLE_MONITOR_UART
    bool "Monitor interface over UART"

config NIMBLE_BLE_MONITOR_UART_DEV
    string "Monitor interface UART device"
    default "uart0"

config NIMBLE_BLE_MONITOR_UART_BAUDRATE
    int "Baudrate for monitor interface UART"
    default 1000000

config NIMBLE_BLE_MONITOR_UART_BUFFER_SIZE
    int "BLE monitor UART buffer size"
    default 64
    help
      Monitor interface ringbuffer size for UART. This value should be a
      power of 2.

config NIMBLE_BLE_MONITOR_RTT
    bool "Monitor interface over RTT"

config NIMBLE_BLE_MONITOR_RTT_BUFFER_NAME
    string "Monitor interface upstream buffer name"
    default "btmonitor"

config NIMBLE_BLE_MONITOR_RTT_BUFFER_SIZE
    int "Monitor interface upstream buffer size"
    default 256

config NIMBLE_BLE_MONITOR_RTT_BUFFERED
    bool "BLE monitor RTT buffered"
    default y
    help
      Enables buffering when using monitor interface over RTT. The data
      are written to RTT once complete packet is created in intermediate
      buffer. This allows to skip complete packet if there is not enough
      space in RTT buffer (e.g. there is no reader connected). If
      disabled, monitor will simply block waiting for RTT to free space
      in buffer.

config NIMBLE_BLE_MONITOR_CONSOLE_BUFFER_SIZE
    int "Size of internal buffer for console output"
    default 128
    help
      Size of internal buffer for console output. Any line exceeding
      this length value will be split.

config NIMBLE_BLE_MONITOR
    int "BLE monitor"
    depends on (NIMBLE_BLE_MONITOR_UART || NIMBLE_BLE_MONITOR_RTT)
    default 1

endmenu
