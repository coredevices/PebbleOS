# Generated by scripts/gen_syscfg.py -- do not edit.

menu "Radio driver"
visible if BT_HCI_NRF52

config NIMBLE_BLE_PHY_VARIABLE_TIFS
    bool "API to set custom T_ifs (inter-frame spacing) for each transition"
    default n if BT_HCI_NRF52
    help
      Enables API to set custom T_ifs (inter-frame spacing) for each
      transition. T_ifs is reset to default value after each transition.
      When disabled, 150us is always used which enables some build-time
      optimizations by compiler.

      Experimental upstream.

config NIMBLE_BLE_PHY_EXTENDED_TIFS
    int "BLE PHY extended TIFS"
    range 0 4 if BT_HCI_NRF52
    default 2 if BT_HCI_NRF52
    default 0
    help
      This allows to extend T_ifs (inter-frame spacing) by additional
      microseconds to improve interoperability with peripherals that
      send packets too late (eg 153us). This prolongs reception time by
      additional microseconds. Defaults to 2us to improve operations
      with devices already on the market.

config NIMBLE_BLE_PHY_SYSVIEW
    bool "SystemView tracing module for radio driver"
    default n if BT_HCI_NRF52

config NIMBLE_BLE_PHY_DBG_TIME_TXRXEN_READY_PIN
    int "When set to proper GPIO pin number"
    default -1 if BT_HCI_NRF52
    default 0
    help
      When set to proper GPIO pin number, this pin will be set to high
      state when radio is enabled using PPI channels 20 or 21 and back
      to low state on radio EVENTS_READY. This can be used to measure
      radio ram-up time.

config NIMBLE_BLE_PHY_DBG_TIME_ADDRESS_END_PIN
    int "When set to proper GPIO pin number"
    default -1 if BT_HCI_NRF52
    default 0
    help
      When set to proper GPIO pin number, this pin will be set to high
      state on radio EVENTS_ADDRESS and back to low state on radio
      EVENTS_END. This can be used to measure radio pipeline delays.

config NIMBLE_BLE_PHY_DBG_TIME_WFR_PIN
    int "When set to proper GPIO pin number"
    default -1 if BT_HCI_NRF52
    default 0
    help
      When set to proper GPIO pin number, this pin will be set to high
      state on radio EVENTS_RXREADY and back to low state when wfr timer
      expires. This can be used to check if wfr is calculated properly.

config NIMBLE_BLE_PHY_NRF52_HEADERMASK_WORKAROUND
    bool "BLE PHY nrf52 headermask workaround"
    default n if BT_HCI_NRF52
    help
      This enables workaround for lack of HEADERMASK register on some
      nRF52 family MCUs (notably nRF52840) which is required for
      enabling encryption for ISO PDUs. Note: this requires exclusive
      access to CCM_AAR interrupt and only works for TX (i.e. ISO
      Broadcaster).

config NIMBLE_BLE_PHY_NRF5340_VDDH
    bool "If VDDH pin of nRF5340 is connected to external power source"
    default n if BT_HCI_NRF52
    help
      This indicates if VDDH pin of nRF5340 is connected to external
      power source. If connected PHY driver will make use of high
      voltage operation mode for additional TX power levels (+3, +2, +1,
      -9, -13, -17, -37).

config NIMBLE_BLE_PHY_UBLOX_BMD345_PUBLIC_ADDR
    bool "BLE PHY ublox bmd345 public addr"
    default n if BT_HCI_NRF52
    help
      Ublox BMD-345 modules come with public address preprogrammed in
      UICR register. If enabled public address will be read from custom
      UICR instead of FICR register.

choice NIMBLE_MCU_TARGET_CHOICE
    prompt "Part the NimBLE radio driver is built for"
    default NIMBLE_MCU_TARGET_NRF52840

config NIMBLE_MCU_TARGET_NRF51822
    bool "nRF51822"

config NIMBLE_MCU_TARGET_NRF52810
    bool "nRF52810"

config NIMBLE_MCU_TARGET_NRF52811
    bool "nRF52811"

config NIMBLE_MCU_TARGET_NRF52832
    bool "nRF52832"

config NIMBLE_MCU_TARGET_NRF52840
    bool "nRF52840"

config NIMBLE_MCU_TARGET_NRF5340_NET
    bool "nRF5340_NET"

endchoice

choice NIMBLE_MCU_HFCLK_SOURCE_CHOICE
    prompt "Source of the high-frequency clock the radio"
    default NIMBLE_MCU_HFCLK_SOURCE_HFINT
    help
      Source of the high-frequency clock the radio and the cputime timer
      run from.

config NIMBLE_MCU_HFCLK_SOURCE_HFINT
    bool "HFINT"

config NIMBLE_MCU_HFCLK_SOURCE_HFXO
    bool "HFXO"

endchoice

endmenu
