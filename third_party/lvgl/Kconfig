menuconfig LVGL
    bool "LVGL"
    depends on DISPLAY
    help
      Build the LVGL graphics library and its port to the display and
      input devices of the board. LVGL is configured with its own
      options, the LV_* symbols.

if LVGL

config LVGL_DRAW_BUFFER_ROWS
    int "Rows of the draw buffer"
    default 32
    range 1 65535
    help
      Where LVGL does not render straight into the frame of the
      display, it renders in bands of this many rows that the port
      copies or converts. More rows render faster and take more of the
      kernel heap.

config LVGL_DRAW_GPU
    bool "Draw with the GPU"
    depends on GPU
    default y
    help
      Hand the fills and the image and layer blits the GPU of the board
      can take to it, through the GPU class. Everything else, and what
      the GPU refuses, is drawn in software.

config LVGL_DRAW_GPU_MIN_PIXELS
    int "Smallest area drawn with the GPU, in pixels"
    depends on LVGL_DRAW_GPU
    default 1024
    help
      Smaller areas are drawn in software, where setting the GPU up
      costs more than drawing them.

config LVGL_DRAW_GPU_GLYPH_MIN_PIXELS
    int "Smallest glyph drawn with the GPU, in pixels"
    depends on LVGL_DRAW_GPU
    default 1024
    help
      Smaller glyphs of a label are blended in software, which is as
      fast as a GPU job for the glyphs of text at reading sizes.

config LVGL_KEY_QUEUE_LEN
    int "Key events queued between two reads"
    depends on INPUT
    default 8

module = LVGL
module-str = LVGL
source "subsys/logging/Kconfig.template.log_level"

orsource "lvgl/Kconfig"

endif # LVGL
