menu "Kernel"

config KERNEL_IDLE_STACK_SIZE
	int "Idle thread stack size in bytes"
	default 1024

config KERNEL_MAIN_STACK_SIZE
	int "Main thread stack size in bytes"
	default 4096

config KERNEL_MAIN_THREAD_PRIO
	int "Main thread priority"
	default 3

config KERNEL_SYS_WORKQ_STACK_SIZE
	int "Background work queue stack size in bytes"
	default 4096

config KERNEL_SYS_WORKQ_PRIO
	int "Background work queue priority"
	default 1

config KERNEL_SYS_WORKQ_BOOST_PRIO
	int "Background work queue priority while running boosted work"
	default 3

config KERNEL_SYS_WORKQ_CALLS
	int "Calls with a payload pending at once on the background work queue"
	default 30

config KERNEL_SYS_WORKQ_CALL_TIMEOUT_MS
	int "Time to wait for a background work queue slot before stopping the system"
	default 3000

config KERNEL_SYS_WORKQ_HIGH_CALLS
	int "Calls with a payload pending at once on the high priority work queue"
	default 5

config KERNEL_SYS_WORKQ_HIGH_CALL_TIMEOUT_MS
	int "Time to wait for a high priority work queue slot"
	default 50

config KERNEL_SYS_WORKQ_HIGH_STACK_SIZE
	int "High priority work queue stack size in bytes"
	default 1380

config KERNEL_SYS_WORKQ_HIGH_PRIO
	int "High priority work queue priority"
	default 4

config KERNEL_ISR_STACK_SIZE
	int "ISR stack size in bytes"
	default 1024

config ARCH_HAS_COREDUMP
	bool
	help
	  The architecture can capture its state for a core dump.

config ARCH_HAS_STACK_GUARD
	bool
	help
	  The architecture can trap a thread overflowing its stack.

config KERNEL_STACK_GUARD
	bool "Trap stack overflows"
	default y
	depends on ARCH_HAS_STACK_GUARD
	help
	  Fault as soon as a thread or the ISR stack overflows, instead of
	  corrupting the memory below it. Uses the stack limit registers where
	  the core has them, and otherwise a no-access MPU region below each
	  stack.

config KERNEL_STACK_GUARD_SIZE
	int
	default 128 if KERNEL_STACK_GUARD && !CPU_CORTEX_M_HAS_SPLIM
	default 0
	help
	  Bytes reserved below a stack for its MPU guard, on top of the size the
	  stack is defined with. An exception frame with FP state takes 104 bytes
	  and lazy stacking only writes its lowest 32, so a smaller guard can be
	  skipped without a fault.

config KERNEL_USER_STACK_GUARD_SIZE
	int
	default 32 if KERNEL_STACK_GUARD && !CPU_CORTEX_M_HAS_SPLIM
	default 0
	help
	  MPU guard of a stack only used unprivileged, see
	  pbl_thread_attr::user_stack. Frames that skip it still fault, as they
	  land in memory the thread can't write.

config KERNEL_MPU_REGIONS
	int
	default 12 if SOC_SF32LB52
	default 8
	help
	  MPU slots the core implements. The last four switch with the thread, and
	  the rest take the static regions.

config KERNEL_MPU_IN_FAULTS
	bool
	help
	  Keep the MPU on in the HardFault and NMI handlers.

config KERNEL_TICK_HZ
	int "Tick rate in Hz"
	default 1000 if QEMU || SOC_SF32LB52 || SOC_POSIX
	default 1024

config KERNEL_IRQ_PRIO_KERNEL
	int "NVIC priority of the kernel's interrupts"
	default 255

config KERNEL_IRQ_PRIO_MAX_SYSCALL
	int "Highest NVIC priority allowed to call into the kernel"
	default 191

config NUM_IRQS
	int
	range 1 512
	help
	  Number of SoC interrupt lines, i.e. vector table entries past the
	  core exceptions. Defaulted per SoC in soc/*/Kconfig.defconfig.

config NUM_IRQ_PRIO_BITS
	int
	depends on CPU_CORTEX_M
	range 1 8
	help
	  Number of priority bits implemented by the interrupt controller.
	  Defaulted per SoC in soc/*/Kconfig.defconfig.

config KERNEL_NUM_PRIORITIES
	int "Number of thread priorities"
	default 5

config KERNEL_MAX_THREADS
	int "Maximum number of threads alive at once"
	default 12

config KERNEL_THREAD_TLS_SLOTS
	int "Per-thread pointer slots"
	default 2

config KERNEL_STACK_ALIGN
	int "Thread stack alignment"
	default 128 if KERNEL_STACK_GUARD && !CPU_CORTEX_M_HAS_SPLIM
	default 32
	help
	  Must be a multiple of the stack guard size, which an MPU region can
	  only cover when naturally aligned.

config KERNEL_MUTEX_LOCK_LR
	bool "Record the caller of the outermost mutex lock"
	default y

config ARCH_HAS_DEBUGGER_DETECT
	bool
	help
	  The architecture can tell whether a debugger is attached.

config ARCH_HAS_USERSPACE
	bool
	help
	  The architecture can run threads unprivileged and take syscalls
	  from them.

config USERSPACE
	bool "Unprivileged threads and syscalls"
	default y
	depends on ARCH_HAS_USERSPACE
	help
	  Let threads run unprivileged, confined by the MPU, and enter
	  privileged code only through syscalls, which check every argument
	  they are handed. Without it every thread runs privileged and
	  syscalls are plain calls.

config RAMFUNC
	bool
	help
	  Code and read-only data can be placed in RAM: the .ramfunc
	  section is loaded from flash and copied to RAM at boot. Selected
	  by SoCs that need code to run while flash is unavailable.

endmenu

rsource "arch/arm/Kconfig"
rsource "arch/posix/Kconfig"
