menu "Kernel"

config KERNEL_IDLE_STACK_SIZE
	int "Idle thread stack size in bytes"
	default 1024

config KERNEL_TICK_HZ
	int "Tick rate in Hz"
	default 1000 if QEMU || SOC_SF32LB52
	default 1024

config KERNEL_IRQ_PRIO_KERNEL
	int "NVIC priority of the kernel's interrupts"
	default 255

config KERNEL_IRQ_PRIO_MAX_SYSCALL
	int "Highest NVIC priority allowed to call into the kernel"
	default 191

config NUM_IRQS
	int
	range 1 512
	help
	  Number of SoC interrupt lines, i.e. vector table entries past the
	  core exceptions. Defaulted per SoC in soc/*/Kconfig.defconfig.

config KERNEL_NUM_PRIORITIES
	int "Number of thread priorities"
	default 5

config KERNEL_MAX_THREADS
	int "Maximum number of threads alive at once"
	default 12

config KERNEL_THREAD_TLS_SLOTS
	int "Per-thread pointer slots"
	default 2

config KERNEL_STACK_ALIGN
	int "Thread stack alignment"
	default 32 if MPU_TYPE_ARMV8M
	default 256
	help
	  Alignment that lets the bottom of a stack be covered by an MPU
	  guard region on the target core.

config KERNEL_MUTEX_LOCK_LR
	bool "Record the caller of the outermost mutex lock"
	default y

config RAMFUNC
	bool
	help
	  Code and read-only data can be placed in RAM: the .ramfunc
	  section is loaded from flash and copied to RAM at boot. Selected
	  by SoCs that need code to run while flash is unavailable.

config EXTRAM
	bool
	help
	  External RAM is available: zero-initialized data marked
	  PBL_SECTION_EXTRAM is placed there. Selected by SoCs, which must
	  bring the memory up in pbl_soc_early_init(); the kernel zeroes it
	  right after.

config EXTRAM_BASE
	hex
	depends on EXTRAM
	help
	  Base address of the external RAM. Defaulted per SoC in
	  soc/*/Kconfig.defconfig.

config EXTRAM_SIZE
	hex
	depends on EXTRAM
	help
	  Size of the external RAM. Defaulted per SoC in
	  soc/*/Kconfig.defconfig.

endmenu

rsource "arch/arm/Kconfig"
