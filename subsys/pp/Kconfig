menuconfig PP
    bool "Pebble protocol"
    select KERNEL_SYS_WORKQ
    help
      Pebble protocol sessions with phone apps: endpoints, send queues
      and the transports that carry them.

if PP

module = PP
module-str = Pebble protocol
source "subsys/logging/Kconfig.template.log_level"

config PP_TRANSPORT_GATT
    bool "PPoGATT"
    depends on NIMBLE
    select BT_GATT_CLIENT
    select KERNEL_SYS_WORKQ
    select KERNEL_SYS_WORKQ_HIGH
    help
      Pebble protocol over GATT (PPoGATT), the transport phones use.

config PP_TRANSPORT_GATT_REVERSED
    bool "Reversed PPoGATT service"
    depends on PP_TRANSPORT_GATT
    select BT_GATT_SERVER
    help
      PPoGATT service hosted by the device, for phones whose GATT server
      API is broken: the phone is the client. It is added with the other
      GATT services of the device (pbl/bluetooth/gatts.h).

config PP_TRANSPORT_CONSOLE
    bool "Console frames"
    depends on CONSOLE
    select CONSOLE_INPUT
    select KERNEL_SYS_WORKQ_HIGH
    help
      Pebble protocol over serial console frames, for development tools.

config PP_TRANSPORT_USB
    bool "USB"
    depends on USB_DEVICE
    select KERNEL_SYS_WORKQ
    select KERNEL_SYS_WORKQ_HIGH
    help
      Pebble protocol over USB, for development tools: a function of the
      USB device, with a vendor-specific interface and two bulk endpoints
      (pbl/pp/transports/usb.h).

endif
