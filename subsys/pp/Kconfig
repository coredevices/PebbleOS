menuconfig PP
    bool "Pebble protocol"
    help
      Pebble protocol sessions with phone apps: endpoints, send queues
      and the transports that carry them.

if PP

module = PP
module-str = Pebble protocol
source "subsys/logging/Kconfig.template.log_level"

config PP_TRANSPORT_GATT
    bool
    default y
    depends on BT
    help
      Pebble protocol over GATT (PPoGATT), the transport phones use.

config PP_TRANSPORT_CONSOLE
    bool
    default y
    depends on CONSOLE
    help
      Pebble protocol over serial console frames, for development tools.

config PP_TRANSPORT_QEMU
    bool
    default y
    depends on QEMU_SERIAL
    help
      Pebble protocol over the emulator's serial link.

endif
