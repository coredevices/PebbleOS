menu "Logging"

config LOG
    bool "Logging"
    default y
    help
      Build the PBL_LOG macros. Disable to save space.

config LOG_HASHED
    bool "Hashed logs"
    default y
    depends on LOG && !QEMU
    help
      Replace log format strings with hashes to save space. Disable
      for human-readable logs.

choice
    prompt "Default log level"
    default DEFAULT_LOG_LEVEL_INFO

config DEFAULT_LOG_LEVEL_ERROR
    bool "Error"

config DEFAULT_LOG_LEVEL_WARNING
    bool "Warning"

config DEFAULT_LOG_LEVEL_INFO
    bool "Info"

config DEFAULT_LOG_LEVEL_DEBUG
    bool "Debug"

config DEFAULT_LOG_LEVEL_DEBUG_VERBOSE
    bool "Debug verbose"

endchoice

config DEFAULT_LOG_LEVEL
    int
    default 1 if DEFAULT_LOG_LEVEL_ERROR
    default 50 if DEFAULT_LOG_LEVEL_WARNING
    default 100 if DEFAULT_LOG_LEVEL_INFO
    default 200 if DEFAULT_LOG_LEVEL_DEBUG
    default 255 if DEFAULT_LOG_LEVEL_DEBUG_VERBOSE

config LOG_TASK_PREFIX
    bool "Task prefix"
    depends on LOG
    help
      Prefix log messages with the originating task identifier char
      (uppercase when logged from privileged mode).

config LOG_BOOT_BUFFER_SIZE
    int "Boot buffer size"
    default 512
    help
      Messages that a disabled backend would write are kept in a buffer
      of this many bytes, until it is full, and replayed to the backends
      started with pbl_log_backend_start(), e.g. the flash backend, so
      their log begins with the boot banner. 0 disables it.

rsource "backends/Kconfig"

endmenu
