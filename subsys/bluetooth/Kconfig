menu "Bluetooth"

config BT
    bool "Bluetooth"
    select BTUTIL
    select BT_GATT_CLIENT
    select NIMBLE
    select NIMBLE_STORE_CONFIG
    select TASK_WDT
    help
      The Bluetooth subsystem: the pbl_bt API, implemented on the NimBLE
      host.

if BT

config BT_VENDOR_ID
    hex "Vendor ID"
    default 0x0EEA
    help
      Company identifier in the manufacturer data of advertisements.

config BT_VENDOR_NAME
    string "Vendor name"
    default "Core Devices LLC"
    help
      Manufacturer name in the Device Information Service.

module = BT
module-str = Bluetooth
source "subsys/logging/Kconfig.template.log_level"

config BT_REPEAT_PAIRING_ALWAYS
    bool "Always accept repeat pairing"
    help
      Forget the keys of a bonded peer that pairs again and accept it, even
      without secure connections and user confirmation. For firmware with
      no other way to forget a pairing.

rsource "services/Kconfig"

endif

rsource "clients/Kconfig"

endmenu
