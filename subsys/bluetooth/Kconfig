menu "Bluetooth"

config BT
    bool "Bluetooth"
    select BTUTIL
    select NIMBLE
    select TASK_WDT
    help
      The Bluetooth subsystem: the pbl_bt API, implemented on the NimBLE
      host.

if BT

config BT_VENDOR_ID
    hex "Vendor ID"
    default 0x0EEA
    help
      Company identifier in the manufacturer data of advertisements.

config BT_VENDOR_NAME
    string "Vendor name"
    default "Core Devices LLC"
    help
      Manufacturer name in the Device Information Service.

choice BT_ID_ADDR_SOURCE
    prompt "Identity address"
    default BT_ID_ADDR_CONTROLLER
    help
      Where the watch's Bluetooth identity address comes from. The default
      is derived from the SoC (see each soc/<soc>/Kconfig.defconfig).

config BT_ID_ADDR_CONTROLLER
    bool "Controller"
    help
      Use the address the controller reports, or let NimBLE pick one.

config BT_ID_ADDR_SF32LB52_EFUSE
    bool "SF32LB52 eFUSE"
    depends on SOC_SF32LB52 && NVMEM_SF32LB
    select BT_ID_ADDR
    help
      Public address derived from the unique ID in the SoC's eFUSE.

config BT_ID_ADDR_STORAGE
    bool "Stored random static address"
    depends on SERVICE_SHARED_PRF_STORAGE
    select BT_ID_ADDR
    help
      Generate a random static address once and keep it in shared PRF
      storage, for controllers without an address of their own.

endchoice

config BT_ID_ADDR
    bool
    help
      An identity address backend is selected (pbl/bluetooth/id_addr.h).

module = BT
module-str = Bluetooth
source "subsys/logging/Kconfig.template.log_level"

config BT_REPEAT_PAIRING_ALWAYS
    bool "Always accept repeat pairing"
    help
      Forget the keys of a bonded peer that pairs again and accept it, even
      without secure connections and user confirmation. For firmware with
      no other way to forget a pairing.

config BT_HRM_SERVICE
    bool
    help
      The backend implements the Heart Rate Service
      (pbl/bluetooth/hrm_service.h).

rsource "services/Kconfig"

endif

endmenu
