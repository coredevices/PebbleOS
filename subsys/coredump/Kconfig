menu "Core dumps"

config COREDUMP
    bool "Core dumps"
    depends on ARCH_HAS_COREDUMP
    help
      Save the state of the system when it crashes, for analysis after
      the reset.

if COREDUMP

config COREDUMP_STACK_SIZE
    int "Stack size of the dump in bytes"
    default 1024
    help
      Stack the dump is written on, its own so that it depends neither on
      what the code that crashed left of its stack nor overwrites it. The
      backends and the drivers they write through run on it.

config COREDUMP_TEST_FAULT
    bool
    help
      Let tests inject a fault while a dump is being written.

rsource "backends/Kconfig"

endif

endmenu
