menu "Core dumps"

config COREDUMP
    bool "Core dumps"
    depends on ARCH_HAS_COREDUMP
    help
      Save the state of the system when it crashes, for analysis after
      the reset.

if COREDUMP

config COREDUMP_TEST_FAULT
    bool
    help
      Let tests inject a fault while a dump is being written.

rsource "backends/Kconfig"

endif

endmenu
