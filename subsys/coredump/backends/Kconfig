config COREDUMP_BACKEND_FLASH
    bool "Flash backend"
    default y
    depends on FLASH
    help
      Keep dumps in flash until they are read back, in the core dump
      partition or, without one, in the firmware update slot.

config COREDUMP_BACKEND_FLASH_IMAGES
    int "Dumps to keep"
    default 2 if SOC_NRF52
    default 1
    range 1 32
    depends on COREDUMP_BACKEND_FLASH
    help
      The storage is divided evenly between this many dumps, the oldest
      being replaced.
