menuconfig USB_DEVICE
    bool "USB device"
    select UDC
    help
      The device side of USB (pbl/usb/usbd.h), on the board's USB device
      controller, its udc role.

if USB_DEVICE

config USB_DEVICE_VID
    hex "Vendor ID"
    default 0x1209
    help
      The vendor ID of the device. The default, that of pid.codes, is for
      tests.

config USB_DEVICE_PID
    hex "Product ID"
    default 0x0001
    help
      The product ID of the device. The default is the test product ID of
      pid.codes.

config USB_DEVICE_MANUFACTURER
    string "Manufacturer"
    default "PebbleOS"

config USB_DEVICE_PRODUCT
    string "Product"
    default "PebbleOS device"

config USB_CDC_ACM
    bool "Serial port"
    select UART
    help
      A serial port over USB, CDC ACM, as a UART (pbl/usb/cdc_acm.h).

config USB_DFU
    bool "Firmware upgrade"
    depends on FLASH
    help
      Device Firmware Upgrade 1.1, in DFU mode (pbl/usb/dfu.h): the host
      downloads an image to a flash partition and uploads it back.

config USB_DFU_TRANSFER_SIZE
    int "Transfer size"
    depends on USB_DFU
    default 2048
    range 64 4096
    help
      Largest block of a download or an upload, in bytes. The function
      keeps three blocks: the one it writes and two to upload from.

endif # USB_DEVICE
