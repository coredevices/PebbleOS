/dts-v1/;

#include "nordic/nrf52840-qiaa.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/input/ti-drv260x.h>

/ {
	model = "Core Devices Pebble 2 Duo";

	compatible = "coredevices,asterix", "nordic,nrf52840";

	lfxo: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	battery: battery {
		compatible = "simple-battery";
		constant-charge-current-max-microamp = <128000>;
		charge-term-current-microamp = <12800>;
		constant-charge-voltage-max-microvolt = <4200000>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 3906250 0>;
		enable-gpios = <&gpio1 8 0>;
	};

	buttons: gpio-keys {
		compatible = "gpio-keys";

		button-back {
			label = "Back";
			gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_BACK>;
			debounce-interval = <40>;
		};

		button-up {
			label = "Up";
			gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_UP>;
			debounce-interval = <40>;
		};

		button-select {
			label = "Select";
			gpios = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_SELECT>;
			debounce-interval = <40>;
		};

		button-down {
			label = "Down";
			gpios = <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_DOWN>;
			debounce-interval = <40>;
		};
	};

	dmic: dmic {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
	};

	mic: sound-mic {
		compatible = "simple-audio-card";
		simple-audio-card,name = "mic";
		simple-audio-card,format = "pdm";

		simple-audio-card,cpu {
			sound-dai = <&pdm>;
		};

		simple-audio-card,codec {
			sound-dai = <&dmic>;
		};
	};

	speaker: sound-speaker {
		compatible = "simple-audio-card";
		simple-audio-card,name = "speaker";
		simple-audio-card,format = "i2s";
		simple-audio-card,bitclock-master = <&speaker_codec>;
		simple-audio-card,frame-master = <&speaker_codec>;

		simple-audio-card,cpu {
			sound-dai = <&i2s>;
		};

		speaker_codec: simple-audio-card,codec {
			sound-dai = <&da7212>;
		};
	};
};

&clock {
	clocks = <&hfxo>, <&lfxo>;
	clock-names = "hfxo", "lfxo";
};

&i2c0 {
	clock-frequency = <400000>;
	scl-gpios = <&gpio0 25 GPIO_PULL_UP>;
	sda-gpios = <&gpio0 11 GPIO_PULL_UP>;
	status = "okay";

	lsm6dso: imu@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		interrupt-parent = <&gpio1>;
		interrupts = <13 IRQ_TYPE_EDGE_RISING>;
		mount-matrix = "0", "1", "0",
			       "1", "0", "0",
			       "0", "0", "1";
	};

	drv2604: haptics@5a {
		compatible = "ti,drv2604";
		reg = <0x5a>;
		enable-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		mode = <DRV260X_LRA_MODE>;
		library-sel = <DRV260X_LIB_LRA>;
	};

	opt3001: light-sensor@44 {
		compatible = "ti,opt3001";
		reg = <0x44>;
	};

	da7212: audio-codec@1a {
		compatible = "dlg,da7212";
		reg = <0x1a>;
		#sound-dai-cells = <0>;
		VDDA-supply = <&ldsw1>;
	};

	mmc5603nj: magnetometer@30 {
		compatible = "memsic,mmc5603";
		reg = <0x30>;
		mount-matrix = "0", "1", "0",
			       "-1", "0", "0",
			       "0", "0", "1";
	};
};

&i2c1 {
	clock-frequency = <400000>;
	scl-gpios = <&gpio0 14 GPIO_PULL_UP>;
	sda-gpios = <&gpio0 15 GPIO_PULL_UP>;
	status = "okay";

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		interrupt-parent = <&gpio1>;
		interrupts = <12 IRQ_TYPE_EDGE_RISING>;
		gpio-controller;
		#gpio-cells = <2>;
		monitored-battery = <&battery>;
		nordic,reduced-charge-voltage-microvolt = <4000000>;
		nordic,thermistor-ohms = <10000>;
		nordic,thermistor-beta = <3380>;
		nordic,thermistor-hot-celsius = <45>;
		nordic,discharge-current-limit-microamp = <200000>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "npm1300_buck1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			buck2: BUCK2 {
				regulator-name = "npm1300_buck2";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
			};

			ldsw1: LDSW1 {
				regulator-name = "npm1300_ldsw1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				nordic,ldo-mode;
			};

			ldsw2: LDSW2 {
				regulator-name = "npm1300_ldsw2";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				nordic,ldo-mode;
			};
		};
	};
};

&qspi {
	sck-gpios = <&gpio0 19 0>;
	cs-gpios = <&gpio0 17 0>;
	io-gpios = <&gpio0 20 0>, <&gpio0 21 0>, <&gpio0 22 0>, <&gpio0 23 0>;
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <8000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "safe-firmware";
				reg = <0x0 0x80000>;
			};

			partition@ff000 {
				label = "mfg-info";
				reg = <0xff000 0x1000>;
			};

			partition@100000 {
				label = "firmware-slot-1";
				reg = <0x100000 0x100000>;
			};

			partition@200000 {
				label = "system-resources-bank-0";
				reg = <0x200000 0x100000>;
			};

			partition@300000 {
				label = "system-resources-bank-1";
				reg = <0x300000 0x100000>;
			};

			partition@400000 {
				label = "filesystem";
				reg = <0x400000 0x19d0000>;
			};

			partition@1fd0000 {
				label = "debug-db";
				reg = <0x1fd0000 0x20000>;
			};

			partition@1ffd000 {
				label = "mfg-results";
				reg = <0x1ffd000 0x1000>;
			};

			partition@1ffe000 {
				label = "mfg-battery-state";
				reg = <0x1ffe000 0x1000>;
			};

			partition@1fff000 {
				label = "shared-prf-storage";
				reg = <0x1fff000 0x1000>;
			};
		};

		otp {
			compatible = "user-otp";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				hw-version@0 {
					reg = <0x0 0x20>;
				};

				serial-number@20 {
					reg = <0x20 0x20>;
				};

				pcba-serial-number@40 {
					reg = <0x40 0x20>;
				};
			};
		};
	};
};

&uart0 {
	current-speed = <1000000>;
	tx-gpios = <&gpio0 27 0>;
	rx-gpios = <&gpio0 5 0>;
	nordic,timer = <&timer2>;
	status = "okay";
};

&rtc2 {
	status = "okay";
};

&rtc2_pwm {
	gpios = <&gpio1 15 0>;
	status = "okay";
};

&spi3 {
	sck-gpios = <&gpio0 6 0>;
	mosi-gpios = <&gpio0 8 0>;
	cs-gpios = <&gpio1 3 0>;
	status = "okay";

	display: display@0 {
		compatible = "sharp,ls013b7dh01";
		reg = <0>;
		spi-max-frequency = <1000000>;
		spi-cs-high;
		spi-lsb-first;
		enable-gpios = <&gpio0 4 0>;
		sharp,vcom-mode = "pwm";
		pwms = <&rtc2_pwm 0 8333333 0>;
	};
};

&pwm0 {
	out-gpios = <&gpio0 26 0>;
	status = "okay";
};

&pdm {
	clk-gpios = <&gpio1 0 0>;
	din-gpios = <&gpio0 24 0>;
	status = "okay";
};

&i2s {
	sck-gpios = <&gpio0 12 0>;
	lrck-gpios = <&gpio0 7 0>;
	mck-gpios = <&gpio1 9 0>;
	sdout-gpios = <&gpio0 13 0>;
	status = "okay";
};
