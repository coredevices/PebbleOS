/dts-v1/;

#include "st/stm32h747xi.dtsi"
#include "stm32h747i_disco-pinctrl.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "STMicroelectronics STM32H747I-DISCO";
	compatible = "st,stm32h747i-disco", "st,stm32h747";

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		// The framebuffer, at the start of the SDRAM
		fb_mem: framebuffer@70000000 {
			reg = <0x70000000 0xbb800>;
			no-map;
		};
	};

	// What the LTDC scans to the panel, landscape, which the panel takes turned a quarter turn
	framebuffer {
		compatible = "simple-framebuffer";
		memory-region = <&fb_mem>;
		width = <800>;
		height = <480>;
		stride = <1600>;
		format = "r5g6b5";
		display = <&ltdc>;
	};

	// The joystick, as the four buttons of a watch
	buttons: gpio-keys {
		compatible = "gpio-keys";

		button-back {
			label = "JoyLeft";
			gpios = <&gpiok 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_BACK>;
		};

		button-up {
			label = "JoyUp";
			gpios = <&gpiok 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_UP>;
		};

		button-select {
			label = "JoySel";
			gpios = <&gpiok 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_SELECT>;
		};

		button-down {
			label = "JoyDown";
			gpios = <&gpiok 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_DOWN>;
		};

		// On a wakeup pin, it starts the kit again from power-off
		button-wakeup {
			label = "Wakeup";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_WAKEUP>;
			wakeup-source;
		};
	};

	// The supplies of the audio codec, from the kit's regulators
	v1v8: regulator-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "v1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	v3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "v3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	// The headphone output of the codec, on the audio jack
	speaker: sound-speaker {
		compatible = "simple-audio-card";
		simple-audio-card,name = "speaker";
		simple-audio-card,format = "i2s";

		simple-audio-card,cpu {
			sound-dai = <&sai1a>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_green: led-green {
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpioi 12 GPIO_ACTIVE_LOW>;
		};

		led_orange: led-orange {
			color = <LED_COLOR_ID_ORANGE>;
			gpios = <&gpioi 13 GPIO_ACTIVE_LOW>;
		};

		led_red: led-red {
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpioi 14 GPIO_ACTIVE_LOW>;
		};

		led_blue: led-blue {
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpioi 15 GPIO_ACTIVE_LOW>;
		};
	};
};

&clk_hse {
	clock-frequency = <25000000>;
};

// The CPU at 400 MHz from PLL1 on HSE, AHB at 200 MHz and APB at 100 MHz
&rcc {
	assigned-clocks = <&rcc PLLSRC>, <&rcc PLL1_P>, <&rcc SYS_CK>, <&rcc HCLK>,
			  <&rcc PCLK1>, <&rcc PCLK2>, <&rcc PCLK3>, <&rcc PCLK4>, <&rcc PLL3_R>,
			  <&rcc LPTIM1_CK>, <&rcc RTC_CK>, <&rcc PLL2_P>, <&rcc SAI1_CK>;
	assigned-clock-parents = <&rcc HSE_CK>, <0>, <&rcc PLL1_P>, <0>, <0>, <0>, <0>, <0>,
				 <0>, <&rcc LSE_CK>, <&rcc LSE_CK>, <0>, <&rcc PLL2_P>;
	// PLL3 R is the pixel clock of the frames to the panel, LPTIM1 and the RTC count the LSE
	// crystal, and SAI1 divides PLL2 P to 256 times the audio rates within 0.03%
	assigned-clock-rates = <0>, <400000000>, <0>, <200000000>, <100000000>, <100000000>,
			       <100000000>, <100000000>, <42000000>, <0>, <0>, <73750000>, <0>;
};

// The SMPS supplies VCORE, as the kit ships
&pwr {
	st,supply-config = "direct-smps";
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
	dmas = <&dmamux1 41 0x400 0x10>;
	dma-names = "rx";
	status = "okay";
};

// The system timer, on the LSE, which keeps running in Stop mode
&lptimer1 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&dma2d {
	status = "okay";
};

&ltdc {
	status = "okay";

	port {
		ltdc_out_dsi: endpoint {
			remote-endpoint = <&dsi_in>;
		};
	};
};

// The 4" 480x800 panel of the MB1166 daughterboard
&dsi {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			dsi_in: endpoint {
				remote-endpoint = <&ltdc_out_dsi>;
			};
		};

		port@1 {
			reg = <1>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
				data-lanes = <1 2>;
			};
		};
	};

	panel: panel@0 {
		compatible = "orisetech,otm8009a";
		reg = <0>;
		reset-gpios = <&gpiog 3 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

// The capacitive touch controller of the MB1166 module, and the audio codec
&i2c4 {
	pinctrl-0 = <&i2c4_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	touchscreen: touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		pinctrl-0 = <&touch_default>;
		pinctrl-names = "default";
		interrupt-parent = <&gpiok>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <800>;
		// Portrait, its axes turned with the frame
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;
	};

	codec: audio-codec@1a {
		compatible = "wlf,wm8994";
		reg = <0x1a>;
		#sound-dai-cells = <0>;
		AVDD2-supply = <&v1v8>;
		CPVDD-supply = <&v1v8>;
		DBVDD-supply = <&v3v3>;
		SPKVDD1-supply = <&v3v3>;
		SPKVDD2-supply = <&v3v3>;
	};
};

// The IS42S32800J on SDRAM bank 2, swapped to where the CPU caches it
&fmc {
	pinctrl-0 = <&fmc_default>;
	pinctrl-names = "default";
	status = "okay";

	sdram: sdram@70000000 {
		compatible = "issi,is42s32800j";
		reg = <0x70000000 0x2000000>;
	};
};

// The MT25QL512ABB on bank 1 of the dual-flash pair; the one on bank 2 is not described
&qspi {
	pinctrl-0 = <&qspi_default>;
	pinctrl-names = "default";
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
	};
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&rtc {
	status = "okay";
};

&sai1 {
	status = "okay";
};

// The master of the link to the codec
&sai1a {
	pinctrl-0 = <&sai1a_default>;
	pinctrl-names = "default";
	dma-names = "tx";
	status = "okay";
};

&internal_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		// Bank 1, where the Cortex-M7 boots from
		partition@0 {
			label = "code";
			reg = <0x0 0x100000>;
		};
	};
};
