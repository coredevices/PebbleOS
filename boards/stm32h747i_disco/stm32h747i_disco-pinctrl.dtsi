&pinctrl {
	// ST-LINK virtual COM port
	// The ULPI to the USB3320: CK, D0 to D7, STP, NXT and DIR
	usbotg_hs_ulpi: usbotg-hs-ulpi-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 5, AF10)>, /* ULPI_CK */
				 <STM32_PINMUX('A', 3, AF10)>, /* ULPI_D0 */
				 <STM32_PINMUX('B', 0, AF10)>, /* ULPI_D1 */
				 <STM32_PINMUX('B', 1, AF10)>, /* ULPI_D2 */
				 <STM32_PINMUX('B', 10, AF10)>, /* ULPI_D3 */
				 <STM32_PINMUX('B', 11, AF10)>, /* ULPI_D4 */
				 <STM32_PINMUX('B', 12, AF10)>, /* ULPI_D5 */
				 <STM32_PINMUX('B', 13, AF10)>, /* ULPI_D6 */
				 <STM32_PINMUX('B', 5, AF10)>, /* ULPI_D7 */
				 <STM32_PINMUX('C', 0, AF10)>, /* ULPI_STP */
				 <STM32_PINMUX('H', 4, AF10)>, /* ULPI_NXT */
				 <STM32_PINMUX('I', 11, AF10)>; /* ULPI_DIR */
			bias-disable;
			drive-push-pull;
			slew-rate = <3>;
		};
	};

	uart8_default: uart8-0 {
		pins1 {
			pinmux = <STM32_PINMUX('J', 8, AF8)>; /* UART8_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('J', 9, AF8)>; /* UART8_RX */
			bias-pull-up;
		};
	};

	usart1_default: usart1-0 {
		pins1 {
			pinmux = <STM32_PINMUX('A', 9, AF7)>; /* USART1_TX */
			bias-disable;
			drive-push-pull;
			slew-rate = <0>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('A', 10, AF7)>; /* USART1_RX */
			bias-pull-up;
		};
	};

	// The SDRAM on bank 2 of the FMC
	fmc_default: fmc-0 {
		pins1 {
			pinmux = <STM32_PINMUX('F', 0, AF12)>, /* FMC_A0 */
				 <STM32_PINMUX('F', 1, AF12)>, /* FMC_A1 */
				 <STM32_PINMUX('F', 2, AF12)>, /* FMC_A2 */
				 <STM32_PINMUX('F', 3, AF12)>, /* FMC_A3 */
				 <STM32_PINMUX('F', 4, AF12)>, /* FMC_A4 */
				 <STM32_PINMUX('F', 5, AF12)>, /* FMC_A5 */
				 <STM32_PINMUX('F', 12, AF12)>, /* FMC_A6 */
				 <STM32_PINMUX('F', 13, AF12)>, /* FMC_A7 */
				 <STM32_PINMUX('F', 14, AF12)>, /* FMC_A8 */
				 <STM32_PINMUX('F', 15, AF12)>, /* FMC_A9 */
				 <STM32_PINMUX('G', 0, AF12)>, /* FMC_A10 */
				 <STM32_PINMUX('G', 1, AF12)>, /* FMC_A11 */
				 <STM32_PINMUX('G', 4, AF12)>, /* FMC_BA0 */
				 <STM32_PINMUX('G', 5, AF12)>, /* FMC_BA1 */
				 <STM32_PINMUX('D', 14, AF12)>, /* FMC_D0 */
				 <STM32_PINMUX('D', 15, AF12)>, /* FMC_D1 */
				 <STM32_PINMUX('D', 0, AF12)>, /* FMC_D2 */
				 <STM32_PINMUX('D', 1, AF12)>, /* FMC_D3 */
				 <STM32_PINMUX('E', 7, AF12)>, /* FMC_D4 */
				 <STM32_PINMUX('E', 8, AF12)>, /* FMC_D5 */
				 <STM32_PINMUX('E', 9, AF12)>, /* FMC_D6 */
				 <STM32_PINMUX('E', 10, AF12)>, /* FMC_D7 */
				 <STM32_PINMUX('E', 11, AF12)>, /* FMC_D8 */
				 <STM32_PINMUX('E', 12, AF12)>, /* FMC_D9 */
				 <STM32_PINMUX('E', 13, AF12)>, /* FMC_D10 */
				 <STM32_PINMUX('E', 14, AF12)>, /* FMC_D11 */
				 <STM32_PINMUX('E', 15, AF12)>, /* FMC_D12 */
				 <STM32_PINMUX('D', 8, AF12)>, /* FMC_D13 */
				 <STM32_PINMUX('D', 9, AF12)>, /* FMC_D14 */
				 <STM32_PINMUX('D', 10, AF12)>, /* FMC_D15 */
				 <STM32_PINMUX('H', 8, AF12)>, /* FMC_D16 */
				 <STM32_PINMUX('H', 9, AF12)>, /* FMC_D17 */
				 <STM32_PINMUX('H', 10, AF12)>, /* FMC_D18 */
				 <STM32_PINMUX('H', 11, AF12)>, /* FMC_D19 */
				 <STM32_PINMUX('H', 12, AF12)>, /* FMC_D20 */
				 <STM32_PINMUX('H', 13, AF12)>, /* FMC_D21 */
				 <STM32_PINMUX('H', 14, AF12)>, /* FMC_D22 */
				 <STM32_PINMUX('H', 15, AF12)>, /* FMC_D23 */
				 <STM32_PINMUX('I', 0, AF12)>, /* FMC_D24 */
				 <STM32_PINMUX('I', 1, AF12)>, /* FMC_D25 */
				 <STM32_PINMUX('I', 2, AF12)>, /* FMC_D26 */
				 <STM32_PINMUX('I', 3, AF12)>, /* FMC_D27 */
				 <STM32_PINMUX('I', 6, AF12)>, /* FMC_D28 */
				 <STM32_PINMUX('I', 7, AF12)>, /* FMC_D29 */
				 <STM32_PINMUX('I', 9, AF12)>, /* FMC_D30 */
				 <STM32_PINMUX('I', 10, AF12)>, /* FMC_D31 */
				 <STM32_PINMUX('E', 0, AF12)>, /* FMC_NBL0 */
				 <STM32_PINMUX('E', 1, AF12)>, /* FMC_NBL1 */
				 <STM32_PINMUX('I', 4, AF12)>, /* FMC_NBL2 */
				 <STM32_PINMUX('I', 5, AF12)>, /* FMC_NBL3 */
				 <STM32_PINMUX('G', 8, AF12)>, /* FMC_SDCLK */
				 <STM32_PINMUX('H', 5, AF12)>, /* FMC_SDNWE */
				 <STM32_PINMUX('F', 11, AF12)>, /* FMC_SDNRAS */
				 <STM32_PINMUX('G', 15, AF12)>, /* FMC_SDNCAS */
				 <STM32_PINMUX('H', 7, AF12)>, /* FMC_SDCKE1 */
				 <STM32_PINMUX('H', 6, AF12)>; /* FMC_SDNE1 */
			bias-disable;
			drive-push-pull;
			slew-rate = <3>;
		};
	};

	// Bank 1 of the dual quad-SPI NOR flash
	qspi_default: qspi-0 {
		pins1 {
			pinmux = <STM32_PINMUX('B', 2, AF9)>, /* QUADSPI_CLK */
				 <STM32_PINMUX('D', 11, AF9)>, /* QUADSPI_BK1_IO0 */
				 <STM32_PINMUX('F', 9, AF10)>, /* QUADSPI_BK1_IO1 */
				 <STM32_PINMUX('F', 7, AF9)>, /* QUADSPI_BK1_IO2 */
				 <STM32_PINMUX('F', 6, AF9)>, /* QUADSPI_BK1_IO3 */
				 <STM32_PINMUX('H', 2, AF9)>, /* QUADSPI_BK2_IO0 */
				 <STM32_PINMUX('H', 3, AF9)>, /* QUADSPI_BK2_IO1 */
				 <STM32_PINMUX('G', 9, AF9)>, /* QUADSPI_BK2_IO2 */
				 <STM32_PINMUX('G', 14, AF9)>; /* QUADSPI_BK2_IO3 */
			bias-disable;
			drive-push-pull;
			slew-rate = <3>;
		};

		pins2 {
			pinmux = <STM32_PINMUX('G', 6, AF10)>; /* QUADSPI_BK1_NCS */
			bias-pull-up;
			drive-push-pull;
			slew-rate = <3>;
		};
	};

	i2c4_default: i2c4-0 {
		pins {
			pinmux = <STM32_PINMUX('D', 12, AF4)>, /* I2C4_SCL */
				 <STM32_PINMUX('D', 13, AF4)>; /* I2C4_SDA */
			bias-disable;
			drive-open-drain;
			slew-rate = <0>;
		};
	};

	sai1a_default: sai1a-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 4, AF6)>, /* SAI1_FS_A */
				 <STM32_PINMUX('E', 5, AF6)>, /* SAI1_SCK_A */
				 <STM32_PINMUX('E', 6, AF6)>, /* SAI1_SD_A */
				 <STM32_PINMUX('G', 7, AF6)>; /* SAI1_MCLK_A */
			bias-disable;
			drive-push-pull;
			slew-rate = <1>;
		};
	};

	sai4a_pdm: sai4a-pdm-0 {
		pins {
			pinmux = <STM32_PINMUX('E', 2, AF10)>, /* SAI4_CK1 */
				 <STM32_PINMUX('C', 1, AF10)>; /* SAI4_D1 */
			bias-disable;
			drive-push-pull;
			slew-rate = <1>;
		};
	};

	touch_default: touch-0 {
		pins {
			pinmux = <STM32_PINMUX('K', 7, GPIO)>; /* CTP_INT */
			bias-pull-up;
		};
	};
};
