/dts-v1/;

// The kit as the Cortex-M7 runs it: the clocks, USART1 for its console, LPTIM1 to count time, and
// the Cortex-M4, which it starts

#include "st/stm32h747xi_m7.dtsi"
#include "stm32h747i_disco.dtsi"

/ {
	// The USB3320 on the ULPI of the USB OTG HS, clocked by its own 24 MHz crystal
	usbotg_hs_phy: usb-phy {
		compatible = "usb-nop-xceiv";
		#phy-cells = <0>;
		clocks = <&rcc USB1ULPI_CK>;
		clock-names = "main_clk";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		// The framebuffer, at the start of the SDRAM
		fb_mem: framebuffer@70000000 {
			reg = <0x70000000 0xbb800>;
			no-map;
		};

		// The raw ring of the microphones, in the SRAM4, the only RAM the BDMA reaches
		mic_ring: mic-ring@38000000 {
			reg = <0x38000000 0x1000>;
			no-map;
		};
	};

	// What the LTDC sends to the panel, landscape: the panel is turned a quarter turn
	framebuffer {
		compatible = "simple-framebuffer";
		memory-region = <&fb_mem>;
		width = <800>;
		height = <480>;
		stride = <1600>;
		format = "r5g6b5";
		display = <&ltdc>;
	};

	// The headphone output of the codec, on the audio jack
	speaker: sound-speaker {
		compatible = "simple-audio-card";
		simple-audio-card,name = "speaker";
		simple-audio-card,format = "i2s";

		simple-audio-card,cpu {
			sound-dai = <&sai1a>;
		};

		simple-audio-card,codec {
			sound-dai = <&codec>;
		};
	};

	// The pair of digital microphones, on the PDM interface of SAI4
	dmic: dmic {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
	};

	mic: sound-mic {
		compatible = "simple-audio-card";
		simple-audio-card,name = "mic";
		simple-audio-card,format = "pdm";

		simple-audio-card,cpu {
			sound-dai = <&sai4a>;
		};

		simple-audio-card,codec {
			sound-dai = <&dmic>;
		};
	};

	// The joystick, as the four buttons of a watch
	buttons: gpio-keys {
		compatible = "gpio-keys";

		button-back {
			label = "JoyLeft";
			gpios = <&gpiok 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_BACK>;
		};

		button-up {
			label = "JoyUp";
			gpios = <&gpiok 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_UP>;
		};

		button-select {
			label = "JoySel";
			gpios = <&gpiok 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_SELECT>;
		};

		button-down {
			label = "JoyDown";
			gpios = <&gpiok 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_DOWN>;
		};

		button-right {
			label = "JoyRight";
			gpios = <&gpiok 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_RIGHT>;
		};

		// On a wakeup pin, it starts the kit again from power-off
		button-wakeup {
			label = "Wakeup";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			linux,code = <KEY_WAKEUP>;
			wakeup-source;
		};
	};
};

&led_orange {
	status = "disabled";
};

// The CPU at 400 MHz from PLL1 on HSE, AHB at 200 MHz and APB at 100 MHz; LPTIM1 counts the LSE
// crystal; the USB OTG HS takes its 48 MHz from HSI48
&rcc {
	assigned-clocks = <&rcc PLLSRC>, <&rcc PLL1_P>, <&rcc SYS_CK>, <&rcc HCLK>,
			  <&rcc PCLK1>, <&rcc PCLK2>, <&rcc PCLK3>, <&rcc PCLK4>,
			  <&rcc LPTIM1_CK>, <&rcc RTC_CK>, <&rcc USB1OTG_CK>, <&rcc PLL3_R>,
			  <&rcc PLL2_P>, <&rcc SAI1_CK>, <&rcc SAI4A_CK>;
	assigned-clock-parents = <&rcc HSE_CK>, <0>, <&rcc PLL1_P>, <0>, <0>, <0>, <0>, <0>,
				 <&rcc LSE_CK>, <&rcc LSE_CK>, <&rcc RC48_CK>, <0>, <0>, <&rcc PLL2_P>,
				 <&rcc PLL2_P>;
	// PLL3 R is the pixel clock of the frames to the panel; SAI1 and SAI4 divide PLL2 P to 256 and
	// 128 times the audio rates within 0.03%
	assigned-clock-rates = <0>, <400000000>, <0>, <200000000>, <100000000>, <100000000>,
			       <100000000>, <100000000>, <0>, <0>, <0>, <42000000>, <73750000>, <0>,
			       <0>;
};

&dma1 {
	status = "okay";
};

&dma2 {
	status = "okay";
};

&dmamux1 {
	status = "okay";
};

&usart1 {
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
	dmas = <&dmamux1 41 0x400 0x10>;
	dma-names = "rx";
	status = "okay";
};

// The system timer, on the LSE, which keeps running in Stop mode
&lptimer1 {
	status = "okay";

	timer {
		status = "okay";
	};
};

&m4 {
	st,auto-boot;
	status = "okay";
};

&iwdg {
	status = "okay";
};

&rng {
	status = "okay";
};

&crc {
	status = "okay";
};

// The two MT25QL512ABB, one on each bank, share the chip select: they work as one flash, each
// holding every other byte
&qspi {
	pinctrl-0 = <&qspi_default>;
	pinctrl-names = "default";
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		parallel-memories = /bits/ 64 <0x4000000 0x4000000>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
	};
};

// VREF+ is tied to the 3.3 V of VDDA
&adc_3 {
	vdda-supply = <&v3v3>;
	vref-supply = <&v3v3>;
	status = "okay";
};

&adc3 {
	status = "okay";
};

&rtc {
	status = "okay";
};

// The USB OTG HS, on its micro-AB connector, as a device
&usbotg_hs {
	dr_mode = "peripheral";
	phys = <&usbotg_hs_phy>;
	phy-names = "usb2-phy";
	usb33d-supply = <&usb33>;
	pinctrl-0 = <&usbotg_hs_ulpi>;
	pinctrl-names = "default";
	status = "okay";
};

// The IS42S32800G-6 on SDRAM bank 2, swapped to where the CPU caches it
&fmc {
	pinctrl-0 = <&fmc_default>;
	pinctrl-names = "default";
	status = "okay";

	sdram: sdram@70000000 {
		compatible = "issi,is42s32800g", "jedec,sdr-sdram";
		reg = <0x70000000 0x2000000>;
		io-width = <32>;
		banks = <4>;
		row-bits = <12>;
		col-bits = <9>;
		tRC = <60000>;
		tRAS-min = <42000>;
		tRP = <18000>;
		tRCD = <18000>;
		tWR = <12000>;
		tMRD = <12000>;
		tXSR = <70000>;
		tREF-ms = <64>;
		cas-latency-freqs = <2 100000000>, <3 166000000>;
	};
};

&dma2d {
	status = "okay";
};

&ltdc {
	status = "okay";

	port {
		ltdc_out_dsi: endpoint {
			remote-endpoint = <&dsi_in>;
		};
	};
};

// The 4" 480x800 panel of the MB1166 daughterboard, with its tearing effect on the TE pin
&dsi {
	pinctrl-0 = <&dsi_default>;
	pinctrl-names = "default";
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			dsi_in: endpoint {
				remote-endpoint = <&ltdc_out_dsi>;
			};
		};

		port@1 {
			reg = <1>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
				data-lanes = <1 2>;
			};
		};
	};

	panel: panel@0 {
		compatible = "orisetech,otm8009a";
		reg = <0>;
		reset-gpios = <&gpiog 3 GPIO_ACTIVE_LOW>;
		rotation = <270>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};
};

// The capacitive touch controller of the MB1166 module, and the audio codec
&i2c4 {
	pinctrl-0 = <&i2c4_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	touchscreen: touchscreen@38 {
		compatible = "focaltech,ft6236";
		reg = <0x38>;
		pinctrl-0 = <&touch_default>;
		pinctrl-names = "default";
		interrupt-parent = <&gpiok>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <800>;
		// Portrait, its axes turned with the frame
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;
	};

	codec: audio-codec@1a {
		compatible = "wlf,wm8994";
		reg = <0x1a>;
		#sound-dai-cells = <0>;
		AVDD2-supply = <&v1v8>;
		CPVDD-supply = <&v1v8>;
		DBVDD-supply = <&v3v3>;
		SPKVDD1-supply = <&v3v3>;
		SPKVDD2-supply = <&v3v3>;
	};
};

&sai1 {
	status = "okay";
};

// The master of the link to the codec
&sai1a {
	pinctrl-0 = <&sai1a_default>;
	pinctrl-names = "default";
	dma-names = "tx";
	status = "okay";
};

&bdma {
	status = "okay";
};

&dmamux2 {
	status = "okay";
};

&sai4 {
	status = "okay";
};

// The master of the microphones, through its PDM interface
&sai4a {
	pinctrl-0 = <&sai4a_pdm>;
	pinctrl-names = "default";
	dma-names = "rx";
	memory-region = <&mic_ring>;
	status = "okay";
};

&internal_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		// Bank 1, where the Cortex-M7 boots from
		partition@0 {
			label = "code";
			reg = <0x0 0x100000>;
		};

		// Bank 2, where the Cortex-M4 boots from, which the Cortex-M7 starts
		partition@100000 {
			label = "m4";
			reg = <0x100000 0x100000>;
		};
	};
};
