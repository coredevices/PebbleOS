#include "sf32lb/sf32lb52x/sf32lb52.dtsi"

/ {
	model = "Core Devices Pebble Round 2";

	battery: battery {
		compatible = "simple-battery";
		constant-charge-current-max-microamp = <70000>;
		charge-term-current-microamp = <7000>;
		constant-charge-voltage-max-microvolt = <4450000>;
	};
};

&pinctrl {
	i2c1_default: i2c1-default-state {
		scl-pins {
			pins = "PA32";
			function = "i2c1_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA33";
			function = "i2c1_sda";
			input-enable;
			drive-strength = <8>;
		};
	};

	i2c2_default: i2c2-default-state {
		scl-pins {
			pins = "PA11";
			function = "i2c2_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA10";
			function = "i2c2_sda";
			input-enable;
			drive-strength = <8>;
		};
	};

	i2c3_default: i2c3-default-state {
		scl-pins {
			pins = "PA31";
			function = "i2c3_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA30";
			function = "i2c3_sda";
			input-enable;
			drive-strength = <8>;
		};
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	dmas = <&dmac1 5 22 2>;
	dma-names = "rx";
	status = "okay";

	lis2dw12: accelerometer@19 {
		compatible = "st,lis2dw12";
		reg = <0x19>;
		interrupt-parent = <&gpio1>;
		interrupts = <26 IRQ_TYPE_EDGE_RISING>;
		mount-matrix = "-1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};

	mmc5603nj: magnetometer@30 {
		compatible = "memsic,mmc5603";
		reg = <0x30>;
		mount-matrix = "0", "1", "0",
			       "-1", "0", "0",
			       "0", "0", "1";
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&i2c3 {
	pinctrl-0 = <&i2c3_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		interrupt-parent = <&gpio1>;
		interrupts = <44 IRQ_TYPE_EDGE_RISING>;
		gpio-controller;
		#gpio-cells = <2>;
		monitored-battery = <&battery>;
		nordic,reduced-charge-voltage-microvolt = <4000000>;
		nordic,thermistor-ohms = <10000>;
		nordic,thermistor-beta = <3380>;
		nordic,thermistor-hot-celsius = <45>;
		nordic,discharge-current-limit-microamp = <200000>;
		input-current-limit-microamp = <500000>;
		nordic,startup-input-current-limit-microamp = <500000>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "npm1300_buck1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldsw1: LDSW1 {
				regulator-name = "npm1300_ldsw1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				nordic,ldo-mode;
			};

			ldsw2: LDSW2 {
				regulator-name = "npm1300_ldsw2";
			};
		};
	};
};

&mpi2 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "ptable";
				reg = <0x0 0x10000>;
			};

			partition@10000 {
				label = "bootloader";
				reg = <0x10000 0x10000>;
			};

			partition@20000 {
				label = "firmware-slot-0";
				reg = <0x20000 0x300000>;
			};

			partition@320000 {
				label = "firmware-slot-1";
				reg = <0x320000 0x300000>;
			};

			partition@620000 {
				label = "system-resources-bank-0";
				reg = <0x620000 0x200000>;
			};

			partition@820000 {
				label = "system-resources-bank-1";
				reg = <0x820000 0x200000>;
			};

			partition@a20000 {
				label = "safe-firmware";
				reg = <0xa20000 0x90000>;
			};

			partition@ab0000 {
				label = "filesystem";
				reg = <0xab0000 0x1490000>;
			};

			partition@1f40000 {
				label = "cd";
				reg = <0x1f40000 0x80000>;
			};

			partition@1fcf000 {
				label = "debug-db";
				reg = <0x1fcf000 0x20000>;
			};

			partition@1ffb000 {
				label = "mfg-results";
				reg = <0x1ffb000 0x1000>;
			};

			partition@1ffc000 {
				label = "mfg-battery-state";
				reg = <0x1ffc000 0x1000>;
			};

			partition@1ffd000 {
				label = "tzinfo";
				reg = <0x1ffd000 0x1000>;
			};

			partition@1ffe000 {
				label = "mfg-info";
				reg = <0x1ffe000 0x1000>;
			};

			partition@1fff000 {
				label = "shared-prf-storage";
				reg = <0x1fff000 0x1000>;
			};
		};

		otp {
			compatible = "user-otp";

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				hw-version@0 {
					reg = <0x0 0x20>;
				};

				serial-number@20 {
					reg = <0x20 0x20>;
				};

				pcba-serial-number@40 {
					reg = <0x40 0x20>;
				};

				soc-config-user@800 {
					reg = <0x800 0x100>;
				};

				soc-config-cust@1000 {
					reg = <0x1000 0x100>;
				};
			};
		};
	};
};
