/dts-v1/;

#include "nordic/nrf54l15-qfaa.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Nordic nRF54L15 DK";
	compatible = "nordic,nrf54l15-dk", "nordic,nrf54l15";

	lfxo: clock-32768 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
	};

	leds {
		compatible = "gpio-leds";

		led0: led-0 {
			label = "LED0";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 9 GPIO_ACTIVE_HIGH>;
		};

		led1: led-1 {
			label = "LED1";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;
		};

		led2: led-2 {
			label = "LED2";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>;
		};

		led3: led-3 {
			label = "LED3";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		};
	};

	// Buttons 0 to 3, as the four buttons of a watch
	buttons: gpio-keys {
		compatible = "gpio-keys";

		button-0 {
			label = "Button0";
			gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_0>;
			debounce-interval = <40>;
		};

		button-1 {
			label = "Button1";
			gpios = <&gpio1 9 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_1>;
			debounce-interval = <40>;
		};

		button-2 {
			label = "Button2";
			gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_2>;
			debounce-interval = <40>;
		};

		button-3 {
			label = "Button3";
			gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			linux,code = <KEY_3>;
			debounce-interval = <40>;
		};
	};
};

&clock {
	clocks = <&hfxo>, <&lfxo>;
	clock-names = "hfxo", "lfxo";
	nordic,hfxo-load-capacitance-femtofarads = <15000>;
	nordic,lfxo-load-capacitance-femtofarads = <17000>;
};

&internal_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "code";
			reg = <0x0 0x17d000>;
		};
	};
};

// The interface MCU's virtual COM port 0
&uart20 {
	current-speed = <1000000>;
	tx-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
	rx-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>;
	status = "okay";
};
