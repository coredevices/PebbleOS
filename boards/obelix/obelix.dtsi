#include "sf32lb/sf32lb52x/sf32lb52.dtsi"

/ {
	model = "Core Devices Pebble Time 2";

	battery: battery {
		compatible = "simple-battery";
		constant-charge-current-max-microamp = <190000>;
		charge-term-current-microamp = <19000>;
		constant-charge-voltage-max-microvolt = <4350000>;
	};
};

&pinctrl {
	i2c1_default: i2c1-default-state {
		scl-pins {
			pins = "PA31";
			function = "i2c1_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA30";
			function = "i2c1_sda";
			input-enable;
			drive-strength = <8>;
		};
	};

	i2c2_default: i2c2-default-state {
		scl-pins {
			pins = "PA32";
			function = "i2c2_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA33";
			function = "i2c2_sda";
			input-enable;
			drive-strength = <8>;
		};
	};

	i2c3_default: i2c3-default-state {
		scl-pins {
			pins = "PA11";
			function = "i2c3_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA10";
			function = "i2c3_sda";
			input-enable;
			drive-strength = <8>;
		};
	};

	i2c4_default: i2c4-default-state {
		scl-pins {
			pins = "PA09";
			function = "i2c4_scl";
			input-enable;
			drive-strength = <8>;
		};

		sda-pins {
			pins = "PA20";
			function = "i2c4_sda";
			input-enable;
			drive-strength = <8>;
		};
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";

	pmic: pmic@6b {
		compatible = "nordic,npm1300";
		reg = <0x6b>;
		interrupt-parent = <&gpio1>;
		interrupts = <26 IRQ_TYPE_EDGE_RISING>;
		gpio-controller;
		#gpio-cells = <2>;
		monitored-battery = <&battery>;
		nordic,reduced-charge-voltage-microvolt = <4000000>;
		nordic,thermistor-ohms = <10000>;
		nordic,thermistor-beta = <3380>;
		nordic,thermistor-hot-celsius = <45>;
		nordic,discharge-current-limit-microamp = <200000>;
		input-current-limit-microamp = <500000>;
		nordic,startup-input-current-limit-microamp = <500000>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "npm1300_buck1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			ldsw1: LDSW1 {
				regulator-name = "npm1300_ldsw1";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				nordic,ldo-mode;
			};

			ldsw2: LDSW2 {
				regulator-name = "npm1300_ldsw2";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				nordic,ldo-mode;
			};
		};
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	dmas = <&dmac1 5 23 2>;
	dma-names = "rx";
	status = "okay";

	lsm6dso: imu@6a {
		compatible = "st,lsm6dso";
		reg = <0x6a>;
		interrupt-parent = <&gpio1>;
		interrupts = <38 IRQ_TYPE_EDGE_RISING>;
		mount-matrix = "-1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};

	mmc5603nj: magnetometer@30 {
		compatible = "memsic,mmc5603";
		reg = <0x30>;
		mount-matrix = "0", "1", "0",
			       "-1", "0", "0",
			       "0", "0", "1";
	};
};

&i2c3 {
	pinctrl-0 = <&i2c3_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};

&i2c4 {
	pinctrl-0 = <&i2c4_default>;
	pinctrl-names = "default";
	clock-frequency = <400000>;
	status = "okay";
};
