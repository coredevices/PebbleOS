/dts-v1/;

#include "sifli/sf32lb579.dtsi"
#include "sifli/sf32lb57xv6e.dtsi"

/ {
	model = "SiFli SF32LB57x-DPI-HDK";
	compatible = "sifli,sf32lb57-dpi-hdk", "sifli,sf32lb579";
};

&pinctrl {
	usart1_default: usart1-default-state {
		tx-pins {
			pins = "PA19";
			function = "usart1_txd";
			input-enable;
			drive-strength = <8>;
		};

		rx-pins {
			pins = "PA18";
			function = "usart1_rxd";
			input-enable;
			bias-pull-up;
			drive-strength = <8>;
		};
	};
};

&usart1 {
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
	current-speed = <1000000>;
	status = "okay";
};

&lptim1 {
	status = "okay";
};

&mpi2 {
	status = "okay";
};

&sip_flash {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "ptable";
			reg = <0x0 0x10000>;
		};

		partition@20000 {
			label = "firmware-slot-0";
			reg = <0x20000 0x300000>;
		};
	};
};

&mpi3 {
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
	};
};
