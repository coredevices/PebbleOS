&pinctrl {
	usart1_default: usart1-default-state {
		tx-pins {
			pins = "PA19";
			function = "usart1_txd";
			input-enable;
			drive-strength = <8>;
		};

		rx-pins {
			pins = "PA18";
			function = "usart1_rxd";
			input-enable;
			input-schmitt-enable;
			bias-pull-up;
			drive-strength = <8>;
		};
	};

	// No Schmitt trigger, whose threshold KEY-3 stays below, nor pull-down, which shifts the levels
	keys_default: keys-default-state {
		key-pins {
			pins = "PA34";
			function = "gpio";
			input-enable;
		};
	};
};
