if PLATFORM_GABBRO

config PLATFORM_NAME
    default "gabbro"

config PLATFORM_COLOR
    default y

config PLATFORM_ROUND
    default y

config PLATFORM_DISPLAY_WIDTH
    default 260

config PLATFORM_DISPLAY_HEIGHT
    default 260

config PLATFORM_MICROPHONE
    default y

config PLATFORM_HEALTH
    default y

config PLATFORM_COMPASS
    default y

config PLATFORM_TOUCH
    default y

config PLATFORM_MODDABLE_XS
    default y

config PLATFORM_MAX_APP_MEMORY_SIZE
    default 131072

config PLATFORM_MAX_FONT_GLYPH_SIZE
    default 512

# RAM of an app and of its runtime. The segment holds a 4 KiB app stack.

config APP_RAM_4X_SEGMENT_SIZE
    default 135168

config APP_RAM_4X_RUNTIME_SIZE
    default 96256

endif # PLATFORM_GABBRO
