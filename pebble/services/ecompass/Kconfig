config SERVICE_ECOMPASS
    bool "E-compass"
    default y
    depends on MAG && SETTINGS
    select SENSING
    help
      Electronic compass service, on the board's magnetometer. The
      magnetometer calibration is kept in a settings file.

if SERVICE_ECOMPASS

module = SERVICE_ECOMPASS
module-str = E-compass
source "subsys/logging/Kconfig.template.log_level"

endif
