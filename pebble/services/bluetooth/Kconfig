config SERVICE_BLUETOOTH
    bool "Bluetooth"
    help
      Core Bluetooth service (pairing, bonding, local id, ...).

# iOS notifications. Off in the recovery firmware, which has no notification UI.
config BT_ANCS_CLIENT
    default y if !RECOVERY_FW

# iOS music control. Off in the recovery firmware, which has no music UI.
config BT_AMS_CLIENT
    default y if !RECOVERY_FW

# What the phone app talks to.
config BT_SERVICE_PPS
    default y

config PP_TRANSPORT_GATT_REVERSED
    default y

if SERVICE_BLUETOOTH

config SERVICE_BLUETOOTH_VENDOR_ID
    hex "Vendor ID"
    default 0x0EEA
    help
      Company identifier in the manufacturer data of advertisements.

config SERVICE_BLUETOOTH_VENDOR_NAME
    string "Vendor name"
    default "Core Devices LLC"
    help
      Manufacturer name in the Device Information Service.

config SERVICE_BLUETOOTH_ADV_RECONNECT
    bool "Advertise for the bonded phone to reconnect"
    help
      Advertise an empty payload while there is a bond and nothing asks for
      discovery. Without it, only discovery is advertised, so that a phone
      can always find and pair the device, bonded or not.

module = SERVICE_BLUETOOTH
module-str = Bluetooth
source "subsys/logging/Kconfig.template.log_level"

endif
