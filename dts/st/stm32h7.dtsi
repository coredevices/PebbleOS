#include <dt-bindings/clock/stm32h7-clks.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/mfd/stm32h7-rcc.h>
#include <dt-bindings/pinctrl/stm32-pinfunc.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	clocks {
		clk_hse: clk-hse {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
		};

		clk_lse: clk-lse {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <32768>;
		};

		clk_i2s: i2s_ckin {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <0>;
		};
	};

	nvic: interrupt-controller@e000e100 {
		compatible = "arm,v7m-nvic";
		reg = <0xe000e100 0xc00>;
		interrupt-controller;
		#interrupt-cells = <1>;
		#address-cells = <0>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		interrupt-parent = <&nvic>;
		ranges;

		// The factory calibration of the analog blocks, in system memory
		romem: efuse@1ff1e800 {
			compatible = "st,stm32f4-otp";
			reg = <0x1ff1e800 0x100>;
			#address-cells = <1>;
			#size-cells = <1>;

			// The temperature sensor at 30 and 130 degrees (110 on revision Y), and
			// VREFINT, read at 3.3 V
			ts_cal1: calib@20 {
				reg = <0x20 0x2>;
			};

			ts_cal2: calib@40 {
				reg = <0x40 0x2>;
			};

			vrefint: calib@60 {
				reg = <0x60 0x2>;
			};
		};

		timer5: timer@40000c00 {
			compatible = "st,stm32-timer";
			reg = <0x40000c00 0x400>;
			interrupts = <50>;
			clocks = <&rcc TIM5_CK>;
		};

		lptimer1: timer@40002400 {
			compatible = "st,stm32-lptimer";
			reg = <0x40002400 0x400>;
			interrupts = <93>;
			clocks = <&rcc LPTIM1_CK>;
			clock-names = "mux";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			pwm {
				compatible = "st,stm32-pwm-lp";
				#pwm-cells = <3>;
				status = "disabled";
			};

			trigger@0 {
				compatible = "st,stm32-lptimer-trigger";
				reg = <0>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-lptimer-counter";
				status = "disabled";
			};

			timer {
				compatible = "st,stm32-lptimer-timer";
				status = "disabled";
			};
		};

		lptimer2: timer@58002400 {
			compatible = "st,stm32-lptimer";
			reg = <0x58002400 0x400>;
			interrupts = <138>;
			clocks = <&rcc LPTIM2_CK>;
			clock-names = "mux";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			pwm {
				compatible = "st,stm32-pwm-lp";
				#pwm-cells = <3>;
				status = "disabled";
			};

			trigger@1 {
				compatible = "st,stm32-lptimer-trigger";
				reg = <1>;
				status = "disabled";
			};

			counter {
				compatible = "st,stm32-lptimer-counter";
				status = "disabled";
			};

			timer {
				compatible = "st,stm32-lptimer-timer";
				status = "disabled";
			};
		};

		usbotg_hs: usb@40040000 {
			compatible = "st,stm32f7-hsotg";
			reg = <0x40040000 0x40000>;
			interrupts = <77>;
			clocks = <&rcc USB1OTG_CK>;
			clock-names = "otg";
			g-rx-fifo-size = <256>;
			g-np-tx-fifo-size = <32>;
			g-tx-fifo-size = <128 128 64 64 64 64 32 32>;
			status = "disabled";
		};

		usart2: serial@40004400 {
			compatible = "st,stm32h7-uart";
			reg = <0x40004400 0x400>;
			interrupts = <38>;
			clocks = <&rcc USART2_CK>;
			status = "disabled";
		};

		usart3: serial@40004800 {
			compatible = "st,stm32h7-uart";
			reg = <0x40004800 0x400>;
			interrupts = <39>;
			clocks = <&rcc USART3_CK>;
			status = "disabled";
		};

		uart4: serial@40004c00 {
			compatible = "st,stm32h7-uart";
			reg = <0x40004c00 0x400>;
			interrupts = <52>;
			clocks = <&rcc UART4_CK>;
			status = "disabled";
		};

		uart5: serial@40005000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40005000 0x400>;
			interrupts = <53>;
			clocks = <&rcc UART5_CK>;
			status = "disabled";
		};

		uart7: serial@40007800 {
			compatible = "st,stm32h7-uart";
			reg = <0x40007800 0x400>;
			interrupts = <82>;
			clocks = <&rcc UART7_CK>;
			status = "disabled";
		};

		uart8: serial@40007c00 {
			compatible = "st,stm32h7-uart";
			reg = <0x40007c00 0x400>;
			interrupts = <83>;
			clocks = <&rcc UART8_CK>;
			status = "disabled";
		};

		usart1: serial@40011000 {
			compatible = "st,stm32h7-uart";
			reg = <0x40011000 0x400>;
			interrupts = <37>;
			clocks = <&rcc USART1_CK>;
			status = "disabled";
		};

		usart6: serial@40011400 {
			compatible = "st,stm32h7-uart";
			reg = <0x40011400 0x400>;
			interrupts = <71>;
			clocks = <&rcc USART6_CK>;
			status = "disabled";
		};

		dma1: dma-controller@40020000 {
			compatible = "st,stm32-dma";
			reg = <0x40020000 0x400>;
			interrupts = <11>, <12>, <13>, <14>, <15>, <16>, <17>, <47>;
			clocks = <&rcc DMA1_CK>;
			#dma-cells = <4>;
			st,mem2mem;
			dma-requests = <8>;
			status = "disabled";
		};

		dma2: dma-controller@40020400 {
			compatible = "st,stm32-dma";
			reg = <0x40020400 0x400>;
			interrupts = <56>, <57>, <58>, <59>, <60>, <68>, <69>, <70>;
			clocks = <&rcc DMA2_CK>;
			#dma-cells = <4>;
			st,mem2mem;
			dma-requests = <8>;
			status = "disabled";
		};

		dmamux1: dma-router@40020800 {
			compatible = "st,stm32h7-dmamux";
			reg = <0x40020800 0x40>;
			#dma-cells = <3>;
			dma-channels = <16>;
			dma-requests = <128>;
			dma-masters = <&dma1>, <&dma2>;
			clocks = <&rcc DMA1_CK>;
			status = "disabled";
		};

		rng: rng@48021800 {
			compatible = "st,stm32-rng";
			reg = <0x48021800 0x400>;
			clocks = <&rcc RNG_CK>;
			status = "disabled";
		};

		dsi: dsi@50000000 {
			compatible = "st,stm32-dsi";
			reg = <0x50000000 0x800>;
			interrupts = <123>;
			clocks = <&rcc DSI_CK>, <&clk_hse>, <&rcc LTDC_CK>;
			clock-names = "pclk", "ref", "px_clk";
			resets = <&rcc STM32H7_APB3_RESET(DSI)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		ltdc: display-controller@50001000 {
			compatible = "st,stm32-ltdc";
			reg = <0x50001000 0x200>;
			interrupts = <88>, <89>;
			clocks = <&rcc LTDC_CK>;
			clock-names = "lcd";
			resets = <&rcc STM32H7_APB3_RESET(LTDC)>;
			status = "disabled";
		};

		dma2d: dma2d@52001000 {
			compatible = "st,stm32-dma2d";
			reg = <0x52001000 0x1000>;
			interrupts = <90>;
			clocks = <&rcc DMA2D_CK>;
			clock-names = "dma2d";
			resets = <&rcc STM32H7_AHB3_RESET(DMA2D)>;
			status = "disabled";
		};

		flash: flash-controller@52002000 {
			compatible = "st,stm32h7-flash-controller";
			reg = <0x52002000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
		};

		fmc: memory-controller@52004000 {
			compatible = "st,stm32h7-fmc";
			reg = <0x52004000 0x1000>;
			clocks = <&rcc FMC_CK>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;
			status = "disabled";
		};

		qspi: spi@52005000 {
			compatible = "st,stm32f469-qspi";
			reg = <0x52005000 0x1000>, <0x90000000 0x10000000>;
			reg-names = "qspi", "qspi_mm";
			interrupts = <92>;
			clocks = <&rcc QUADSPI_CK>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		exti: interrupt-controller@58000000 {
			compatible = "st,stm32h7-exti";
			interrupt-controller;
			#interrupt-cells = <2>;
			reg = <0x58000000 0x400>;
			interrupts = <1>, <2>, <3>, <6>, <7>, <8>, <9>, <10>, <23>, <40>, <41>, <62>, <76>;
		};

		syscfg: syscon@58000400 {
			compatible = "st,stm32-syscfg", "syscon";
			reg = <0x58000400 0x400>;
			clocks = <&rcc SYSCFG_CK>;
		};

		i2c4: i2c@58001c00 {
			compatible = "st,stm32f7-i2c";
			reg = <0x58001c00 0x400>;
			interrupts = <95>, <96>;
			clocks = <&rcc I2C4_CK>;
			resets = <&rcc STM32H7_APB4_RESET(I2C4)>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		sai1: sai@40015800 {
			compatible = "st,stm32h7-sai";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0x40015800 0x400>;
			reg = <0x40015800 0x4>;
			clocks = <&rcc SAI1_CK>, <&rcc PLL2_P>, <&rcc PLL2_P>;
			clock-names = "pclk", "x8k", "x11k";
			interrupts = <87>;
			resets = <&rcc STM32H7_APB2_RESET(SAI1)>;
			status = "disabled";

			sai1a: audio-controller@4 {
				compatible = "st,stm32-sai-sub-a";
				reg = <0x4 0x20>;
				clocks = <&rcc SAI1_CK>;
				clock-names = "sai_ck";
				dmas = <&dmamux1 87 0x400 0x01>;
				#sound-dai-cells = <0>;
				status = "disabled";
			};

			sai1b: audio-controller@24 {
				compatible = "st,stm32-sai-sub-b";
				reg = <0x24 0x20>;
				clocks = <&rcc SAI1_CK>;
				clock-names = "sai_ck";
				dmas = <&dmamux1 88 0x400 0x01>;
				#sound-dai-cells = <0>;
				status = "disabled";
			};
		};

		rtc: rtc@58004000 {
			compatible = "st,stm32h7-rtc";
			reg = <0x58004000 0x400>;
			clocks = <&rcc RTCAPB_CK>, <&rcc RTC_CK>;
			clock-names = "pclk", "rtc_ck";
			interrupts = <41>;
			status = "disabled";
		};

		iwdg: watchdog@58004800 {
			compatible = "st,stm32-iwdg";
			reg = <0x58004800 0x400>;
			clocks = <&rcc LSI_CK>;
			clock-names = "lsi";
			status = "disabled";
		};

		sai4: sai@58005400 {
			compatible = "st,stm32h7-sai";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0x58005400 0x400>;
			reg = <0x58005400 0x4>;
			clocks = <&rcc SAI4A_CK>, <&rcc PLL2_P>, <&rcc PLL2_P>;
			clock-names = "pclk", "x8k", "x11k";
			interrupts = <146>;
			resets = <&rcc STM32H7_APB4_RESET(SAI4)>;
			status = "disabled";

			sai4a: audio-controller@4 {
				compatible = "st,stm32-sai-sub-a";
				reg = <0x4 0x20>;
				clocks = <&rcc SAI4A_CK>;
				clock-names = "sai_ck";
				dmas = <&dmamux2 15 0x400 0x01>;
				#sound-dai-cells = <0>;
				status = "disabled";
			};

			sai4b: audio-controller@24 {
				compatible = "st,stm32-sai-sub-b";
				reg = <0x24 0x20>;
				clocks = <&rcc SAI4B_CK>;
				clock-names = "sai_ck";
				dmas = <&dmamux2 16 0x400 0x01>;
				#sound-dai-cells = <0>;
				status = "disabled";
			};
		};

		pinctrl: pinctrl@58020000 {
			compatible = "st,stm32h743-pinctrl";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0x58020000 0x3000>;
			interrupt-parent = <&exti>;
			st,syscfg = <&syscfg 0x8>;

			gpioa: gpio@0 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x0 0x400>;
				clocks = <&rcc GPIOA_CK>;
				st,bank-name = "GPIOA";
			};

			gpiob: gpio@400 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x400 0x400>;
				clocks = <&rcc GPIOB_CK>;
				st,bank-name = "GPIOB";
			};

			gpioc: gpio@800 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x800 0x400>;
				clocks = <&rcc GPIOC_CK>;
				st,bank-name = "GPIOC";
			};

			gpiod: gpio@c00 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0xc00 0x400>;
				clocks = <&rcc GPIOD_CK>;
				st,bank-name = "GPIOD";
			};

			gpioe: gpio@1000 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x1000 0x400>;
				clocks = <&rcc GPIOE_CK>;
				st,bank-name = "GPIOE";
			};

			gpiof: gpio@1400 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x1400 0x400>;
				clocks = <&rcc GPIOF_CK>;
				st,bank-name = "GPIOF";
			};

			gpiog: gpio@1800 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x1800 0x400>;
				clocks = <&rcc GPIOG_CK>;
				st,bank-name = "GPIOG";
			};

			gpioh: gpio@1c00 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x1c00 0x400>;
				clocks = <&rcc GPIOH_CK>;
				st,bank-name = "GPIOH";
			};

			gpioi: gpio@2000 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x2000 0x400>;
				clocks = <&rcc GPIOI_CK>;
				st,bank-name = "GPIOI";
			};

			gpioj: gpio@2400 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x2400 0x400>;
				clocks = <&rcc GPIOJ_CK>;
				st,bank-name = "GPIOJ";
			};

			gpiok: gpio@2800 {
				gpio-controller;
				#gpio-cells = <2>;
				interrupt-controller;
				#interrupt-cells = <2>;
				reg = <0x2800 0x400>;
				clocks = <&rcc GPIOK_CK>;
				st,bank-name = "GPIOK";
			};
		};

		rcc: reset-clock-controller@58024400 {
			compatible = "st,stm32h743-rcc", "st,stm32-rcc";
			reg = <0x58024400 0x400>;
			#clock-cells = <1>;
			#reset-cells = <1>;
			clocks = <&clk_hse>, <&clk_lse>, <&clk_i2s>;
		};

		crc: crc@58024c00 {
			compatible = "st,stm32f7-crc";
			reg = <0x58024c00 0x400>;
			clocks = <&rcc CRC_CK>;
			status = "disabled";
		};

		bdma: dma-controller@58025400 {
			compatible = "st,stm32h7-bdma";
			reg = <0x58025400 0x400>;
			interrupts = <129>, <130>, <131>, <132>, <133>, <134>, <135>, <136>;
			clocks = <&rcc BDMA_CK>;
			#dma-cells = <4>;
			dma-requests = <8>;
			status = "disabled";
		};

		dmamux2: dma-router@58025800 {
			compatible = "st,stm32h7-dmamux";
			reg = <0x58025800 0x40>;
			#dma-cells = <3>;
			dma-channels = <8>;
			dma-requests = <32>;
			dma-masters = <&bdma>;
			clocks = <&rcc BDMA_CK>;
			status = "disabled";
		};

		hsem: hwspinlock@58026400 {
			compatible = "st,stm32-hwspinlock";
			reg = <0x58026400 0x400>;
			#hwlock-cells = <1>;
			clocks = <&rcc HSEM_CK>;
			clock-names = "hsem";
		};

		adc_3: adc@58026000 {
			compatible = "st,stm32h7-adc-core";
			reg = <0x58026000 0x400>;
			interrupts = <127>;
			clocks = <&rcc ADC3_CK>;
			clock-names = "bus";
			interrupt-controller;
			#interrupt-cells = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			// Its internal channels: the temperature sensor on 18, VREFINT on 19
			adc3: adc@0 {
				compatible = "st,stm32h7-adc";
				#io-channel-cells = <1>;
				reg = <0x0>;
				interrupt-parent = <&adc_3>;
				interrupts = <0>;
				nvmem-cells = <&vrefint>, <&ts_cal1>, <&ts_cal2>;
				nvmem-cell-names = "vrefint", "ts-cal1", "ts-cal2";
				status = "disabled";
			};
		};
	};
};
