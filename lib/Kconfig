rsource "c/Kconfig"

menu "Libraries"

config BTUTIL
    bool "Bluetooth utilities"
    help
      Build the Bluetooth device address, UUID and security manager
      helpers.

config KRAEPELIN
    bool "Kraepelin"
    help
      Build the Kraepelin step and sleep tracking algorithm.

rsource "fuel_gauge/Kconfig"

config PDM
    bool
    help
      Decimation of the stream of PDM microphones to PCM, for the audio
      interfaces that capture it raw.

config VANHEES
    bool "van Hees"
    help
      Build the van Hees wrist angle sleep classifier.

endmenu
