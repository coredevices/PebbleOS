#
# Applications written in Rust:
#
#   find_package(PebbleOS REQUIRED HINTS $ENV{PEBBLEOS_BASE})
#   project(hello_world)
#
#   pbl_rust_app()
#
# The crate next to CMakeLists.txt is built by cargo as a static library and
# linked into the firmware. Its bindings to the C API (the pebbleos-sys crate)
# are generated by bindgen for this build's configuration, since struct
# layouts follow Kconfig.

set(PBL_RUST_DIR ${PBL_BASE}/rust)

# The rustc target and codegen flags of this build's CPU.
function(pbl_rust_target triple_out rustflags_out)
  set(rustflags "")
  if(EMSCRIPTEN)
    set(triple wasm32-unknown-emscripten)
  elseif(CONFIG_ARCH_POSIX)
    execute_process(COMMAND ${PBL_RUSTC} -vV OUTPUT_VARIABLE info COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCH "host: ([^\n]+)" _ "${info}")
    set(triple ${CMAKE_MATCH_1})
  elseif(CONFIG_ARMV8_M_MAINLINE)
    set(triple thumbv8m.main-none-eabi)
    # Other cores take the baseline, as the DSP feature is unstable in Rust.
    if(CONFIG_CPU_HAS_FPU AND CONFIG_ARMV8_M_DSP)
      list(APPEND rustflags -Ctarget-cpu=cortex-m33)
    endif()
  elseif(CONFIG_ARMV7_M)
    set(triple thumbv7em-none-eabi)
    if(CONFIG_CPU_HAS_FPU)
      list(APPEND rustflags -Ctarget-cpu=cortex-m4)
    endif()
  else()
    message(FATAL_ERROR "Rust: no target for this CPU")
  endif()

  # The float ABI of the C code. With an FPU it passes floating-point
  # arguments in FPU registers, unless something needs them in core
  # registers; the FPU is used inside functions either way.
  if(triple MATCHES "-none-eabi$" AND CONFIG_CPU_HAS_FPU AND NOT CONFIG_FP_SOFTFP_ABI)
    string(APPEND triple hf)
  endif()

  set(${triple_out} ${triple} PARENT_SCOPE)
  set(${rustflags_out} ${rustflags} PARENT_SCOPE)
endfunction()

# Headers the C compiler finds by itself, which clang has to be told about:
# the C library's, not GCC's own, which clang brings its equivalents of.
function(pbl_rust_libc_includes out)
  set(flags "")
  get_directory_property(options DIRECTORY ${CMAKE_SOURCE_DIR} COMPILE_OPTIONS)
  foreach(option ${options})
    if(option MATCHES "^-(mcpu|mthumb|mfloat-abi|mfpu|specs)")
      list(APPEND flags ${option})
    endif()
  endforeach()
  execute_process(
    COMMAND ${CMAKE_C_COMPILER} ${flags} -E -Wp,-v -x c -
    INPUT_FILE /dev/null
    OUTPUT_QUIET
    ERROR_VARIABLE search
    COMMAND_ERROR_IS_FATAL ANY
  )
  string(REGEX MATCH "#include <...> search starts here:\n(.*)End of search list" _ "${search}")
  string(REPLACE "\n" ";" lines "${CMAKE_MATCH_1}")
  set(dirs "")
  foreach(line ${lines})
    string(STRIP "${line}" dir)
    if(dir AND NOT dir MATCHES "/lib/gcc/[^/]+/[^/]+/include(-fixed)?$")
      cmake_path(NORMAL_PATH dir)
      list(APPEND dirs ${dir})
    endif()
  endforeach()
  set(${out} ${dirs} PARENT_SCOPE)
endfunction()

# Options of the C compilation that change what the headers declare.
function(pbl_rust_c_options out)
  get_directory_property(options DIRECTORY ${CMAKE_SOURCE_DIR} COMPILE_OPTIONS)
  get_target_property(interface pbl_interface INTERFACE_COMPILE_OPTIONS)
  if(interface)
    list(APPEND options ${interface})
  endif()
  set(args "")
  set(next_is_include FALSE)
  foreach(option ${options})
    if(next_is_include)
      list(APPEND args -include ${option})
      set(next_is_include FALSE)
    elseif(option MATCHES "^SHELL:-include (.+)$")
      list(APPEND args -include ${CMAKE_MATCH_1})
    elseif(option STREQUAL "-include")
      set(next_is_include TRUE)
    elseif(option MATCHES "^-(D|fshort-enums)")
      list(APPEND args ${option})
    endif()
  endforeach()
  set(${out} ${args} PARENT_SCOPE)
endfunction()

# Generates the bindings once the whole build has been described, as the
# options and include directories of the C code are only complete then.
function(pbl_rust_bindings triple bindings static_fns)
  find_program(PBL_BINDGEN bindgen HINTS $ENV{HOME}/.cargo/bin)
  if(NOT PBL_BINDGEN)
    message(FATAL_ERROR "Rust needs bindgen: cargo install bindgen-cli --locked")
  endif()
  execute_process(COMMAND ${PBL_BINDGEN} --version OUTPUT_VARIABLE version
                  COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" version "${version}")
  if(version VERSION_LESS 0.71)
    message(FATAL_ERROR "Rust needs bindgen 0.71 or later, ${PBL_BINDGEN} is ${version}")
  endif()

  pbl_rust_c_options(c_options)
  set(clang_args -std=c23 ${c_options})
  set(bindgen_args "")
  if(EMSCRIPTEN)
    # Its errno values are macros of macros, which only clang can expand.
    list(APPEND bindgen_args --clang-macro-fallback)
    execute_process(COMMAND ${PBL_EM_CONFIG} CACHE OUTPUT_VARIABLE cache
                    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    # bindgen skips hidden functions, which all are by default on wasm.
    list(APPEND clang_args --target=${triple} --sysroot=${cache}/sysroot
         -isystem ${cache}/sysroot/include/compat -fvisibility=default)
  elseif(CONFIG_ARCH_POSIX)
    if(APPLE)
      execute_process(COMMAND xcrun --show-sdk-path OUTPUT_VARIABLE sdk
                      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
      list(APPEND clang_args -isysroot ${sdk})
    endif()
  else()
    # The ARM EABI makes enums as small as their values.
    list(APPEND clang_args --target=${triple} -fshort-enums -ffreestanding -nostdlibinc)
    pbl_rust_libc_includes(libc_includes)
    foreach(dir ${libc_includes})
      list(APPEND clang_args -isystem ${dir})
    endforeach()
  endif()

  set(includes "$<TARGET_PROPERTY:app,INCLUDE_DIRECTORIES>")
  set(defines "$<TARGET_PROPERTY:app,COMPILE_DEFINITIONS>")
  list(APPEND clang_args
    "$<$<BOOL:${includes}>:-I$<JOIN:${includes},$<SEMICOLON>-I>>"
    "$<$<BOOL:${defines}>:-D$<JOIN:${defines},$<SEMICOLON>-D>>"
  )

  set(header ${PBL_RUST_DIR}/pebbleos-sys/wrapper.h)
  # bindgen adds the extension.
  string(REGEX REPLACE "\\.c$" "" static_fns_base ${static_fns})
  add_custom_command(
    OUTPUT ${bindings} ${static_fns}
    COMMAND ${PBL_BINDGEN} ${header}
            --output ${bindings}
            --depfile ${bindings}.d
            --wrap-static-fns
            --wrap-static-fns-path ${static_fns_base}
            --rust-target 1.85
            --rust-edition 2024
            --use-core
            --enable-function-attribute-detection
            --formatter prettyplease
            --default-enum-style moduleconsts
            --allowlist-file "${PBL_BASE}/include/.*"
            --allowlist-var "CONFIG_.*"
            --allowlist-var "E[A-Z0-9]+"
            --no-copy "pbl_(thread|mutex|sem|msgq|timer|work|delayed_work|poll_event|heap)"
            ${bindgen_args}
            --
            ${clang_args}
    DEPENDS ${header}
    DEPFILE ${bindings}.d
    COMMENT "Generating the Rust bindings"
    COMMAND_EXPAND_LISTS
    VERBATIM
  )
  add_custom_target(pbl_rust_bindings DEPENDS ${bindings} ${static_fns})
  add_dependencies(pbl_rust_bindings pbl_generated_headers)
endfunction()

function(pbl_rust_app)
  find_program(PBL_CARGO cargo HINTS $ENV{HOME}/.cargo/bin)
  find_program(PBL_RUSTC rustc HINTS $ENV{HOME}/.cargo/bin)
  if(NOT PBL_CARGO OR NOT PBL_RUSTC)
    message(FATAL_ERROR "Rust applications need a Rust toolchain: https://rustup.rs")
  endif()

  set(manifest ${PBL_APPLICATION_SOURCE_DIR}/Cargo.toml)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${manifest})
  execute_process(
    COMMAND ${PBL_CARGO} metadata --no-deps --format-version 1 --manifest-path ${manifest}
    WORKING_DIRECTORY ${PBL_APPLICATION_SOURCE_DIR}
    OUTPUT_VARIABLE metadata
    COMMAND_ERROR_IS_FATAL ANY
  )
  # The name of the static library, which [lib] may set.
  set(crate "")
  string(JSON num_targets LENGTH "${metadata}" packages 0 targets)
  math(EXPR last "${num_targets} - 1")
  foreach(i RANGE ${last})
    string(JSON kinds GET "${metadata}" packages 0 targets ${i} kind)
    if(kinds MATCHES "staticlib")
      string(JSON crate GET "${metadata}" packages 0 targets ${i} name)
    endif()
  endforeach()
  if(NOT crate)
    message(FATAL_ERROR "${manifest}: not a staticlib crate")
  endif()
  string(REPLACE "-" "_" crate ${crate})

  pbl_rust_target(triple rustflags)
  list(APPEND rustflags
    --remap-path-prefix=${PBL_BASE}=.
    --remap-path-prefix=${PBL_APPLICATION_SOURCE_DIR}=.
  )
  # Unit separators keep paths with spaces in one argument.
  string(ASCII 31 sep)
  list(JOIN rustflags "${sep}" rustflags)

  if(CONFIG_NO_OPTIMIZATIONS)
    set(opt_level 0)
  elseif(CONFIG_DEBUG_OPTIMIZATIONS)
    set(opt_level 1)
  else()
    set(opt_level s)
  endif()
  if(CONFIG_DEBUG_INFO)
    set(debug true)
  else()
    set(debug false)
  endif()

  set(bindings ${CMAKE_BINARY_DIR}/rust/bindings.rs)
  # Out-of-line copies of the static inline functions, for Rust to call.
  set(static_fns ${CMAKE_BINARY_DIR}/rust/static_fns.c)
  target_sources(app PRIVATE ${static_fns})
  set(target_dir ${CMAKE_BINARY_DIR}/rust/target)
  set(lib ${target_dir}/${triple}/release/lib${crate}.a)

  # cargo decides what is out of date, so it runs on every build.
  add_custom_target(pbl_rust_app
    COMMAND ${CMAKE_COMMAND} -E env
            PBL_BINDINGS_RS=${bindings}
            CARGO_TARGET_DIR=${target_dir}
            CARGO_PROFILE_RELEASE_OPT_LEVEL=${opt_level}
            CARGO_PROFILE_RELEASE_DEBUG=${debug}
            CARGO_PROFILE_RELEASE_PANIC=abort
            CARGO_PROFILE_RELEASE_LTO=true
            CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
            --unset=RUSTFLAGS
            "CARGO_ENCODED_RUSTFLAGS=${rustflags}"
            ${PBL_CARGO} build --quiet --release --target ${triple} --manifest-path ${manifest}
    BYPRODUCTS ${lib}
    WORKING_DIRECTORY ${PBL_APPLICATION_SOURCE_DIR}
    COMMENT "Building the Rust application"
    USES_TERMINAL
    VERBATIM
  )

  add_library(pbl_rust_app_lib STATIC IMPORTED GLOBAL)
  set_target_properties(pbl_rust_app_lib PROPERTIES IMPORTED_LOCATION ${lib})
  add_dependencies(pbl_rust_app_lib pbl_rust_app)
  set_property(GLOBAL APPEND PROPERTY PBL_STATIC_LIBS pbl_rust_app_lib)
  if(EMSCRIPTEN)
    # The prebuilt compiler_builtins has landing pads, which need the
    # exception runtime even though nothing throws.
    pbl_link_options(-sDEFAULT_TO_CXX -sDISABLE_EXCEPTION_CATCHING=0)
  endif()

  # Deferred calls expand their arguments when they run.
  cmake_language(EVAL CODE "
    cmake_language(DEFER DIRECTORY [[${CMAKE_SOURCE_DIR}]]
                   CALL pbl_rust_bindings [[${triple}]] [[${bindings}]] [[${static_fns}]])")
  cmake_language(DEFER DIRECTORY ${CMAKE_SOURCE_DIR}
                 CALL add_dependencies pbl_rust_app pbl_rust_bindings)
endfunction()
