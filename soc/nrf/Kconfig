config SOC_NRF52
    bool
    select CPU_CORTEX_M4
    select CPU_HAS_FPU
    select CRC
    select FLASH_IDLE_PM if FLASH && CPU_IDLE
    select SOC_HAS_POWER_OFF
    select TIMER_NRF5_RTC
    help
      Nordic nRF52 series, selected by its lines.
