if SOC_NRF52

choice BT_HCI
    default BT_HCI_NRF52
endchoice

# 1 MiB of internal flash; the bootloader occupies the first 32 KiB.
config FLASH_BASE
    default 0x00000000

config FLASH_SIZE
    default 0x100000

config FLASH_OFFSET
    default 0x8000

# 256 KiB of SRAM, first 256 bytes reserved for the RETAINED region.
config SRAM_BASE
    default 0x20000100

config SRAM_SIZE
    default 0x3ff00

# The NimBLE link layer runs on this SoC's radio, so its porting layer drives
# cputime from the 32.768 kHz RTC on TIMER5.
config NIMBLE_OS_CPUTIME_FREQ
    default 32768

config NIMBLE_OS_CPUTIME_TIMER_NUM
    default 5

config NIMBLE_TIMER_5
    default y

# Time the XTAL takes to settle, in us. rfmgmt enables the PHY this far ahead
# of the link layer's request.
config NIMBLE_BLE_LL_RFMGMT_ENABLE_TIME
    default 1500

# Sized to be _okay_ for firmware update over BLE; they may need further
# tuning.
config NIMBLE_MSYS_1_BLOCK_COUNT
    default 35

config NIMBLE_MSYS_1_BLOCK_SIZE
    default 304

endif # SOC_NRF52
