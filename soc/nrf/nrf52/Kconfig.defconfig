if SOC_NRF52

choice NIMBLE_HCI
    default NIMBLE_HCI_NRF52
endchoice

config FLASH_BASE
    default 0x00000000

config FLASH_SIZE
    default $(dt_nodelabel_reg_size,internal_flash)

if NIMBLE

choice NIMBLE_MCU_TARGET_CHOICE
    default NIMBLE_MCU_TARGET_NRF52832 if SOC_NRF52832
endchoice

# The NimBLE link layer runs on this SoC's radio, so its porting layer drives
# cputime from the 32.768 kHz RTC on TIMER5.
config NIMBLE_OS_CPUTIME_FREQ
    default 32768

config NIMBLE_OS_CPUTIME_TIMER_NUM
    default 5

config NIMBLE_TIMER_5
    default y

# Time the XTAL takes to settle, in us. rfmgmt enables the PHY this far ahead
# of the link layer's request.
config NIMBLE_BLE_LL_RFMGMT_ENABLE_TIME
    default 1500

# Sized to be _okay_ for firmware update over BLE; they may need further
# tuning.
config NIMBLE_MSYS_1_BLOCK_COUNT
    default 35

config NIMBLE_MSYS_1_BLOCK_SIZE
    default 304

endif # NIMBLE

# Divides the 32.768 kHz RTC evenly.
config KERNEL_TICK_HZ
    default 1024

config NUM_IRQS
    default 39 if SOC_NRF52832
    default 48

endif # SOC_NRF52
