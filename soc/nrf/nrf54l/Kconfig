config SOC_NRF54L
    bool
    select SOC_FAMILY_NRF
    select CPU_CORTEX_M33
    select CPU_HAS_FPU
    select SOC_HAS_UNIQUE_ID
    select NVMEM
    select TIMER_NRF_GRTC
    help
      Nordic nRF54L series, selected by its lines. Runs on the secure
      application core.
