if SOC_SF32LB52

choice NIMBLE_HCI
    default NIMBLE_HCI_SF32LB
endchoice

choice NIMBLE_ID_ADDR_SOURCE
    default NIMBLE_ID_ADDR_SF32LB_EFUSE
endchoice

# 32 MiB of external flash, memory-mapped through MPI.
config FLASH_BASE
    default 0x12000000

config FLASH_SIZE
    default 0x2000000

config FIRMWARE_OFFSET
    default 4096 if PBLBOOT

config NUM_IRQS
    default 99

config KERNEL_MPU_REGIONS
    default 12

endif # SOC_SF32LB52
