config SOC_SF32LB57
    bool
    select SOC_FAMILY_SF32LB
    select CPU_STAR_MC1
    select CPU_HAS_FPU
    select CPU_HAS_ICACHE
    select CPU_HAS_DCACHE
    select ARCH_VECTOR_TABLE_RAM
    select KERNEL_MPU_IN_FAULTS
    select FLASH if CPU_IDLE
    select RAMFUNC
    select SOC_HAS_IDLE_STATES
    select SOC_HAS_MPU_REGIONS
    select SOC_HAS_POWER_OFF
    select PINCTRL
    select TIMER_SF32LB_LPTIM
    help
      SiFli SF32LB57 series, selected by its lines.
