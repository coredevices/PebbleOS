config SOC_FAMILY_SF32LB
    bool
    help
      SiFli SF32LB family, selected by its series.

config SF32LB_FTAB
    bool "Boot ROM flash table"
    default y
    depends on SOC_FAMILY_SF32LB
    help
      Generate the flash table (FTAB) the boot ROM reads from the ptable
      partition, pointing it at the first image of the build: the
      bootloader the application boots with, or the application itself.
      It is flashed with that image.

rsource "*/Kconfig"
