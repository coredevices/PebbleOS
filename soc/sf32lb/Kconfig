config SOC_SF32LB52
    bool
    select CPU_STAR_MC1
    select CPU_HAS_FPU
    select CPU_HAS_ICACHE
    select CPU_HAS_DCACHE
    select ARCH_VECTOR_TABLE_RAM
    select KERNEL_MPU_IN_FAULTS
    select RAMFUNC
    select SOC_HAS_MPU_REGIONS
    select SOC_HAS_RESET
    select NVMEM
    select PINCTRL
    select TIMER_SF32LB_LPTIM
    help
      SiFli SF32LB52 series, selected by its lines.

config SF32LB52_FTAB
    bool "Boot ROM flash table"
    default y
    depends on SOC_SF32LB52 && !PBLBOOT
    help
      Generate the flash table (FTAB) the boot ROM reads from the ptable
      partition, pointing it at the firmware image, and flash it along with
      the firmware. Builds for PBLBOOT leave the table to the bootloader.
