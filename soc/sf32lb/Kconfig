config SOC_SF32LB52
    bool
    select HAL_SIFLI
    select CPU_STAR_MC1
    select CPU_HAS_FPU
    select CPU_HAS_ICACHE
    select CPU_HAS_DCACHE
    select ARCH_VECTOR_TABLE_RAM
    select KERNEL_MPU_IN_FAULTS
    select RAMFUNC
    select SOC_HAS_MPU_REGIONS
    select SOC_HAS_RESET
    select NVMEM
    select PINCTRL
    select TIMER_SF32LB_LPTIM
    help
      SiFli SF32LB52 series, selected by its lines.

if SOC_SF32LB52

config SOC_SF32LB52_HAS_PSRAM
    bool
    help
      The package has PSRAM, as described in the board devicetree. Set
      by the board, which also sets EXTRAM_SIZE to its size.

config SF32LB52_PSRAM
    bool "SiP PSRAM"
    depends on SOC_SF32LB52_HAS_PSRAM
    select EXTRAM
    select HAL_SIFLI_MPI_PSRAM
    select PSRAM_RETENTION
    help
      Bring up the PSRAM in the SiP (MPI1) and use it as external RAM.
      Its type is detected at boot from the package ID, as a package may
      ship with more than one.

config SF32LB52_PSRAM_HALF_SLEEP
    bool "Always retain the PSRAM in deep sleep (debug)"
    depends on SF32LB52_PSRAM
    help
      Put the PSRAM in half-sleep on every deep sleep, even without a
      retention hold, instead of deep power-down. Costs about 30 uA
      while idle; only meant for measurements and debugging.

endif # SOC_SF32LB52
