if SOC_SF32LB52

choice NIMBLE_HCI
    default NIMBLE_HCI_SF32LB
endchoice

choice NIMBLE_ID_ADDR_SOURCE
    default NIMBLE_ID_ADDR_SF32LB52_EFUSE
endchoice

# 32 MiB of external flash, memory-mapped through MPI.
config FLASH_BASE
    default 0x12000000

config FLASH_SIZE
    default 0x2000000

# 512 KiB of SRAM, last 1 KiB reserved for LCPU IPC.
config SRAM_BASE
    default 0x20000000

config SRAM_SIZE
    default 0x7fc00

config FIRMWARE_OFFSET
    default 4096 if PBLBOOT

if NIMBLE

# Sized over the peak measured under load (22 blocks). Exhaustion blocks the
# HCI RX task, it does not drop data.
config NIMBLE_BLE_TRANSPORT_ACL_COUNT
    default 36

endif # NIMBLE


config NUM_IRQS
    default 99

config NUM_IRQ_PRIO_BITS
    default 3

endif # SOC_SF32LB52

if SOC_SF32LB57

choice NIMBLE_HCI
    default NIMBLE_HCI_SF32LB
endchoice

# 512 KiB of SRAM, last 2 KiB reserved for LCPU and ACPU IPC. The flash is
# the board's: the boot ROM reads it from the boot device the part and its
# strapping select.
config SRAM_BASE
    default 0x20000000

config SRAM_SIZE
    default 0x7f800

config NUM_IRQS
    default 106

config NUM_IRQ_PRIO_BITS
    default 3

endif # SOC_SF32LB57
