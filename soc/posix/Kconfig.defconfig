if SOC_POSIX

choice BT_ID_ADDR_SOURCE
    default BT_ID_ADDR_STORAGE
endchoice

# Emulated external flash, backed by a file on the host.
config FLASH_BASE
    default 0x00000000

config FLASH_SIZE
    default 0x2000000

config FLASH_OFFSET
    default 0x0

config FW_FLASH_SIZE
    default 0x400000

# Nominal: RAM comes from the host, sized like the emulated platform.
config SRAM_BASE
    default 0x20000000

config SRAM_SIZE
    default 0x7fc00

config NUM_IRQS
    default 1

endif # SOC_POSIX
