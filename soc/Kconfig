choice
    prompt "SoC"
    help
      SoC family. Real boards pick a vendor SoC; QEMU boards pick
      SOC_QEMU and then choose the emulated core.

config SOC_NRF52
    bool "Nordic nRF52"
    select HAL_NORDIC
    select CPU_CORTEX_M4
    select CPU_HAS_FPU

config SOC_SF32LB52
    bool "SiFli SF32LB52"
    select HAL_SIFLI
    select CPU_STAR_MC1
    select CPU_HAS_FPU
    select RAMFUNC

config SOC_QEMU
    bool "QEMU emulated"

endchoice

config SOC
    string
    default "NRF52" if SOC_NRF52
    default "SF32LB52" if SOC_SF32LB52
    help
      Stringified SoC name, for places that need the name as a token
      (e.g. sftool -c). Empty on QEMU boards.

config QEMU
    bool
    default y if SOC_QEMU
    help
      Derived alias for SOC_QEMU. Gates features that don't make
      sense under emulation.

choice
    prompt "Emulated core"
    depends on SOC_QEMU

config SOC_QEMU_CORTEX_M4
    bool "Cortex-M4"
    select CPU_CORTEX_M4

config SOC_QEMU_CORTEX_M33
    bool "Cortex-M33"
    select CPU_CORTEX_M33

endchoice
# test
