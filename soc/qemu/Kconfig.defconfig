if SOC_QEMU_PEBBLE

choice NIMBLE_ID_ADDR_SOURCE
    default NIMBLE_ID_ADDR_QEMU
endchoice

# 4 MiB of emulated flash.
config FLASH_BASE
    default 0x00000000

config FLASH_SIZE
    default 0x400000

# The SRAM layout is the machine's, and so given by the board.

config NUM_IRQS
    default 13

config NUM_IRQ_PRIO_BITS
    default 3

endif # SOC_QEMU_PEBBLE
