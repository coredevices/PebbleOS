config SERVICE_LIGHT
    bool "Light"
    help
      Backlight control service.

if SERVICE_LIGHT

config SERVICE_LIGHT_BACKLIGHT_ON_PERCENT
    int "Backlight hardware ceiling (%)"
    range 1 100
    default 100
    help
      Hardware brightness that the maximum backlight intensity maps to, as a
      percentage of the driver's full scale.

config SERVICE_LIGHT_DARK_THRESHOLD
    int "Ambient light dark threshold (lux)"
    default 150
    help
      Ambient light level below which it is considered dark. Users can
      override it in the backlight settings.

config SERVICE_LIGHT_DARK_THRESHOLD_DELTA
    int "Ambient light level band (lux)"
    default 25
    help
      Width of the bands around the dark threshold that separate the very
      dark, dark, light and very light levels.

config SERVICE_LIGHT_BACKLIGHT_DEFAULT_COLOR
    hex "Default backlight color (0xRRGGBB)"
    depends on BACKLIGHT_HAS_COLOR
    range 0x0 0xFFFFFF
    default 0xFFFFFF
    help
      Backlight color used until the user picks one.

config ALS_SCREEN_COMPENSATION
    bool "Compensate ALS readings for on-screen luminance"
    depends on AMBIENT_LIGHT && SCREEN_COLOR_DEPTH_BITS_8
    help
      For boards whose ambient light sensor sits under the display, correct the
      raw ALS reading by the transmittance of the pixels in front of the sensor
      (black pixels block ambient light, white pixels pass it). The sensor
      region and black-scale clamp are configured below.

if ALS_SCREEN_COMPENSATION

config ALS_SENSOR_X
    int "ALS sensor region X offset (px)"
    default 0

config ALS_SENSOR_Y
    int "ALS sensor region Y offset (px)"
    default 0

config ALS_SENSOR_W
    int "ALS sensor region width (px)"
    default 0

config ALS_SENSOR_H
    int "ALS sensor region height (px)"
    default 0

config ALS_BLACK_SCALE_Q8
    int "ALS gain when the sensor region is fully black, Q8 (256 = 1.0x)"
    default 256
    help
      Inverse-luminance gain is clamped to this value where the region is black.

endif # ALS_SCREEN_COMPENSATION

module = SERVICE_LIGHT
module-str = Light
source "subsys/logging/Kconfig.template.log_level"

endif
