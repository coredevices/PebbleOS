menuconfig SPEAKER
    bool "Speaker"
    help
      Speaker (audio output) Drivers

if SPEAKER

config SPEAKER_DA7212
    bool "Dialog DA7212 codec (nRF5 I2S)"
    select HAL_NORDIC
    help
      Support for the Dialog DA7212 audio codec driven over nRF5 I2S.

config SPEAKER_SF32LB
    bool "SiFli SF32LB AUDEC"
    default y if SOC_SF32LB52
    select HAL_SIFLI
    select HAL_SIFLI_AUDCODEC
    select SPEAKER_PLAYBACK_OBSERVER
    help
      Support for the SiFli SF32LB audio codec / DAC speaker output.

config SPEAKER_SF32LB_DIAGNOSTICS
    bool "SF32LB playback flow diagnostics"
    depends on SPEAKER_SF32LB
    help
      Count DMA refills, underrun bytes and dropped writes, and track the
      peak level of the PCM committed to the DAC, for audio bring-up tools.

config SPEAKER_QEMU
    bool "QEMU audio"
    default y if SOC_QEMU
    help
      QEMU audio device backing the speaker for emulated builds.

config SPEAKER_PLAYBACK_OBSERVER
    bool
    help
      The driver implements audio_set_playback_callback().

module = DRIVER_SPEAKER
module-str = Speaker
source "subsys/logging/Kconfig.template.log_level"

endif # SPEAKER
