config SERVICE_BATTERY
    bool "Battery"
    help
      Battery monitor and state-of-charge estimation.

choice BATTERY_SOC
    prompt "State-of-charge estimation"
    default NRF_FUEL_GAUGE if PMIC_NPM1300
    default BATTERY_SOC_VOLTAGE

config BATTERY_SOC_VOLTAGE
    bool "Voltage curve"
    help
      Look the state of charge up in a voltage curve.

config NRF_FUEL_GAUGE
    bool "Nordic nRF Fuel Gauge"
    depends on PMIC_NPM1300
    help
      Use the Nordic nRF Fuel Gauge library for state-of-charge
      estimation. Requires the nPM1300 PMIC; selects both the prebuilt
      nonfree fuel-gauge lib and the matching battery service impl.

config BATTERY_SOC_FUEL_GAUGE
    bool "Fuel gauge"
    depends on PMIC_NPM1300
    select FUEL_GAUGE
    help
      Use the open fuel gauge (subsys/fuel_gauge) with the cell model of
      the board.

endchoice

if SERVICE_BATTERY

config BATTERY_WARNING_FIRST_PERCENT
    int "First battery warning threshold (%)"
    range 0 100
    default 0
    help
      Battery percentage for the first warning. A value of 0 uses the
      default time-based threshold of 18 hours remaining.

config BATTERY_WARNING_SECOND_PERCENT
    int "Second battery warning threshold (%)"
    range 0 100
    default 0
    help
      Battery percentage for the second warning. A value of 0 uses the
      default time-based threshold of 12 hours remaining.

module = SERVICE_BATTERY
module-str = Battery
source "subsys/logging/Kconfig.template.log_level"

endif
